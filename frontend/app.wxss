page {
  --color-primary: #14866f;
  --color-primary-deep: #0f6b59;
  --color-primary-soft: rgba(20, 134, 111, 0.12);
  --color-secondary: #f08a2e;
  --color-secondary-deep: #d97217;
  --color-secondary-soft: rgba(240, 138, 46, 0.14);
  --color-accent: #4f84f4;
  --color-accent-soft: rgba(79, 132, 244, 0.12);
  --color-bg: #f5f1e8;
  --color-bg-soft: #fbf8f2;
  --color-surface: #ffffff;
  --color-surface-muted: rgba(255, 255, 255, 0.82);
  --color-glass: rgba(255, 255, 255, 0.68);
  --color-text: #1f2f2a;
  --color-text-strong: #182521;
  --color-text-secondary: rgba(31, 47, 42, 0.68);
  --color-text-hint: rgba(31, 47, 42, 0.42);
  --color-border: rgba(24, 37, 33, 0.08);
  --color-border-strong: rgba(24, 37, 33, 0.15);
  --color-danger: #cf4a40;
  --color-danger-soft: rgba(207, 74, 64, 0.12);
  --color-overlay: rgba(15, 26, 23, 0.42);

  --font-display: 56rpx;
  --font-xxl: 46rpx;
  --font-xl: 38rpx;
  --font-lg: 31rpx;
  --font-base: 27rpx;
  --font-sm: 24rpx;
  --font-xs: 21rpx;
  --font-mini: 19rpx;

  --sp-1: 4rpx;
  --sp-2: 8rpx;
  --sp-3: 12rpx;
  --sp-4: 16rpx;
  --sp-5: 20rpx;
  --sp-6: 24rpx;
  --sp-7: 28rpx;
  --sp-8: 32rpx;
  --sp-10: 40rpx;
  --sp-12: 48rpx;

  --r-xs: 10rpx;
  --r-sm: 14rpx;
  --r-md: 20rpx;
  --r-lg: 28rpx;
  --r-xl: 36rpx;
  --r-2xl: 44rpx;
  --r-full: 9999rpx;

  --shadow-soft: 0 10rpx 30rpx rgba(54, 70, 61, 0.08);
  --shadow-card: 0 4rpx 18rpx rgba(29, 43, 36, 0.05), 0 18rpx 44rpx rgba(29, 43, 36, 0.08);
  --shadow-hero: 0 18rpx 40rpx rgba(20, 134, 111, 0.14);

  background: var(--color-bg);
  color: var(--color-text);
  font-size: var(--font-base);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

view,
text,
navigator,
button,
input,
textarea,
image {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  background: none;
  border: none;
  line-height: inherit;
  font-size: inherit;
  color: inherit;
}

button::after {
  border: none;
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}

.page-bg {
  min-height: 100vh;
  background-color: var(--color-bg);
  background-repeat: no-repeat;
  background-position: top center;
  background-size: 100% auto;
}

.page-hero {
  padding: 36rpx 32rpx 24rpx;
}

.page-kicker {
  display: block;
  font-size: var(--font-mini);
  font-weight: 700;
  line-height: 1.5;
  color: var(--color-text-secondary);
  letter-spacing: 1rpx;
  margin-bottom: 10rpx;
}

.page-title {
  display: block;
  font-size: var(--font-xxl);
  line-height: 1.14;
  font-weight: 800;
  color: var(--color-text-strong);
}

.page-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: var(--font-sm);
  line-height: 1.65;
  color: var(--color-text-secondary);
}

.page-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.page-badge,
.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 40rpx;
  padding: 0 16rpx;
  border-radius: var(--r-full);
  font-size: var(--font-xs);
  font-weight: 700;
  line-height: 1;
}

.badge-green {
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.badge-amber {
  background: var(--color-secondary-soft);
  color: var(--color-secondary-deep);
}

.badge-blue {
  background: var(--color-accent-soft);
  color: var(--color-accent);
}

.badge-ghost {
  background: rgba(24, 37, 33, 0.06);
  color: var(--color-text-secondary);
}

.page-content {
  flex: 1;
  padding: 0 32rpx 40rpx;
}

.surface-card {
  background: var(--color-surface);
  border-radius: var(--r-xl);
  border: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-card);
}

.glass-card {
  background: var(--color-glass);
  border-radius: var(--r-xl);
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  box-shadow: var(--shadow-card);
}

.meta-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.meta-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 12rpx;
  min-height: 44rpx;
  border-radius: 16rpx;
  background: rgba(24, 37, 33, 0.05);
}

.meta-chip-label {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  font-weight: 600;
  white-space: nowrap;
}

.meta-chip-value {
  font-size: var(--font-xs);
  color: var(--color-text);
  font-weight: 700;
  white-space: nowrap;
}

.section-label {
  display: block;
  font-size: var(--font-sm);
  font-weight: 700;
  color: var(--color-text-strong);
}

.surface-panel {
  background: var(--color-surface);
  border-radius: var(--r-xl);
  border: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-card);
  padding: 28rpx;
}

.state-block {
  min-height: 100vh;
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.state-mark {
  width: 112rpx;
  height: 112rpx;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
}

.state-mark.loading {
  background: var(--color-primary-soft);
}

.state-mark.empty {
  background: rgba(24, 37, 33, 0.06);
}

.state-mark.error {
  background: var(--color-danger-soft);
}

.state-title {
  display: block;
  font-size: var(--font-lg);
  line-height: 1.3;
  font-weight: 800;
  color: var(--color-text-strong);
}

.state-text {
  display: block;
  margin-top: 10rpx;
  max-width: 34em;
  font-size: var(--font-sm);
  line-height: 1.65;
  color: var(--color-text-secondary);
}

.state-action {
  margin-top: 20rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  align-items: center;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 90rpx;
  padding: 0 26rpx;
  border-radius: 24rpx;
  font-size: var(--font-base);
  font-weight: 800;
  transition: transform 0.15s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.15s ease;
}

.btn:active {
  transform: scale(0.98);
}

.btn-primary {
  background: var(--color-primary);
  color: #ffffff;
  box-shadow: var(--shadow-hero);
}

.btn-secondary {
  background: var(--color-surface);
  color: var(--color-text-strong);
  border: 1.5rpx solid var(--color-border-strong);
}

.btn-ghost {
  background: rgba(24, 37, 33, 0.05);
  color: var(--color-text-secondary);
}

.btn-danger-text {
  min-height: 64rpx;
  padding: 0 18rpx;
  border-radius: var(--r-full);
  background: var(--color-danger-soft);
  color: var(--color-danger);
  font-size: var(--font-xs);
  font-weight: 700;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  gap: 12rpx;
  padding: 18rpx 32rpx;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(251, 248, 242, 0.92);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-top: 1rpx solid rgba(24, 37, 33, 0.08);
}

.bottom-bar .btn,
.bottom-bar button {
  flex: 1;
}

.pref-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.pref-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 18rpx 10rpx;
  border-radius: 24rpx;
  border: 1.5rpx solid transparent;
  background: rgba(24, 37, 33, 0.04);
  transition: transform 0.15s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.15s ease, background 0.15s ease;
}

.pref-item:active {
  transform: scale(0.97);
}

.pref-item.selected {
  background: var(--color-primary-soft);
  border-color: rgba(20, 134, 111, 0.22);
}

.pref-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 22rpx;
}

.pref-label {
  font-size: var(--font-xs);
  line-height: 1.4;
  text-align: center;
  color: var(--color-text);
  font-weight: 700;
}
