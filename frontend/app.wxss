/* 全局样式 */
page {
  --color-primary: #07C160;
  --color-primary-light: rgba(7, 193, 96, 0.08);
  --color-secondary: #FF9500;
  --color-bg: #F5F5F5;
  --color-surface: #FFFFFF;
  --color-surface-soft: rgba(255, 255, 255, 0.86);
  --color-text: #1A1A1A;
  --color-text-secondary: rgba(26, 26, 26, 0.6);
  --color-text-hint: rgba(26, 26, 26, 0.4);
  --color-border: rgba(26, 26, 26, 0.1);
  --color-danger: #FF4D4F;
  --color-success: #07C160;
  --font-xxl: 44rpx;
  --font-xl: 36rpx;
  --font-lg: 32rpx;
  --font-base: 28rpx;
  --font-sm: 24rpx;
  --font-xs: 22rpx;
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-base: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;
  --radius-sm: 8rpx;
  --radius-base: 16rpx;
  --radius-lg: 24rpx;
  --radius-full: 9999rpx;
  --shadow-sm: 0 4rpx 14rpx rgba(35, 55, 45, 0.06);
  --shadow-base: 0 12rpx 32rpx rgba(35, 55, 45, 0.09);
  --shadow-lg: 0 20rpx 48rpx rgba(35, 55, 45, 0.13);
  background-color: var(--color-bg);
  font-size: 28rpx;
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

/* 重置 */
view, text, navigator, button, input, textarea {
  box-sizing: border-box;
}

/* 通用卡片 */
.card {
  background-color: rgba(255, 255, 255, 0.92);
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  box-shadow: var(--shadow-sm);
}

/* 按钮 */
.btn-primary {
  background-color: var(--color-primary);
  color: #FFFFFF;
  border-radius: 48rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background-color: #F5F5F5;
  color: var(--color-text);
  border-radius: 48rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #E5E5E5;
}

.page-bg {
  min-height: 100vh;
  background-color: var(--color-bg);
  background-repeat: no-repeat;
  background-position: top center;
  background-size: 100% auto;
}

.glass-card {
  background: var(--color-surface-soft);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: var(--shadow-base);
}

.btn-secondary::after {
  border: none;
}

/* 底部安全区 */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
