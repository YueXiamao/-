/* ================================================================
   Global Design Tokens & Reset
   ================================================================ */
page {
  /* ── Palette ── */
  --color-primary: #16A06D;
  --color-primary-hover: #128560;
  --color-primary-light: rgba(22, 160, 109, 0.1);
  --color-primary-muted: rgba(22, 160, 109, 0.06);
  --color-secondary: #F59E0B;
  --color-secondary-light: rgba(245, 158, 11, 0.1);
  --color-bg: #F0F3EE;
  --color-bg-alt: #E8ECE7;
  --color-surface: #FFFFFF;
  --color-surface-soft: rgba(255, 255, 255, 0.88);
  --color-text: #1A1A1A;
  --color-text-secondary: rgba(26, 26, 26, 0.58);
  --color-text-hint: rgba(26, 26, 26, 0.36);
  --color-border: rgba(26, 26, 26, 0.08);
  --color-border-strong: rgba(26, 26, 26, 0.14);
  --color-danger: #EF4444;
  --color-danger-light: rgba(239, 68, 68, 0.1);
  --color-success: #16A06D;
  --color-overlay: rgba(0, 0, 0, 0.4);

  /* ── Typography ── */
  --font-xxl: 48rpx;
  --font-xl:  36rpx;
  --font-lg:  32rpx;
  --font-base: 28rpx;
  --font-sm:  24rpx;
  --font-xs:  22rpx;
  --font-kicker: 20rpx;

  /* ── Spacing ── */
  --sp-xs:  8rpx;
  --sp-sm:  12rpx;
  --sp-base: 24rpx;
  --sp-lg:  32rpx;
  --sp-xl:  48rpx;

  /* ── Border-radius ── */
  --r-sm:   12rpx;
  --r-base: 20rpx;
  --r-lg:   28rpx;
  --r-xl:   40rpx;
  --r-full: 9999rpx;

  /* ── Shadows ── */
  --shadow-xs: 0 2rpx 8rpx rgba(35, 55, 45, 0.06);
  --shadow-sm: 0 4rpx 16rpx rgba(35, 55, 45, 0.08);
  --shadow-md: 0 8rpx 28rpx rgba(35, 55, 45, 0.11);
  --shadow-lg: 0 16rpx 48rpx rgba(35, 55, 45, 0.14);

  /* ── Page base ── */
  background-color: var(--color-bg);
  font-size: var(--font-base);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

/* ── Reset ── */
view, text, navigator, button, input, textarea {
  box-sizing: border-box;
}

/* ── Global card ── */
.card {
  background: var(--color-surface);
  border-radius: var(--r-lg);
  padding: var(--sp-base);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--color-border);
}

/* ── Global button reset ── */
button {
  padding: 0;
  margin: 0;
  background: none;
  border: none;
  line-height: inherit;
  font-size: inherit;
  color: inherit;
}
button::after { border: none; }

/* ── Background variants ── */
.page-bg {
  min-height: 100vh;
  background-color: var(--color-bg);
  background-repeat: no-repeat;
  background-position: top center;
  background-size: 100% auto;
}

/* ── Glass surface ── */
.glass-card {
  background: var(--color-surface-soft);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow: var(--shadow-sm);
}

/* ── Safe bottom ── */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ── Utility ── */
.text-primary { color: var(--color-primary); }
.text-secondary { color: var(--color-text-secondary); }
.text-hint { color: var(--color-text-hint); }
