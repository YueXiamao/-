/* pages/profile/profile.wxss */

/* ── Page ── */
.page {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding: 24rpx 28rpx 120rpx;
}

/* ── Glass card (reused from app.wxss, redefined here for completeness) ── */
.glass-card {
  background: var(--color-surface-glass);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  box-shadow: var(--shadow-card);
}

/* ── User Hero ── */
.user-hero {
  padding: 60rpx 36rpx 48rpx;
  background: linear-gradient(160deg, #E8F5EE 0%, #EDF5F0 60%, var(--color-bg) 100%);
  position: relative;
  overflow: hidden;
}

.user-hero::before {
  content: '';
  position: absolute;
  top: -50rpx;
  right: -50rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(13, 156, 110, 0.1) 0%, transparent 70%);
  pointer-events: none;
}

.user-section {
  margin-bottom: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  border: none;
}

.user-card {
  background: var(--color-surface);
  border-radius: var(--r-xl);
  padding: 32rpx;
  box-shadow: var(--shadow-md);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.user-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: var(--r-lg);
  background: linear-gradient(135deg, var(--color-primary-light), #D1FAE5);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 800;
  color: var(--color-primary);
  letter-spacing: 1rpx;
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
}

.user-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
  flex: 1;
}

.user-id {
  font-size: var(--font-xl);
  color: var(--color-text);
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-hint {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

/* ── Content ── */
.content-wrap {
  padding: 32rpx 32rpx 0;
}

/* ── Section Title ── */
.trips-section {
  margin-top: 0;
}

.section-title {
  font-size: var(--font-lg);
  font-weight: 800;
  color: var(--color-text);
  margin-bottom: 18rpx;
  letter-spacing: -0.3rpx;
}

.loading {
  text-align: center;
  padding: var(--sp-10) 0;
  color: var(--color-text-secondary);
  font-size: var(--font-base);
}

/* ── Empty State ── */
.empty-state {
  padding: 60rpx 32rpx;
  text-align: center;
  border-radius: var(--r-xl);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--color-border);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.empty-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--r-xl);
  background: var(--color-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
  border: 1rpx solid var(--color-border);
}

.empty-icon {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-text-hint);
  letter-spacing: 2rpx;
}

.empty-text {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-text);
}

.empty-hint {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

/* ── Trip List ── */
.trip-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.trip-item {
  position: relative;
  border-radius: var(--r-xl);
  padding: 28rpx 28rpx 24rpx;
  background: var(--color-surface);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--color-border);
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}

.trip-item:active {
  transform: scale(0.99);
  box-shadow: var(--shadow-xs);
}

.trip-item-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.trip-item-title {
  font-size: var(--font-base);
  font-weight: 700;
  color: var(--color-text);
  flex: 1;
  line-height: 1.35;
  padding-right: 60rpx;
}

.trip-item-status {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  font-size: 20rpx;
  color: var(--color-primary);
  background: var(--color-primary-light);
  padding: 4rpx 12rpx;
  border-radius: var(--r-full);
  font-weight: 600;
}

.trip-item-meta {
  display: flex;
  gap: 16rpx;
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  margin-bottom: 14rpx;
}

.trip-item-dests {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.dest-tag {
  background: var(--color-bg);
  color: var(--color-text-secondary);
  padding: 4rpx 12rpx;
  border-radius: var(--r-xs);
  font-size: 20rpx;
  border: 1rpx solid var(--color-border);
}

.trip-item-actions {
  position: absolute;
  bottom: 24rpx;
  right: 24rpx;
}

.action-text {
  font-size: var(--font-xs);
  color: var(--color-danger);
  font-weight: 600;
  padding: 6rpx 14rpx;
  border-radius: var(--r-full);
  background: var(--color-danger-light);
  transition: opacity 0.12s;
}

.action-text:active {
  opacity: 0.7;
}
