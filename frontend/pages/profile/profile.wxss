.profile-page {
  background:
    linear-gradient(180deg, rgba(255, 249, 241, 0.8), rgba(245, 241, 232, 0.98) 380rpx, #f5f1e8 100%),
    linear-gradient(155deg, rgba(20, 134, 111, 0.08), rgba(79, 132, 244, 0.04));
}

.profile-hero {
  padding-bottom: 20rpx;
}

.profile-identity {
  overflow: hidden;
}

.profile-identity-cover {
  height: 144rpx;
  background:
    linear-gradient(135deg, rgba(20, 134, 111, 0.14), rgba(79, 132, 244, 0.08)),
    #e8f5f0;
  background-size: cover;
  background-position: center;
}

.profile-identity-row {
  display: flex;
  gap: 20rpx;
  align-items: center;
  padding: 0 24rpx 24rpx;
  margin-top: -34rpx;
}

.profile-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #def4eb, #cde9de);
  border: 6rpx solid #ffffff;
  color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.profile-copy {
  flex: 1;
  min-width: 0;
}

.profile-title {
  display: block;
  font-size: 42rpx;
  line-height: 1.2;
  font-weight: 800;
  color: var(--color-text-strong);
}

.profile-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: var(--font-sm);
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.profile-content {
  padding-bottom: 40rpx;
}

.profile-summary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  padding: 24rpx;
}

.profile-summary-item {
  padding: 18rpx 16rpx;
  border-radius: 22rpx;
  background: rgba(24, 37, 33, 0.04);
}

.profile-summary-label {
  display: block;
  font-size: var(--font-mini);
  color: var(--color-text-hint);
}

.profile-summary-value {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-xs);
  line-height: 1.4;
  color: var(--color-text-strong);
  font-weight: 700;
}

.profile-summary-value.is-active {
  color: var(--color-primary);
}

.profile-login-panel {
  margin-top: 18rpx;
  padding: 28rpx;
}

.profile-login-title {
  display: block;
  font-size: var(--font-lg);
  font-weight: 800;
  color: var(--color-text-strong);
}

.profile-login-copy {
  display: block;
  margin-top: 10rpx;
  font-size: var(--font-sm);
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.profile-login-button {
  width: 100%;
  margin-top: 18rpx;
}

.loading-state {
  margin-top: 18rpx;
  padding: 26rpx;
}

.loading-line {
  height: 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #f3f0e8 25%, #eae5da 50%, #f3f0e8 75%);
  background-size: 200% 100%;
  animation: profileShimmer 1.3s ease-in-out infinite;
  margin-bottom: 16rpx;
}

.loading-line.long { width: 88%; }
.loading-line.medium { width: 66%; }
.loading-line.short { width: 40%; margin-bottom: 0; }

@keyframes profileShimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.empty-state {
  margin-top: 18rpx;
  padding: 34rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.empty-state-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  background: rgba(20, 134, 111, 0.12);
  position: relative;
  margin-bottom: 18rpx;
}

.empty-state-icon::before,
.empty-state-icon::after {
  content: '';
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
}

.empty-state-icon::before {
  top: 22rpx;
  box-shadow: 0 12rpx 0 var(--color-primary);
}

.empty-state-icon::after {
  top: 46rpx;
  width: 16rpx;
}

.empty-state-title {
  display: block;
  font-size: var(--font-lg);
  font-weight: 800;
  color: var(--color-text-strong);
}

.empty-state-copy {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-sm);
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.empty-state-button {
  width: 100%;
  margin-top: 18rpx;
}

.trip-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 18rpx;
}

.trip-card {
  padding: 24rpx;
}

.trip-card:active {
  transform: scale(0.99);
}

.trip-card-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 14rpx;
}

.trip-card-main {
  flex: 1;
  min-width: 0;
}

.trip-card-title {
  display: block;
  font-size: var(--font-base);
  line-height: 1.45;
  color: var(--color-text-strong);
  font-weight: 800;
}

.trip-card-date {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

.trip-card-source {
  min-height: 38rpx;
  padding: 0 14rpx;
  display: inline-flex;
  align-items: center;
  border-radius: 999rpx;
  background: rgba(20, 134, 111, 0.12);
  color: var(--color-primary);
  font-size: var(--font-mini);
  font-weight: 800;
}

.trip-card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 16rpx;
}

.trip-card-tag {
  min-height: 38rpx;
  padding: 0 14rpx;
  display: inline-flex;
  align-items: center;
  border-radius: 999rpx;
  background: rgba(24, 37, 33, 0.05);
  color: var(--color-text-secondary);
  font-size: var(--font-xs);
  font-weight: 700;
}

.trip-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--color-border);
}

.trip-card-status {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
}

.trip-card-delete {
  min-height: 38rpx;
  padding: 0 14rpx;
  display: inline-flex;
  align-items: center;
  border-radius: 999rpx;
  background: rgba(207, 74, 64, 0.12);
  color: var(--color-danger);
  font-size: var(--font-mini);
  font-weight: 800;
}
