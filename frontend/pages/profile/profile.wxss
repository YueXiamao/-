/* pages/profile/profile.wxss */

/* ── Page ── */
.container {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding: 32rpx 28rpx 120rpx;
}

/* ── User Card ── */
.user-section {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: var(--r-lg);
}

.user-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--r-base);
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--color-primary);
  letter-spacing: 1rpx;
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
}

.user-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.user-id {
  font-size: var(--font-lg);
  color: var(--color-text);
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-hint {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

/* ── Section Title ── */
.trips-section {
  margin-top: 4rpx;
}

.section-title {
  font-size: var(--font-lg);
  font-weight: 800;
  color: var(--color-text);
  margin-bottom: 16rpx;
  letter-spacing: -0.3rpx;
}

.loading {
  text-align: center;
  padding: var(--sp-xl) 0;
  color: var(--color-text-secondary);
  font-size: var(--font-base);
}

/* ── Empty State ── */
.empty-state {
  padding: 60rpx 32rpx;
  text-align: center;
  border-radius: var(--r-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.empty-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: var(--r-lg);
  background: var(--color-bg-alt);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--color-text-hint);
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.empty-text {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-text);
}

.empty-hint {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

/* ── Trip List ── */
.trip-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.trip-item {
  position: relative;
  border-radius: var(--r-lg);
  padding: 24rpx;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.trip-item:active {
  transform: scale(0.99);
}

.trip-item-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.trip-item-title {
  font-size: var(--font-base);
  font-weight: 700;
  color: var(--color-text);
  flex: 1;
  line-height: 1.3;
}

.trip-item-status {
  font-size: 20rpx;
  color: var(--color-primary);
  background: var(--color-primary-light);
  padding: 4rpx 12rpx;
  border-radius: var(--r-full);
  font-weight: 600;
  white-space: nowrap;
  flex-shrink: 0;
}

.trip-item-meta {
  display: flex;
  gap: 16rpx;
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  margin-bottom: 10rpx;
}

.trip-item-dests {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.dest-tag {
  background: var(--color-bg);
  color: var(--color-text-secondary);
  padding: 4rpx 12rpx;
  border-radius: var(--r-sm);
  font-size: 20rpx;
  border: 1rpx solid var(--color-border);
}

.trip-item-actions {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
}

.action-text {
  font-size: var(--font-xs);
  color: var(--color-danger);
  font-weight: 600;
  padding: 6rpx 12rpx;
  border-radius: var(--r-full);
  background: var(--color-danger-light);
  transition: opacity 0.12s;
}

.action-text:active {
  opacity: 0.75;
}
