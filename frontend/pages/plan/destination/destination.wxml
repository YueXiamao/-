<!-- pages/plan/destination/destination.wxml -->
<view class="container">
  <!-- 搜索框 -->
  <view class="search-bar">
    <input
      class="search-input"
      placeholder="搜索市或县..."
      value="{{searchValue}}"
      bindinput="onSearchInput"
    />
    <view class="search-close" bindtap="onSearchClose" wx:if="{{showSearch}}">×</view>
  </view>

  <!-- 搜索结果 -->
  <view class="search-results" wx:if="{{showSearch && searchResults.length > 0}}">
    <view
      class="search-result-item"
      wx:for="{{searchResults}}"
      wx:key="code"
      bindtap="onSearchResultTap"
      data-name="{{item.name}}"
      data-code="{{item.code}}"
      data-level="{{item.level}}"
      data-province="{{item.province}}"
      data-city="{{item.city}}"
    >
      <text class="result-name">{{item.name}}</text>
      <text class="result-level">{{item.level === 'city' ? '市' : '县'}}</text>
    </view>
  </view>

  <!-- 已选目的地（灰色选中框，始终显示在顶部） -->
  <view class="selected-bar" wx:if="{{selectedDestinations.length > 0}}">
    <text class="selected-label">已选 ({{selectedDestinations.length}}/{{maxDestinations}})</text>
    <view class="selected-tags">
      <view
        class="selected-tag"
        wx:for="{{selectedDestinations}}"
        wx:key="name"
      >
        <text>{{item.name}}</text>
        <text class="tag-remove" bindtap="onDestRemove" data-index="{{index}}">×</text>
      </view>
    </view>
  </view>

  <!-- 步骤指示 + 返回 -->
  <view class="steps-bar">
    <view class="back-btn" bindtap="onBackStep" wx:if="{{step > 1}}">‹ 返回</view>
    <view class="steps">
      <text class="step {{step >= 1 ? 'active' : ''}}">①省</text>
      <text class="step-sep">›</text>
      <text class="step {{step >= 2 ? 'active' : ''}}">②市</text>
      <text class="step-sep">›</text>
      <text class="step {{step >= 3 ? 'active' : ''}}">③县</text>
    </view>
    <view class="step-hint" wx:if="{{step === 3}}">点击添加县到已选列表</view>
  </view>

  <!-- 省份列表 -->
  <view class="list" wx:if="{{step === 1}}">
    <view
      class="list-item {{selectedProvince && item.code === selectedProvince.code ? 'selected' : ''}}"
      wx:for="{{provinces}}"
      wx:key="code"
      bindtap="onProvinceTap"
      data-code="{{item.code}}"
      data-name="{{item.name}}"
    >
      <text class="item-name">{{item.name}}</text>
      <text class="item-arrow">›</text>
    </view>
  </view>

  <!-- 城市列表 -->
  <view class="list" wx:if="{{step === 2}}">
    <view class="list-header">请选择{{selectedProvince.name}}的市</view>
    <view
      class="list-item"
      wx:for="{{cities}}"
      wx:key="code"
      bindtap="onCityTap"
      data-code="{{item.code}}"
      data-name="{{item.name}}"
    >
      <text class="item-name">{{item.name}}</text>
      <view class="item-right">
        <text class="item-confirm-btn" catchtap="onCityConfirm" data-code="{{item.code}}" data-name="{{item.name}}">选市</text>
        <text class="item-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 区县列表 -->
  <view class="list" wx:if="{{step === 3}}">
    <view class="list-header">请选择{{selectedCity.name}}的区县</view>
    <view
      class="list-item"
      wx:for="{{districts}}"
      wx:key="code"
      bindtap="onDistrictTap"
      data-code="{{item.code}}"
      data-name="{{item.name}}"
    >
      <text class="item-name">{{item.name}}</text>
      <text class="item-arrow">›</text>
    </view>
    <view class="list-tip">直接点击区县名称即可添加到已选列表，可继续选择</view>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 下一步按钮（固定底部） -->
  <view class="bottom-bar {{selectedDestinations.length === 0 ? 'disabled' : ''}}">
    <button
      class="btn-primary"
      bindtap="onNext"
      wx:if="{{selectedDestinations.length > 0}}"
    >下一步 ({{selectedDestinations.length}}个目的地)</button>
    <button class="btn-disabled" wx:if="{{selectedDestinations.length === 0}}">请先选择目的地</button>
  </view>
</view>
