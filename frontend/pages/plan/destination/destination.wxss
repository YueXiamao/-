/* pages/plan/destination/destination.wxss */

.container {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding-bottom: 160rpx;
}

/* 搜索 */
.search-bar {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #EEEEEE;
}

.search-input {
  flex: 1;
  height: 72rpx;
  background-color: #F5F5F5;
  border-radius: 36rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
}

.search-close {
  padding: 0 20rpx;
  font-size: 32rpx;
  color: #999999;
}

/* 搜索结果 */
.search-results {
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #EEEEEE;
  max-height: 500rpx;
  overflow-y: auto;
}

.search-result-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.result-name {
  font-size: 28rpx;
  color: #1A1A1A;
}

.result-level {
  font-size: 22rpx;
  color: #07C160;
  background-color: #E8F8EE;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

/* 已选栏 */
.selected-bar {
  background-color: #FFFFFF;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #EEEEEE;
}

.selected-label {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 12rpx;
  display: block;
}

.selected-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.selected-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background-color: #F0F0F0;
  border: 2rpx solid #DDDDDD;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  font-size: 26rpx;
  color: #1A1A1A;
}

.tag-remove {
  color: #999999;
  font-size: 24rpx;
}

/* 步骤条 */
.steps-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #EEEEEE;
}

.back-btn {
  font-size: 28rpx;
  color: #07C160;
  padding: 8rpx 0;
}

.steps {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.step {
  font-size: 26rpx;
  color: #CCCCCC;
}

.step.active {
  color: #07C160;
  font-weight: 600;
}

.step-sep {
  color: #CCCCCC;
  font-size: 24rpx;
}

.step-hint {
  font-size: 22rpx;
  color: #FF9500;
}

/* 列表 */
.list {
  padding: 16rpx 0;
}

.list-header {
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  color: #999999;
  background-color: #FAFAFA;
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #F5F5F5;
}

.list-item:active {
  background-color: #F5F5F5;
}

.list-item.selected {
  background-color: #E8F8EE;
  border-left: 6rpx solid #07C160;
}

.item-name {
  font-size: 30rpx;
  color: #1A1A1A;
}

.item-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.item-confirm-btn {
  font-size: 24rpx;
  color: #07C160;
  background-color: #E8F8EE;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.item-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
}

.list-tip {
  padding: 16rpx 32rpx;
  font-size: 24rpx;
  color: #FF9500;
  background-color: #FFF8E6;
}

/* 加载 */
.loading {
  text-align: center;
  padding: 40rpx;
  color: #999999;
  font-size: 28rpx;
}

/* 底部按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  border-top: 1rpx solid #EEEEEE;
}

.bottom-bar button {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: none;
  padding: 0 48rpx;
}

.btn-primary {
  background-color: #07C160;
}

.btn-primary .btn-text {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
}

.btn-primary .btn-count {
  color: rgba(255,255,255,0.85);
  font-size: 26rpx;
}

.btn-disabled {
  background-color: #CCCCCC;
}

.btn-disabled .btn-text {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
}
