.container {
  min-height: 100vh;
  background-color: var(--color-bg);
  background-repeat: no-repeat;
  background-position: top center;
  background-size: 100% auto;
  padding: 24rpx;
  padding-bottom: 164rpx;
}

.page-hero {
  padding: 28rpx 8rpx 22rpx;
}

.hero-kicker {
  display: block;
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  margin-bottom: 10rpx;
}

.hero-title {
  display: block;
  font-size: 46rpx;
  font-weight: 800;
  color: var(--color-text);
  line-height: 1.18;
  margin-bottom: 10rpx;
}

.hero-subtitle {
  display: block;
  font-size: 25rpx;
  color: var(--color-text-secondary);
  line-height: 1.58;
}

.hero-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.hero-badge {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.76);
  color: var(--color-text-secondary);
  font-size: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
}

.overview-card,
.search-panel,
.list-shell,
.loading {
  border-radius: 28rpx;
}

.overview-card {
  padding: 24rpx;
  margin-bottom: 18rpx;
}

.overview-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.overview-count {
  width: 92rpx;
  height: 92rpx;
  border-radius: 28rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 42rpx;
  font-weight: 800;
  line-height: 92rpx;
  text-align: center;
}

.overview-copy {
  flex: 1;
}

.overview-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.overview-subtitle {
  display: block;
  font-size: 23rpx;
  color: var(--color-text-secondary);
  line-height: 1.55;
}

.steps {
  display: flex;
  align-items: center;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.step-no {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #EDF2ED;
  color: var(--color-text-hint);
  text-align: center;
  line-height: 48rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.step-name {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.step-line {
  flex: 1;
  height: 2rpx;
  margin: 0 10rpx 28rpx;
  background: rgba(138, 151, 144, 0.2);
}

.step-item.active .step-no,
.step-line.active {
  background: var(--color-primary);
  color: #FFFFFF;
}

.step-item.active .step-name {
  color: var(--color-primary);
  font-weight: 700;
}

.search-panel {
  padding: 22rpx;
  margin-bottom: 16rpx;
}

.search-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.search-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.search-hint {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background-color: rgba(255, 255, 255, 0.94);
  padding: 10rpx 12rpx 10rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
}

.search-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F5F7F5;
  color: var(--color-text-hint);
  font-size: 30rpx;
  line-height: 56rpx;
  text-align: center;
}

.search-results {
  margin-bottom: 16rpx;
  overflow: hidden;
}

.search-result-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid rgba(221, 230, 223, 0.8);
}

.search-result-item:last-child {
  border-bottom: none;
}

.result-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.result-name {
  font-size: 28rpx;
  color: var(--color-text);
}

.result-path {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.result-level {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 22rpx;
}

.selected-scroll {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.selected-tags {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 12rpx;
}

.selected-tag {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: var(--shadow-sm);
}

.selected-copy {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.selected-name {
  font-size: 26rpx;
  color: var(--color-text);
}

.selected-meta {
  font-size: 20rpx;
  color: var(--color-text-hint);
}

.tag-remove {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #F4F7F4;
  color: var(--color-text-hint);
  font-size: 24rpx;
  text-align: center;
  line-height: 36rpx;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 10rpx 6rpx 14rpx;
}

.section-copy {
  flex: 1;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 760;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.section-hint {
  display: block;
  font-size: 23rpx;
  color: var(--color-text-secondary);
  line-height: 1.55;
}

.back-chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  color: var(--color-primary);
  font-size: 22rpx;
}

.list-shell {
  overflow: hidden;
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 24rpx;
  background-color: rgba(255, 255, 255, 0.94);
  border-bottom: 1rpx solid rgba(221, 230, 223, 0.72);
}

.list-item:last-child {
  border-bottom: none;
}

.list-item:active {
  background-color: #F7FAF7;
}

.list-item.selected {
  background-color: #EAF6EF;
}

.item-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
}

.item-name {
  font-size: 30rpx;
  color: var(--color-text);
}

.item-subtitle {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.item-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.item-confirm-btn {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #FFF1E2;
  color: var(--color-secondary);
  font-size: 22rpx;
}

.item-arrow {
  font-size: 34rpx;
  color: var(--color-text-hint);
}

.loading {
  margin-top: 16rpx;
  padding: 28rpx 24rpx;
  text-align: center;
  color: var(--color-text-secondary);
  font-size: 26rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid rgba(221, 230, 223, 0.8);
  box-shadow: 0 -10rpx 28rpx rgba(35, 55, 45, 0.08);
}

.bottom-bar button {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: none;
  padding: 0 48rpx;
}

.btn-primary {
  background-color: var(--color-primary);
}

.btn-primary .btn-text {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
}

.btn-primary .btn-count {
  color: rgba(255,255,255,0.88);
  font-size: 24rpx;
}

.btn-disabled {
  background-color: #B8C4BD;
}
