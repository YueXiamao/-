/* pages/plan/destination/destination.wxss */

/* ── Page ── */
.container {
  min-height: 100vh;
  background-color: var(--color-bg);
  background-repeat: no-repeat;
  background-position: top center;
  background-size: 100% auto;
  padding: 0 0 160rpx 0;
}

/* ── Hero ── */
.hero-wrap {
  padding: 56rpx 36rpx 40rpx;
  background: linear-gradient(160deg, #E8F5EE 0%, #EDF5F0 60%, var(--color-bg) 100%);
  position: relative;
  overflow: hidden;
}

.hero-wrap::before {
  content: '';
  position: absolute;
  top: -50rpx;
  right: -50rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(13, 156, 110, 0.1) 0%, transparent 70%);
  pointer-events: none;
}

.hero-kicker {
  display: block;
  font-size: var(--font-kicker);
  font-weight: 700;
  color: var(--color-primary);
  letter-spacing: 3rpx;
  margin-bottom: 10rpx;
  text-transform: uppercase;
}

.hero-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: var(--color-text);
  line-height: 1.1;
  letter-spacing: var(--tracking-tight);
  margin-bottom: 12rpx;
}

.hero-subtitle {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.hero-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.hero-badge {
  padding: 7rpx 16rpx;
  border-radius: var(--r-full);
  background: var(--color-surface);
  color: var(--color-text-secondary);
  font-size: var(--font-xs);
  border: 1rpx solid var(--color-border);
}

/* ── Content ── */
.content-wrap {
  padding: 0 32rpx;
  margin-top: -16rpx;
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* ── Overview Card ── */
.overview-card {
  padding: 28rpx 28rpx 24rpx;
  border-radius: var(--r-xl);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.overview-main {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 22rpx;
}

.overview-count {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--r-lg);
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 42rpx;
  font-weight: 800;
  line-height: 96rpx;
  text-align: center;
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
}

.overview-copy {
  flex: 1;
  min-width: 0;
}

.overview-title {
  display: block;
  font-size: var(--font-lg);
  font-weight: 800;
  color: var(--color-text);
  margin-bottom: 6rpx;
}

.overview-subtitle {
  display: block;
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

/* ── Step Indicator ── */
.steps {
  display: flex;
  align-items: center;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.step-no {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--color-bg);
  color: var(--color-text-hint);
  text-align: center;
  line-height: 48rpx;
  font-size: var(--font-xs);
  font-weight: 700;
  border: 2rpx solid var(--color-border);
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.step-name {
  font-size: 20rpx;
  color: var(--color-text-hint);
  transition: color 0.2s;
}

.step-line {
  flex: 1;
  height: 2rpx;
  margin: 0 10rpx 30rpx;
  background: var(--color-border);
  transition: background 0.25s;
}

.step-item.active .step-no {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #fff;
  box-shadow: 0 4rpx 14rpx rgba(13, 156, 110, 0.3);
}

.step-item.active .step-name {
  color: var(--color-primary);
  font-weight: 700;
}

.step-line.active {
  background: var(--color-primary);
}

/* ── Search Panel ── */
.search-panel {
  padding: 24rpx 24rpx 22rpx;
  border-radius: var(--r-xl);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.search-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.search-title {
  font-size: var(--font-base);
  font-weight: 700;
  color: var(--color-text);
}

.search-hint {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: var(--color-bg);
  padding: 0 16rpx 0 20rpx;
  border-radius: var(--r-full);
  border: 1.5rpx solid var(--color-border);
  height: 72rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: var(--font-base);
  color: var(--color-text);
}

.search-close {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--color-bg);
  color: var(--color-text-hint);
  font-size: 28rpx;
  text-align: center;
  line-height: 52rpx;
  flex-shrink: 0;
}

/* ── Search Results ── */
.search-results {
  border-radius: var(--r-xl);
  overflow: hidden;
  box-shadow: var(--shadow-md);
}

.search-result-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 26rpx;
  background: var(--color-surface);
  border-bottom: 1rpx solid var(--color-border);
  transition: background 0.12s;
}

.search-result-item:last-child {
  border-bottom: none;
}

.search-result-item:active {
  background: var(--color-bg);
}

.result-copy {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
  min-width: 0;
}

.result-name {
  font-size: var(--font-base);
  color: var(--color-text);
  font-weight: 600;
}

.result-path {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
}

.result-level {
  padding: 6rpx 14rpx;
  border-radius: var(--r-full);
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: var(--font-xs);
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* ── Selected Tags ── */
.selected-scroll {
  white-space: nowrap;
}

.selected-tags {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 12rpx;
}

.selected-tag {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 18rpx;
  border-radius: var(--r-md);
  background: var(--color-surface);
  box-shadow: var(--shadow-xs);
  border: 1rpx solid var(--color-border);
}

.selected-copy {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.selected-name {
  font-size: var(--font-base);
  color: var(--color-text);
  font-weight: 600;
}

.selected-meta {
  font-size: 20rpx;
  color: var(--color-text-hint);
}

.tag-remove {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--color-bg);
  color: var(--color-text-hint);
  font-size: 24rpx;
  text-align: center;
  line-height: 36rpx;
  flex-shrink: 0;
  transition: background 0.12s, color 0.12s;
}

.tag-remove:active {
  background: var(--color-danger-light);
  color: var(--color-danger);
}

/* ── Section Header ── */
.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 8rpx 4rpx 16rpx;
}

.section-copy {
  flex: 1;
  min-width: 0;
}

.section-title {
  display: block;
  font-size: var(--font-lg);
  font-weight: 800;
  color: var(--color-text);
  margin-bottom: 6rpx;
  letter-spacing: -0.3rpx;
}

.section-hint {
  display: block;
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  line-height: 1.55;
}

.back-chip {
  padding: 8rpx 18rpx;
  border-radius: var(--r-full);
  background: var(--color-surface);
  color: var(--color-primary);
  font-size: var(--font-xs);
  font-weight: 600;
  border: 1.5rpx solid var(--color-primary-light);
  white-space: nowrap;
  flex-shrink: 0;
  margin-top: 4rpx;
  transition: background 0.15s;
}

.back-chip:active {
  background: var(--color-primary-light);
}

/* ── List ── */
.list-shell {
  overflow: hidden;
  border-radius: var(--r-xl);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 28rpx;
  background: var(--color-surface);
  border-bottom: 1rpx solid var(--color-border);
  transition: background 0.12s;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item:active {
  background: var(--color-bg);
}

.list-item.selected {
  background: var(--color-primary-light);
}

.item-copy {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: var(--font-base);
  color: var(--color-text);
  font-weight: 600;
}

.item-subtitle {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
}

.item-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-shrink: 0;
}

.item-confirm-btn {
  padding: 8rpx 18rpx;
  border-radius: var(--r-full);
  background: var(--color-secondary-light);
  color: var(--color-secondary);
  font-size: var(--font-xs);
  font-weight: 700;
  transition: background 0.12s;
}

.item-confirm-btn:active {
  background: rgba(232, 129, 10, 0.22);
}

.item-arrow {
  font-size: 34rpx;
  color: var(--color-text-hint);
  font-weight: 300;
}

/* ── Loading ── */
.loading {
  margin-top: 14rpx;
  padding: 28rpx 24rpx;
  text-align: center;
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
  border-radius: var(--r-xl);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

/* ── Bottom Bar ── */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.97);
  border-top: 1rpx solid var(--color-border);
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.bottom-bar button {
  width: 100%;
  height: 100rpx;
  border-radius: var(--r-xl);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: none;
  padding: 0 48rpx;
  transition: opacity 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
}

.bottom-bar button:active {
  transform: scale(0.985);
  opacity: 0.9;
}

.btn-primary {
  background-color: var(--color-primary);
  box-shadow: 0 8rpx 32rpx rgba(13, 156, 110, 0.28);
}

.btn-primary .btn-text {
  color: #fff;
  font-size: var(--font-lg);
  font-weight: 700;
}

.btn-primary .btn-count {
  color: rgba(255, 255, 255, 0.82);
  font-size: var(--font-sm);
  font-weight: 500;
}

.btn-disabled {
  background-color: var(--color-bg);
  box-shadow: none;
}

.btn-disabled .btn-text {
  color: var(--color-text-hint);
}
