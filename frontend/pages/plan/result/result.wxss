/* pages/plan/result/result.wxss */

/* ── Page ── */
.container {
  min-height: 100vh;
  background-color: var(--color-bg);
  background-repeat: no-repeat;
  background-position: top center;
  background-size: 100% auto;
  padding: 24rpx 28rpx 120rpx;
}

/* ── Loading ── */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
  gap: 20rpx;
}

.loading-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--r-lg);
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 800;
  color: var(--color-primary);
  letter-spacing: 2rpx;
  box-shadow: var(--shadow-md);
}

.loading-text {
  font-size: var(--font-base);
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.loading-dots {
  display: flex;
  gap: 8rpx;
  margin-top: 8rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-primary);
  animation: pulse 1.2s ease-in-out infinite;
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes pulse {
  0%, 100% { opacity: 0.3; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1); }
}

/* ── Error ── */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
  gap: 16rpx;
}

.error-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: var(--r-lg);
  background: var(--color-danger-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 800;
  color: var(--color-danger);
  letter-spacing: 2rpx;
}

.error-text {
  font-size: var(--font-base);
  color: var(--color-text-secondary);
  text-align: center;
  max-width: 500rpx;
}

.btn-secondary {
  background: var(--color-surface);
  color: var(--color-text);
  border: 2rpx solid var(--color-border-strong);
  border-radius: var(--r-xl);
  height: 80rpx;
  line-height: 80rpx;
  font-size: var(--font-base);
  font-weight: 600;
  padding: 0 40rpx;
  margin-top: 8rpx;
}

/* ── Card ── */
.card {
  background: var(--color-surface);
  border-radius: var(--r-lg);
  overflow: hidden;
  border: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-sm);
}

/* ── Trip Header ── */
.trip-header {
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.trip-title {
  font-size: var(--font-xl);
  font-weight: 800;
  color: var(--color-text);
  margin-bottom: 14rpx;
  letter-spacing: -0.5rpx;
  line-height: 1.2;
}

.trip-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.meta-item {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  background: var(--color-bg);
  padding: 4rpx 14rpx;
  border-radius: var(--r-full);
}

.trip-dests {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.dest-tag {
  background: var(--color-primary-light);
  color: var(--color-primary);
  padding: 5rpx 14rpx;
  border-radius: var(--r-full);
  font-size: var(--font-xs);
  font-weight: 600;
}

/* ── Generation Banner ── */
.generation-banner {
  margin-bottom: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: var(--r-base);
  background: rgba(22, 160, 109, 0.07);
  border: 1rpx solid rgba(22, 160, 109, 0.15);
}

.generation-banner__label {
  display: block;
  margin-bottom: 6rpx;
  font-size: 20rpx;
  color: var(--color-primary);
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.generation-banner__text {
  display: block;
  font-size: var(--font-sm);
  line-height: 1.6;
  color: var(--color-text-secondary);
}

/* ── Action Bar ── */
.action-bar {
  display: flex;
  justify-content: center;
  gap: 56rpx;
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  background: var(--color-surface);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-xs);
  border: 1rpx solid var(--color-border);
}

.action-btn,
.share-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  background: none;
  border: none;
  padding: 0;
}

.action-mark {
  color: var(--color-text);
  font-size: var(--font-kicker);
  font-weight: 800;
  letter-spacing: 1rpx;
}

.action-label {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  font-weight: 500;
}

/* ── Days ── */
.days {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.day-section {
  border-radius: var(--r-lg);
  overflow: hidden;
  box-shadow: var(--shadow-xs);
  border: 1rpx solid var(--color-border);
}

/* ── Day Header ── */
.day-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  background: var(--color-surface);
  transition: background 0.15s;
}

.day-header:active {
  background: var(--color-bg);
}

.day-info {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.day-num {
  font-size: var(--font-lg);
  font-weight: 800;
  color: var(--color-primary);
  letter-spacing: -0.3rpx;
}

.day-date {
  font-size: var(--font-sm);
  color: var(--color-text-hint);
}

.day-arrow {
  font-size: 40rpx;
  color: var(--color-text-hint);
  font-weight: 300;
  transition: transform 0.2s ease;
  line-height: 1;
}

.day-arrow.expanded {
  transform: rotate(90deg);
  color: var(--color-primary);
}

/* ── Day Content ── */
.day-content {
  padding: 0 28rpx 24rpx;
  background: var(--color-surface);
  border-top: 1rpx solid var(--color-border);
}

.items-list {
  display: flex;
  flex-direction: column;
}

/* ── Trip Item ── */
.trip-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
  transition: opacity 0.15s ease;
}

.trip-item:last-child {
  border-bottom: none;
}

.trip-item.dragging {
  opacity: 0.5;
}

.trip-item.drag-over {
  border-top: 3rpx solid var(--color-primary);
  padding-top: 4rpx;
}

/* ── Item Row ── */
.item-row {
  display: flex;
  gap: 14rpx;
}

.item-drag-handle {
  width: 36rpx;
  font-size: 24rpx;
  color: var(--color-border-strong);
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 4rpx;
  flex-shrink: 0;
  letter-spacing: 2rpx;
}

/* ── Item Icon ── */
.item-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: var(--r-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 800;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.item-spot .item-icon {
  background: linear-gradient(135deg, rgba(22, 160, 109, 0.15), rgba(22, 160, 109, 0.08));
  color: var(--color-primary);
}

.item-food .item-icon {
  background: linear-gradient(135deg, rgba(245, 158, 11, 0.18), rgba(245, 158, 11, 0.08));
  color: var(--color-secondary);
}

.item-hotel .item-icon {
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.15), rgba(99, 102, 241, 0.08));
  color: #6366F1;
}

/* ── Item Body ── */
.item-body {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: var(--font-base);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 5rpx;
  line-height: 1.3;
}

.item-meta {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  margin-bottom: 3rpx;
  line-height: 1.5;
}

.item-desc {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  margin-top: 5rpx;
  line-height: 1.6;
}

.item-rec {
  font-size: var(--font-xs);
  color: var(--color-secondary);
  margin-top: 5rpx;
  font-weight: 500;
  line-height: 1.5;
}

.item-transport {
  font-size: var(--font-xs);
  color: var(--color-primary);
  margin-top: 6rpx;
  font-weight: 500;
  padding: 4rpx 10rpx;
  background: var(--color-primary-light);
  border-radius: 6rpx;
  display: inline-block;
}

.item-reason {
  font-size: var(--font-xs);
  color: #6366F1;
  margin-top: 5rpx;
  line-height: 1.5;
}

.item-budget {
  font-size: var(--font-sm);
  color: var(--color-danger);
  margin-top: 6rpx;
  font-weight: 600;
}

.item-note {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg);
  padding: 5rpx 12rpx;
  border-radius: 8rpx;
  margin-top: 8rpx;
  display: inline-block;
  border: 1rpx solid var(--color-border);
}

/* ── Item Actions ── */
.item-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  flex-shrink: 0;
  align-items: flex-end;
  padding-top: 2rpx;
}

.action-chip-group {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8rpx;
}

.item-action {
  min-width: 58rpx;
  padding: 8rpx 14rpx;
  border-radius: var(--r-full);
  background: var(--color-bg);
  color: var(--color-text-secondary);
  font-size: 20rpx;
  font-weight: 600;
  text-align: center;
  transition: background 0.12s, color 0.12s;
}

.item-action:active {
  background: var(--color-bg-alt);
}

.item-action.accent {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.item-action.danger {
  background: var(--color-danger-light);
  color: var(--color-danger);
}

/* ── Empty Day ── */
.empty-day {
  padding: 48rpx 0;
  text-align: center;
  font-size: var(--font-base);
  color: var(--color-text-hint);
}
