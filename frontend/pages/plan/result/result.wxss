.container {
  min-height: 100vh;
  background-color: var(--color-bg);
  background-repeat: no-repeat;
  background-position: top center;
  background-size: 100% auto;
  padding: 24rpx;
  padding-bottom: 120rpx;
}

.card {
  background-color: rgba(255, 255, 255, 0.92);
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: var(--shadow-sm);
}

.loading-state,
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-icon,
.error-icon {
  font-size: 80rpx;
  margin-bottom: 32rpx;
}

.loading-text,
.error-text {
  font-size: 30rpx;
  color: #666666;
  margin-bottom: 24rpx;
  text-align: center;
}

.loading-dots {
  display: flex;
  gap: 8rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #07c160;
  animation: pulse 1.2s ease-in-out infinite;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes pulse {
  0%, 100% {
    opacity: 0.3;
    transform: scale(0.8);
  }

  50% {
    opacity: 1;
    transform: scale(1);
  }
}

.btn-secondary {
  background-color: #f5f5f5;
  color: #1a1a1a;
  border-radius: 48rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  border: none;
  padding: 0 48rpx;
}

.trip-header {
  padding: 28rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(180deg, rgba(255,255,255,0.92), rgba(255,255,255,0.8));
}

.trip-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.trip-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #666666;
}

.trip-dests {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.dest-tag {
  background-color: #e8f8ee;
  color: #07c160;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.action-bar {
  display: flex;
  justify-content: center;
  gap: 52rpx;
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.84);
  border-radius: 24rpx;
  box-shadow: var(--shadow-sm);
}

.action-btn,
.share-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  font-size: 36rpx;
  background: none;
  border: none;
  padding: 0;
}

.action-mark {
  color: var(--color-text);
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.action-label {
  font-size: 22rpx;
  color: #666666;
}

.share-btn::after {
  border: none;
}

.days {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.day-section {
  border-radius: 24rpx;
}

.day-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  background-color: rgba(255, 255, 255, 0.94);
}

.day-info {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.day-num {
  font-size: 34rpx;
  font-weight: 700;
  color: #07c160;
}

.day-date {
  font-size: 24rpx;
  color: #999999;
}

.day-arrow {
  font-size: 40rpx;
  color: #cccccc;
  transition: transform 0.2s ease;
}

.day-arrow.expanded {
  transform: rotate(90deg);
}

.day-content {
  padding: 0 28rpx 24rpx;
  background-color: rgba(255, 255, 255, 0.94);
}

.trip-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.trip-item:last-child {
  border-bottom: none;
}

.item-row {
  display: flex;
  gap: 16rpx;
}

.item-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 18rpx;
  background: linear-gradient(180deg, rgba(31, 184, 116, 0.12), rgba(31, 184, 116, 0.2));
  color: #148857;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.item-body {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 6rpx;
}

.item-meta {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 4rpx;
  line-height: 1.5;
}

.item-desc,
.item-rec {
  font-size: 24rpx;
  color: #666666;
  margin-top: 6rpx;
  line-height: 1.55;
}

.item-transport {
  font-size: 24rpx;
  color: #07c160;
  margin-top: 6rpx;
}

.item-reason {
  font-size: 24rpx;
  color: #f08a24;
  margin-top: 4rpx;
  line-height: 1.5;
}

.item-budget {
  font-size: 26rpx;
  color: #ff6b00;
  margin-top: 6rpx;
  font-weight: 600;
}

.item-note {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  background-color: #f6f9f5;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  margin-top: 10rpx;
  display: inline-block;
}

.item-actions {
  width: 176rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex-shrink: 0;
  align-items: flex-end;
}

.action-chip-group {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10rpx;
}

.item-action {
  min-width: 66rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #f4f7f4;
  color: #496155;
  font-size: 22rpx;
  line-height: 1;
  text-align: center;
  white-space: nowrap;
}

.item-action.accent {
  background: rgba(20, 136, 87, 0.12);
  color: #148857;
}

.item-action.danger {
  background: rgba(255, 92, 92, 0.12);
  color: #d94848;
}
