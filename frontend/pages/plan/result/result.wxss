/* pages/plan/result/result.wxss */
.container {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding: 24rpx;
  padding-bottom: 120rpx;
}

/* 通用卡片 */
.card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-icon {
  font-size: 80rpx;
  margin-bottom: 32rpx;
}

.loading-text {
  font-size: 30rpx;
  color: #666666;
  margin-bottom: 24rpx;
}

.loading-dots {
  display: flex;
  gap: 8rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #07C160;
  animation: pulse 1.2s ease-in-out infinite;
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes pulse {
  0%, 100% { opacity: 0.3; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1); }
}

/* 错误状态 */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: 32rpx;
}

.error-text {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 32rpx;
  text-align: center;
}

.btn-secondary {
  background-color: #F5F5F5;
  color: #1A1A1A;
  border-radius: 48rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  border: none;
  padding: 0 48rpx;
}

/* 行程头部 */
.trip-header {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.trip-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 16rpx;
}

.trip-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #666666;
}

.trip-dests {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.dest-tag {
  background-color: #E8F8EE;
  color: #07C160;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

/* 操作栏 */
.action-bar {
  display: flex;
  justify-content: center;
  gap: 80rpx;
  margin-bottom: 24rpx;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  font-size: 36rpx;
  background: none;
  border: none;
  padding: 0;
}

.action-label {
  font-size: 22rpx;
  color: #666666;
}

.share-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  background: none;
  border: none;
  padding: 0;
  font-size: 36rpx;
}

.share-btn::after { border: none; }

/* 每日行程 */
.days {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.day-section {
  border-radius: 16rpx;
}

.day-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  background-color: #FFFFFF;
}

.day-info {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.day-num {
  font-size: 34rpx;
  font-weight: 700;
  color: #07C160;
}

.day-date {
  font-size: 24rpx;
  color: #999999;
}

.day-arrow {
  font-size: 40rpx;
  color: #CCCCCC;
  transition: transform 0.2s ease;
}

.day-arrow.expanded {
  transform: rotate(90deg);
}

/* 单项内容 */
.day-content {
  padding: 0 28rpx 24rpx;
  background-color: #FFFFFF;
}

.trip-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.trip-item:last-child {
  border-bottom: none;
}

.item-spot,
.item-food,
.item-hotel {
  display: flex;
  gap: 16rpx;
}

.item-icon {
  font-size: 28rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
  width: 48rpx;
  text-align: center;
}

.item-body {
  flex: 1;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 6rpx;
}

.item-meta {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 4rpx;
}

.item-desc {
  font-size: 24rpx;
  color: #666666;
  margin-top: 6rpx;
  line-height: 1.5;
}

.item-transport {
  font-size: 24rpx;
  color: #07C160;
  margin-top: 6rpx;
}

.item-rec {
  font-size: 24rpx;
  color: #666666;
  margin-top: 4rpx;
}

.item-reason {
  font-size: 24rpx;
  color: #FF9500;
  margin-top: 4rpx;
}

.item-budget {
  font-size: 26rpx;
  color: #FF6B00;
  margin-top: 6rpx;
  font-weight: 600;
}

.item-note {
  font-size: 22rpx;
  color: #999999;
  background-color: #F5F5F5;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  margin-top: 8rpx;
  display: inline-block;
}

.item-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex-shrink: 0;
  align-items: flex-end;
}

.item-action {
  font-size: 22rpx;
  color: #07C160;
  white-space: nowrap;
}

.item-action.danger {
  color: #FF4444;
}
