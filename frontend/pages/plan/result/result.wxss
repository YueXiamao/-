.trip-page {
  padding-bottom: 88rpx;
}

.state-block-rich {
  min-height: 100vh;
  padding-top: 0;
}

.state-plan-icon {
  width: 34rpx;
  height: 26rpx;
  position: relative;
}

.state-plan-icon::before,
.state-plan-icon::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  height: 4rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
}

.state-plan-icon::before {
  top: 4rpx;
  box-shadow: 0 10rpx 0 var(--color-primary);
}

.state-plan-icon::after {
  width: 18rpx;
  top: 24rpx;
}

.state-error-icon {
  width: 12rpx;
  height: 36rpx;
  background: var(--color-danger);
  border-radius: 999rpx;
  position: relative;
}

.state-error-icon::after {
  content: '';
  position: absolute;
  bottom: -12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-danger);
}

.loading-dots {
  display: flex;
  gap: 10rpx;
  margin-top: 18rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(20, 134, 111, 0.35);
}

.trip-hero {
  padding-bottom: 20rpx;
}

.trip-cover {
  overflow: hidden;
}

.trip-cover-image {
  height: 220rpx;
  background-position: center;
  background-size: cover;
}

.trip-cover-body {
  padding: 26rpx 24rpx 24rpx;
}

.trip-summary-title {
  display: block;
  font-size: 46rpx;
  line-height: 1.16;
  font-weight: 800;
  color: var(--color-text-strong);
}

.trip-top-meta {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}

.trip-top-meta-item {
  padding: 16rpx;
  border-radius: 22rpx;
  background: rgba(24, 37, 33, 0.04);
}

.trip-top-meta-label {
  display: block;
  font-size: var(--font-mini);
  color: var(--color-text-hint);
}

.trip-top-meta-value {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-xs);
  line-height: 1.4;
  color: var(--color-text-strong);
  font-weight: 700;
}

.trip-meta-chips,
.trip-destinations {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.trip-destination {
  min-height: 42rpx;
  padding: 0 14rpx;
  display: inline-flex;
  align-items: center;
  border-radius: 999rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: var(--font-xs);
  font-weight: 700;
}

.generation-banner {
  margin-top: 14rpx;
  padding: 20rpx 22rpx;
}

.generation-banner-label {
  display: block;
  font-size: var(--font-mini);
  font-weight: 700;
  color: var(--color-primary);
}

.generation-banner-text {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-xs);
  line-height: 1.55;
  color: var(--color-text-secondary);
}

.action-strip {
  margin-top: 14rpx;
  padding: 10rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}

.action-strip-item {
  min-height: 126rpx;
  border-radius: 22rpx;
  background: rgba(24, 37, 33, 0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.action-strip-item:active {
  transform: scale(0.98);
}

.action-strip-button {
  line-height: inherit;
}

.action-strip-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 16rpx;
  background: rgba(20, 134, 111, 0.12);
  position: relative;
}

.action-save-icon::before,
.action-save-icon::after,
.action-copy-icon::before,
.action-copy-icon::after,
.action-share-icon::before,
.action-share-icon::after {
  content: '';
  position: absolute;
}

.action-save-icon::before {
  top: 11rpx;
  left: 11rpx;
  width: 22rpx;
  height: 18rpx;
  border: 3rpx solid var(--color-primary);
  border-top: none;
  border-radius: 0 0 6rpx 6rpx;
}

.action-save-icon::after {
  top: 10rpx;
  left: 14rpx;
  width: 16rpx;
  height: 3rpx;
  background: var(--color-primary);
}

.action-copy-icon::before {
  top: 10rpx;
  left: 14rpx;
  width: 18rpx;
  height: 20rpx;
  border: 3rpx solid var(--color-primary);
  border-radius: 6rpx;
}

.action-copy-icon::after {
  top: 15rpx;
  left: 9rpx;
  width: 18rpx;
  height: 20rpx;
  border: 3rpx solid rgba(20, 134, 111, 0.45);
  border-radius: 6rpx;
}

.action-share-icon::before {
  top: 12rpx;
  left: 12rpx;
  width: 20rpx;
  height: 20rpx;
  border-top: 3rpx solid var(--color-primary);
  border-right: 3rpx solid var(--color-primary);
  transform: rotate(-45deg);
}

.action-share-icon::after {
  bottom: 12rpx;
  left: 20rpx;
  width: 3rpx;
  height: 14rpx;
  background: var(--color-primary);
}

.action-strip-label {
  font-size: var(--font-sm);
  font-weight: 800;
  color: var(--color-text-strong);
}

.days {
  padding: 0 32rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.day-card {
  overflow: hidden;
}

.day-card-head {
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.day-card-main {
  flex: 1;
  min-width: 0;
}

.day-card-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.day-card-title {
  font-size: var(--font-lg);
  font-weight: 800;
  color: var(--color-text-strong);
}

.day-card-count {
  min-height: 36rpx;
  padding: 0 12rpx;
  display: inline-flex;
  align-items: center;
  border-radius: 999rpx;
  background: rgba(24, 37, 33, 0.05);
  color: var(--color-text-secondary);
  font-size: var(--font-mini);
  font-weight: 700;
}

.day-card-date {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

.day-card-toggle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(24, 37, 33, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
}

.day-card-toggle-icon {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid var(--color-text-secondary);
  border-right: 3rpx solid var(--color-text-secondary);
  transform: rotate(135deg);
  margin-top: -8rpx;
}

.day-card-toggle.expanded .day-card-toggle-icon {
  transform: rotate(-135deg);
  margin-top: 4rpx;
}

.day-card-body {
  border-top: 1rpx solid var(--color-border);
  padding: 0 24rpx 8rpx;
}

.day-overview {
  padding: 18rpx 0 14rpx;
}

.day-overview-copy {
  display: block;
  font-size: var(--font-sm);
  line-height: 1.65;
  color: var(--color-text-secondary);
}

.route-list {
  display: flex;
  flex-direction: column;
}

.route-row {
  display: flex;
  gap: 18rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid var(--color-border);
}

.route-rail {
  width: 94rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.route-period-badge {
  min-width: 68rpx;
  padding: 4rpx 8rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 18rpx;
  font-weight: 700;
  color: var(--color-text-secondary);
  background: rgba(24, 37, 33, 0.06);
}

.route-period-spot {
  color: var(--color-primary);
  background: rgba(20, 134, 111, 0.12);
}

.route-period-food {
  color: var(--color-secondary-deep);
  background: rgba(240, 138, 46, 0.14);
}

.route-period-hotel {
  color: var(--color-accent);
  background: rgba(79, 132, 244, 0.12);
}

.route-type {
  width: 72rpx;
  min-height: 72rpx;
  border-radius: 22rpx;
  padding: 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.35;
}

.route-type-spot {
  color: #067647;
  background: linear-gradient(145deg, #dcf6ea, #c8eddd);
}

.route-type-food {
  color: #b26500;
  background: linear-gradient(145deg, #fff1d2, #fce4b6);
}

.route-type-hotel {
  color: #3d6fe0;
  background: linear-gradient(145deg, #e8efff, #dbe7ff);
}

.route-panel {
  flex: 1;
  min-width: 0;
}

.route-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.route-name {
  flex: 1;
  font-size: var(--font-base);
  line-height: 1.45;
  color: var(--color-text-strong);
  font-weight: 800;
}

.route-quick-actions {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
}

.route-action {
  min-width: 54rpx;
  text-align: center;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
}

.route-action-accent {
  color: var(--color-primary);
  background: rgba(20, 134, 111, 0.12);
}

.route-action-note {
  color: var(--color-accent);
  background: rgba(79, 132, 244, 0.12);
}

.route-action-danger {
  color: var(--color-danger);
  background: rgba(207, 74, 64, 0.12);
}

.route-copy {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-xs);
  line-height: 1.65;
  color: var(--color-text-secondary);
}

.route-address {
  color: var(--color-text-hint);
}

.route-copy-amber {
  color: #a1600d;
}

.route-copy-primary {
  color: var(--color-primary);
}

.route-transport {
  margin-top: 12rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 12rpx;
  border-radius: 14rpx;
  background: rgba(20, 134, 111, 0.1);
}

.route-transport-icon {
  width: 18rpx;
  height: 18rpx;
  border-top: 3rpx solid var(--color-primary);
  border-right: 3rpx solid var(--color-primary);
  transform: rotate(45deg);
}

.route-transport-text {
  font-size: var(--font-xs);
  color: var(--color-primary);
  font-weight: 700;
}

.route-note {
  margin-top: 12rpx;
  padding: 14rpx;
  border-radius: 18rpx;
  background: rgba(24, 37, 33, 0.04);
}

.route-note-label {
  display: block;
  font-size: var(--font-mini);
  font-weight: 700;
  color: var(--color-text-secondary);
}

.route-note-text {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-xs);
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.reference-links,
.day-reference {
  margin-top: 14rpx;
}

.reference-link-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.reference-link-list.compact {
  margin-top: 10rpx;
}

.reference-link {
  min-height: 40rpx;
  padding: 0 14rpx;
  display: inline-flex;
  align-items: center;
  border-radius: 999rpx;
  background: rgba(20, 134, 111, 0.1);
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 700;
}

.option-section {
  padding: 20rpx 0 8rpx;
  border-top: 1rpx solid var(--color-border);
}

.option-section-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: var(--color-text-secondary);
}

.option-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12rpx;
}

.option-card {
  padding: 18rpx;
  border-radius: 20rpx;
  background: rgba(24, 37, 33, 0.03);
  border: 1rpx solid rgba(24, 37, 33, 0.05);
}

.option-name {
  display: block;
  font-size: var(--font-sm);
  line-height: 1.45;
  font-weight: 800;
  color: var(--color-text-strong);
}

.option-meta,
.option-copy {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-xs);
  line-height: 1.55;
  color: var(--color-text-secondary);
}

.option-meta {
  color: var(--color-text-hint);
}

.empty-day {
  padding: 28rpx 0 20rpx;
  text-align: center;
}

.empty-day-text {
  font-size: var(--font-sm);
  color: var(--color-text-hint);
}
