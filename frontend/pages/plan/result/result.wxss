/* pages/plan/result/result.wxss */
.container {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding: var(--space-base);
  padding-bottom: var(--space-xl);
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-icon {
  font-size: 96rpx;
  margin-bottom: var(--space-lg);
  animation: float 2s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

.loading-text {
  font-size: var(--font-lg);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-base);
}

.loading-dots {
  display: flex;
  gap: var(--space-xs);
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--color-primary);
  animation: pulse 1.2s ease-in-out infinite;
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes pulse {
  0%, 100% { opacity: 0.3; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1); }
}

/* 错误状态 */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.error-icon {
  font-size: 96rpx;
  margin-bottom: var(--space-lg);
}

.error-text {
  font-size: var(--font-base);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-lg);
}

/* 行程头部 */
.trip-header {
  margin-bottom: var(--space-base);
}

.trip-title {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: var(--space-sm);
}

.trip-meta {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin-bottom: var(--space-sm);
}

.meta-item {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.trip-dests {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-xs);
}

.dest-tag {
  background: var(--color-primary-light);
  color: var(--color-primary);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-xs);
}

/* 操作栏 */
.action-bar {
  display: flex;
  justify-content: center;
  gap: var(--space-xl);
  margin-bottom: var(--space-base);
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-xs);
  font-size: 36rpx;
}

.action-label {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

.share-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-xs);
  background: none;
  border: none;
  padding: 0;
  font-size: 36rpx;
  line-height: 1;
}

.share-btn::after {
  border: none;
}

/* 每日行程 */
.days {
  display: flex;
  flex-direction: column;
  gap: var(--space-base);
}

.day-section {
  padding: 0;
  overflow: hidden;
}

.day-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-base);
  background: var(--color-surface);
  cursor: pointer;
}

.day-info {
  display: flex;
  align-items: baseline;
  gap: var(--space-sm);
}

.day-num {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-primary);
}

.day-date {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.day-arrow {
  font-size: 36rpx;
  color: var(--color-text-hint);
  transition: transform 0.2s ease;
}

.day-arrow.expanded {
  transform: rotate(90deg);
}

/* 单项 */
.day-content {
  padding: 0 var(--space-base) var(--space-base);
  background: var(--color-surface);
}

.trip-item {
  padding: var(--space-base) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.trip-item:last-child {
  border-bottom: none;
}

.item-spot,
.item-food,
.item-hotel {
  display: flex;
  gap: var(--space-sm);
}

.item-icon {
  font-size: 32rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.item-body {
  flex: 1;
}

.item-name {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 4rpx;
}

.item-meta {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  margin-bottom: 4rpx;
}

.item-desc {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  margin-top: 4rpx;
  line-height: 1.5;
}

.item-transport {
  font-size: var(--font-xs);
  color: var(--color-primary);
  margin-top: 4rpx;
}

.item-rec {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.item-reason {
  font-size: var(--font-xs);
  color: var(--color-secondary);
  margin-top: 4rpx;
}

.item-budget {
  font-size: var(--font-sm);
  color: var(--color-secondary);
  margin-top: 4rpx;
  font-weight: 600;
}

.item-note {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  background: var(--color-bg);
  padding: 4rpx 8rpx;
  border-radius: var(--radius-sm);
  margin-top: 4rpx;
  display: inline-block;
}

.item-actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  flex-shrink: 0;
}

.item-action {
  font-size: var(--font-xs);
  color: var(--color-primary);
  white-space: nowrap;
}

.item-action.danger {
  color: var(--color-danger);
}
