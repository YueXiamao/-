/* pages/plan/result/result.wxss */

/* ── Page ── */
.container {
  min-height: 100vh;
  background-color: var(--color-bg);
  background-repeat: no-repeat;
  background-position: top center;
  background-size: 100% auto;
  padding: 24rpx 28rpx 120rpx;
}

/* ── Card base ── */
.trip-card {
  background: var(--color-surface);
  border-radius: var(--r-xl);
  overflow: hidden;
  border: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-card);
}

/* ── Result wrapper ── */
.trip-result {
  width: 100%;
}

/* ── Loading ── */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
  gap: 20rpx;
}

.loading-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--r-xl);
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 800;
  color: var(--color-primary);
  letter-spacing: 2rpx;
  box-shadow: var(--shadow-md);
}

.loading-text {
  font-size: var(--font-base);
  color: var(--color-text-secondary);
  font-weight: 500;
}

.loading-dots {
  display: flex;
  gap: 8rpx;
  margin-top: 4rpx;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-primary);
  animation: pulse 1.2s ease-in-out infinite;
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes pulse {
  0%, 100% { opacity: 0.3; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1); }
}

/* ── Error ── */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
  gap: 16rpx;
}

.error-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: var(--r-xl);
  background: var(--color-danger-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 800;
  color: var(--color-danger);
  letter-spacing: 2rpx;
}

.error-text {
  font-size: var(--font-base);
  color: var(--color-text-secondary);
  text-align: center;
  max-width: 480rpx;
}

/* ── Trip Header ── */
.trip-header {
  padding: 32rpx 32rpx 28rpx;
  margin-bottom: 20rpx;
  position: relative;
  overflow: hidden;
}

.trip-header::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, var(--color-primary), var(--color-secondary));
}

.trip-title {
  font-size: var(--font-xl);
  font-weight: 800;
  color: var(--color-text);
  margin-bottom: 16rpx;
  letter-spacing: var(--tracking-tight);
  line-height: 1.2;
}

.trip-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.meta-item {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  background: var(--color-bg);
  padding: 5rpx 14rpx;
  border-radius: var(--r-full);
  font-weight: 500;
}

.trip-dests {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.dest-tag {
  background: var(--color-primary-light);
  color: var(--color-primary);
  padding: 5rpx 14rpx;
  border-radius: var(--r-full);
  font-size: var(--font-xs);
  font-weight: 600;
}

/* ── Generation Banner ── */
.generation-banner {
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--r-lg);
  background: linear-gradient(135deg, rgba(13, 156, 110, 0.06), rgba(13, 156, 110, 0.03));
  border: 1rpx solid rgba(13, 156, 110, 0.12);
}

.generation-banner__label {
  display: block;
  font-size: var(--font-xs);
  color: var(--color-primary);
  font-weight: 700;
  margin-bottom: 6rpx;
  letter-spacing: 0.5rpx;
}

.generation-banner__text {
  display: block;
  font-size: var(--font-sm);
  line-height: 1.6;
  color: var(--color-text-secondary);
}

/* ── Action Bar ── */
.action-bar {
  display: flex;
  justify-content: center;
  gap: 64rpx;
  margin-bottom: 20rpx;
  padding: 22rpx 28rpx;
  background: var(--color-surface);
  border-radius: var(--r-xl);
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--color-border);
}

.action-btn,
.share-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  background: none;
  border: none;
  padding: 0;
}

.action-mark {
  font-size: var(--font-kicker);
  font-weight: 800;
  color: var(--color-text);
  letter-spacing: 1.5rpx;
}

.action-label {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  font-weight: 500;
}

/* ── Days ── */
.days {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.day-section {
  border-radius: var(--r-xl);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--color-border);
}

/* ── Day Header ── */
.day-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 28rpx;
  background: var(--color-surface);
  transition: background 0.15s;
}

.day-header:active {
  background: var(--color-bg);
}

.day-info {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.day-num {
  font-size: var(--font-lg);
  font-weight: 800;
  color: var(--color-primary);
  letter-spacing: -0.3rpx;
}

.day-date {
  font-size: var(--font-sm);
  color: var(--color-text-hint);
}

.day-arrow {
  font-size: 40rpx;
  color: var(--color-text-hint);
  font-weight: 300;
  transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1),
              color 0.2s ease;
  line-height: 1;
}

.day-arrow.expanded {
  transform: rotate(90deg);
  color: var(--color-primary);
}

/* ── Day Content ── */
.day-content {
  padding: 0 28rpx 24rpx;
  background: var(--color-surface);
  border-top: 1rpx solid var(--color-border);
}

.items-list {
  display: flex;
  flex-direction: column;
}

/* ── Trip Item ── */
.trip-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--color-border);
  transition: opacity 0.15s ease;
}

.trip-item:last-child {
  border-bottom: none;
}

.trip-item.dragging {
  opacity: 0.5;
}

.trip-item.drag-over {
  border-top: 3rpx solid var(--color-primary);
  padding-top: 4rpx;
}

/* ── Item Row ── */
.item-row {
  display: flex;
  gap: 16rpx;
}

.item-drag-handle {
  width: 36rpx;
  font-size: 22rpx;
  color: var(--color-border-strong);
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 4rpx;
  flex-shrink: 0;
  letter-spacing: 3rpx;
}

/* ── Item Icon (spot / food / hotel) ── */
.item-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--r-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 800;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.item-spot .item-icon {
  background: linear-gradient(135deg, #D1FAE5, #A7F3D0);
  color: #059669;
  box-shadow: 0 4rpx 14rpx rgba(5, 150, 105, 0.2);
}

.item-food .item-icon {
  background: linear-gradient(135deg, #FEF3C7, #FDE68A);
  color: #D97706;
  box-shadow: 0 4rpx 14rpx rgba(217, 119, 6, 0.2);
}

.item-hotel .item-icon {
  background: linear-gradient(135deg, #EDE9FE, #DDD6FE);
  color: #7C5CFC;
  box-shadow: 0 4rpx 14rpx rgba(124, 92, 252, 0.2);
}

/* ── Item Body ── */
.item-body {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: var(--font-base);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 5rpx;
  line-height: 1.3;
}

.item-meta {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  margin-bottom: 3rpx;
  line-height: 1.5;
}

.item-desc {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  margin-top: 5rpx;
  line-height: 1.6;
}

.item-rec {
  font-size: var(--font-xs);
  color: #D97706;
  margin-top: 5rpx;
  font-weight: 600;
  line-height: 1.5;
}

.item-transport {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: var(--font-xs);
  color: var(--color-primary);
  margin-top: 8rpx;
  font-weight: 500;
  padding: 4rpx 10rpx;
  background: var(--color-primary-light);
  border-radius: 6rpx;
}

.item-reason {
  font-size: var(--font-xs);
  color: #7C5CFC;
  margin-top: 5rpx;
  line-height: 1.5;
  font-weight: 500;
}

.item-budget {
  font-size: var(--font-sm);
  color: var(--color-danger);
  margin-top: 6rpx;
  font-weight: 700;
}

.item-note {
  display: inline-block;
  font-size: 20rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg);
  padding: 5rpx 12rpx;
  border-radius: var(--r-xs);
  margin-top: 8rpx;
  border: 1rpx solid var(--color-border);
}

/* ── Item Actions ── */
.item-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  flex-shrink: 0;
  align-items: flex-end;
  padding-top: 2rpx;
}

.action-chip-group {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8rpx;
}

.item-action {
  min-width: 56rpx;
  padding: 8rpx 14rpx;
  border-radius: var(--r-full);
  background: var(--color-bg);
  color: var(--color-text-secondary);
  font-size: 20rpx;
  font-weight: 600;
  text-align: center;
  transition: background 0.12s, color 0.12s;
}

.item-action:active {
  background: var(--color-bg-alt, #E8EBE8);
}

.item-action.accent {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.item-action.danger {
  background: var(--color-danger-light);
  color: var(--color-danger);
}

/* ── Empty Day ── */
.empty-day {
  padding: 48rpx 0;
  text-align: center;
  font-size: var(--font-base);
  color: var(--color-text-hint);
}

/* ── Day Summary ── */
.day-summary {
  padding: 16rpx 0 10rpx;
  margin-bottom: 4rpx;
}

.day-summary-text {
  font-size: var(--font-sm);
  color: var(--color-primary);
  font-weight: 600;
}

/* ── Period Label ── */
.period-label {
  margin-bottom: 10rpx;
  margin-left: 66rpx;
}

.period-badge {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: var(--r-full);
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.period-badge-amber {
  background: var(--color-secondary-light);
  color: var(--color-secondary);
}

.period-badge-purple {
  background: var(--color-purple-light);
  color: var(--color-purple);
}

/* ── Item Meta Row (chips) ── */
.item-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.item-meta-chip {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg);
  padding: 3rpx 10rpx;
  border-radius: 6rpx;
  border: 1rpx solid var(--color-border);
}

.item-meta-amber {
  color: #D97706;
  background: rgba(232, 129, 10, 0.08);
  border-color: rgba(232, 129, 10, 0.15);
}

.item-meta-purple {
  color: var(--color-purple);
  background: var(--color-purple-light);
  border-color: rgba(124, 92, 252, 0.15);
}

/* ── Item Address ── */
.item-address {
  margin-bottom: 6rpx;
}

.item-address-text {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  line-height: 1.5;
}

/* ── Item Desc Block ── */
.item-desc-block {
  background: var(--color-bg);
  border-radius: var(--r-sm);
  padding: 10rpx 14rpx;
  margin-bottom: 8rpx;
  border-left: 3rpx solid var(--color-primary);
}

.item-desc-text {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.65;
}

/* ── Item Reason Block ── */
.item-reason-block {
  margin-bottom: 6rpx;
}

.item-reason-label {
  font-size: var(--font-xs);
  font-weight: 700;
  color: var(--color-primary);
  margin-right: 4rpx;
}

.item-reason-text {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* ── Item Tips Block ── */
.item-tips-block {
  margin-bottom: 6rpx;
}

.item-tips-label {
  font-size: var(--font-xs);
  font-weight: 700;
  color: #D97706;
  margin-right: 4rpx;
}

.item-tips-text {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* ── Item Recommend Block (food) ── */
.item-rec-block {
  margin-bottom: 6rpx;
}

.item-rec-label {
  font-size: var(--font-xs);
  font-weight: 700;
  color: #D97706;
  margin-right: 4rpx;
}

.item-rec-text {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* ── Transport Arrow ── */
.item-transport {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
  padding: 6rpx 12rpx;
  background: var(--color-primary-light);
  border-radius: var(--r-xs);
  margin-bottom: 6rpx;
}

.transport-arrow {
  font-size: var(--font-sm);
  color: var(--color-primary);
  font-weight: 800;
  flex-shrink: 0;
}

.transport-text {
  font-size: var(--font-xs);
  color: var(--color-primary);
  font-weight: 500;
  line-height: 1.5;
}

/* ── Secondary Button ── */
.btn-secondary {
  background: var(--color-surface);
  color: var(--color-text);
  border: 2rpx solid var(--color-border-strong);
  border-radius: var(--r-xl);
  height: 80rpx;
  line-height: 80rpx;
  font-size: var(--font-base);
  font-weight: 600;
  padding: 0 40rpx;
  margin-top: 8rpx;
}
