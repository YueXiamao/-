<view class="page page-bg trip-page"
  style="background-image: linear-gradient(180deg, rgba(255,249,241,0.5), rgba(245,241,232,0.97) 420rpx, #f5f1e8 100%), url('{{pageBackground}}');">

  <view wx:if="{{loading}}" class="state-block state-block-rich">
    <view class="state-mark loading">
      <view class="state-plan-icon"></view>
    </view>
    <text class="state-title">正在整理这次出发安排</text>
    <text class="state-text">{{generatingText}}</text>
    <view class="loading-dots">
      <view class="dot"></view>
      <view class="dot"></view>
      <view class="dot"></view>
    </view>
  </view>

  <view wx:elif="{{error}}" class="state-block state-block-rich">
    <view class="state-mark error">
      <view class="state-error-icon"></view>
    </view>
    <text class="state-title">这次行程还没顺利生成</text>
    <text class="state-text">{{error}}</text>
    <view class="state-action">
      <button class="btn btn-secondary" bindtap="onRetry">重新生成</button>
    </view>
  </view>

  <view wx:else class="trip-result">
    <view class="page-hero trip-hero">
      <view class="trip-cover surface-card">
        <view class="trip-cover-image" style="background-image: url('{{pageBackground}}');"></view>
        <view class="trip-cover-body">
          <text class="page-kicker">行程草案</text>
          <text class="trip-summary-title">{{trip.title || '这次旅行安排'}}</text>
          <view class="trip-top-meta">
            <view class="trip-top-meta-item">
              <text class="trip-top-meta-label">出发</text>
              <text class="trip-top-meta-value">{{trip.start_date}}</text>
            </view>
            <view class="trip-top-meta-item">
              <text class="trip-top-meta-label">时长</text>
              <text class="trip-top-meta-value">{{trip.days}} 天</text>
            </view>
            <view class="trip-top-meta-item">
              <text class="trip-top-meta-label">站点</text>
              <text class="trip-top-meta-value">{{trip.itinerary.length}} 日</text>
            </view>
          </view>
          <view class="trip-destinations">
            <text class="trip-destination" wx:for="{{trip.destinations}}" wx:key="name">{{item.name}}</text>
          </view>
          <view class="trip-meta-chips" wx:if="{{trip.preferences && trip.preferences.length > 0}}">
            <view class="meta-chip" wx:for="{{trip.preferences}}" wx:key="i">
              <text class="meta-chip-value">{{item}}</text>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{bannerText}}" class="generation-banner surface-card">
        <text class="generation-banner-label">{{bannerLabel}}</text>
        <text class="generation-banner-text">{{bannerText}}</text>
      </view>

      <view class="action-strip surface-card">
        <view class="action-strip-item" bindtap="onSave">
          <view class="action-strip-icon action-save-icon"></view>
          <text class="action-strip-label">保存</text>
        </view>
        <view class="action-strip-item" bindtap="onCopy">
          <view class="action-strip-icon action-copy-icon"></view>
          <text class="action-strip-label">复制</text>
        </view>
        <view class="action-strip-item" bindtap="onFeedback">
          <view class="action-strip-icon action-feedback-icon"></view>
          <text class="action-strip-label">反馈</text>
        </view>
        <button class="action-strip-item action-strip-button" open-type="share">
          <view class="action-strip-icon action-share-icon"></view>
          <text class="action-strip-label">分享</text>
        </button>
      </view>
    </view>

    <view class="days">
      <view wx:for="{{trip.itinerary}}" wx:for-index="dayIndex" wx:key="day" class="day-card surface-card">
        <view bindtap="onDayTap" data-index="{{dayIndex}}" class="day-card-head">
          <view class="day-card-main">
            <view class="day-card-title-row">
              <text class="day-card-title">第 {{item.day || item.day_number}} 天</text>
              <text class="day-card-count">{{item.items ? item.items.length : 0}} 个安排</text>
            </view>
            <text class="day-card-date">{{item.date_display || item.date}}</text>
          </view>
          <view class="day-card-toggle {{currentDay === dayIndex ? 'expanded' : ''}}">
            <view class="day-card-toggle-icon"></view>
          </view>
        </view>

        <view wx:if="{{currentDay === dayIndex}}" class="day-card-body">
          <view wx:if="{{item.pace_label || item.commute_minutes}}" class="day-meta-strip">
            <view wx:if="{{item.pace_label}}" class="day-pace-badge day-pace-{{item.pace_label}}">
              <text class="day-pace-text">{{item.pace_label}}</text>
            </view>
            <view wx:if="{{item.commute_minutes}}" class="day-commute">
              <text class="day-commute-text">通勤约 {{item.commute_minutes}} 分钟</text>
            </view>
            <view wx:if="{{item.data_freshness}}" class="day-freshness">
              <text class="day-freshness-text">{{item.data_freshness}}</text>
            </view>
          </view>

          <view wx:if="{{item.summary}}" class="day-overview">
            <text class="day-overview-copy">{{item.summary}}</text>
          </view>

          <view wx:if="{{item.items && item.items.length > 0}}" class="route-list">
            <block wx:for="{{item.items}}" wx:for-item="tripItem" wx:for-index="itemIndex" wx:key="itemKey">
              <view class="route-row">
                <view class="route-rail">
                  <view wx:if="{{tripItem.period_label}}" class="route-period-badge route-period-{{tripItem.type}}">
                    {{tripItem.period_label}}
                  </view>
                  <view class="route-type route-type-{{tripItem.type}}">
                    {{tripItem.type === 'spot' ? '景点' : tripItem.type === 'food' ? '餐饮' : '住宿'}}
                  </view>
                </view>

                <view class="route-panel">
                  <view class="route-head">
                    <text class="route-name">{{tripItem.name}}</text>
                    <view class="route-quick-actions">
                      <picker
                        class="route-action route-action-accent"
                        mode="selector"
                        range="{{replaceIntents}}"
                        range-key="label"
                        bindchange="onIntentReplace"
                        data-day-index="{{dayIndex}}"
                        data-item-index="{{itemIndex}}">
                        <text>换</text>
                      </picker>
                      <text catchtap="onAddNote" data-day-index="{{dayIndex}}" data-item-index="{{itemIndex}}" class="route-action route-action-note">备注</text>
                      <text catchtap="onItemDelete" data-day-index="{{dayIndex}}" data-item-index="{{itemIndex}}" class="route-action route-action-danger">删</text>
                    </view>
                  </view>

                  <view class="meta-grid" wx:if="{{tripItem.best_time || tripItem.duration || tripItem.ticket_info || tripItem.budget || tripItem.cuisine_type || tripItem.highlights}}">
                    <view wx:if="{{tripItem.best_time}}" class="meta-chip">
                      <text class="meta-chip-label">时间</text>
                      <text class="meta-chip-value">{{tripItem.best_time}}</text>
                    </view>
                    <view wx:if="{{tripItem.duration}}" class="meta-chip">
                      <text class="meta-chip-label">时长</text>
                      <text class="meta-chip-value">{{tripItem.duration}}</text>
                    </view>
                    <view wx:if="{{tripItem.ticket_info}}" class="meta-chip">
                      <text class="meta-chip-label">门票</text>
                      <text class="meta-chip-value">{{tripItem.ticket_info}}</text>
                    </view>
                    <view wx:if="{{tripItem.budget}}" class="meta-chip">
                      <text class="meta-chip-label">预算</text>
                      <text class="meta-chip-value">{{tripItem.budget}}</text>
                    </view>
                    <view wx:if="{{tripItem.cuisine_type}}" class="meta-chip">
                      <text class="meta-chip-value">{{tripItem.cuisine_type}}</text>
                    </view>
                    <view wx:if="{{tripItem.highlights}}" class="meta-chip">
                      <text class="meta-chip-value">{{tripItem.highlights}}</text>
                    </view>
                  </view>

                  <text wx:if="{{tripItem.address}}" class="route-copy route-address">{{tripItem.address}}</text>
                  <text wx:if="{{tripItem.description}}" class="route-copy">{{tripItem.description}}</text>
                  <text wx:if="{{tripItem.recommend}}" class="route-copy route-copy-amber">推荐：{{tripItem.recommend}}</text>
                  <text wx:if="{{tripItem.reason}}" class="route-copy route-copy-primary">理由：{{tripItem.reason}}</text>
                  <text wx:if="{{tripItem.tips}}" class="route-copy">提示：{{tripItem.tips}}</text>
                  <text wx:if="{{tripItem.reservation_tips}}" class="route-copy">预约：{{tripItem.reservation_tips}}</text>
                  <text wx:if="{{tripItem.check_in_tips}}" class="route-copy">入住：{{tripItem.check_in_tips}}</text>

                  <view wx:if="{{tripItem.transport_to_next}}" class="route-transport">
                    <view class="route-transport-icon"></view>
                    <text class="route-transport-text">{{tripItem.transport_to_next}}</text>
                  </view>

                  <view wx:if="{{tripItem.notes}}" class="route-note">
                    <text class="route-note-label">备注</text>
                    <text class="route-note-text">{{tripItem.notes}}</text>
                  </view>

                  <view wx:if="{{tripItem.reference_links && tripItem.reference_links.length > 0}}" class="reference-links">
                    <view class="reference-link-list">
                      <text
                        class="reference-link"
                        wx:for="{{tripItem.reference_links}}"
                        wx:for-item="link"
                        wx:key="url"
                        catchtap="onReferenceLinkTap"
                        data-url="{{link.url}}"
                      >{{link.label}}</text>
                    </view>
                  </view>
                </view>
              </view>
            </block>
          </view>

          <view wx:if="{{item.alternative_spots && item.alternative_spots.length > 0}}" class="option-section">
            <text class="option-section-title">可替换景点</text>
            <view class="option-grid">
              <view class="option-card" wx:for="{{item.alternative_spots}}" wx:for-item="option" wx:key="name">
                <text class="option-name">{{option.name}}</text>
                <text wx:if="{{option.address}}" class="option-meta">{{option.address}}</text>
                <text wx:if="{{option.reason}}" class="option-copy">{{option.reason}}</text>
                <view wx:if="{{option.reference_links && option.reference_links.length > 0}}" class="reference-link-list compact">
                  <text
                    class="reference-link"
                    wx:for="{{option.reference_links}}"
                    wx:for-item="link"
                    wx:key="url"
                    catchtap="onReferenceLinkTap"
                    data-url="{{link.url}}"
                  >{{link.label}}</text>
                </view>
              </view>
            </view>
          </view>

          <view wx:if="{{item.alternative_foods && item.alternative_foods.length > 0}}" class="option-section">
            <text class="option-section-title">可替换餐饮</text>
            <view class="option-grid">
              <view class="option-card" wx:for="{{item.alternative_foods}}" wx:for-item="option" wx:key="name">
                <text class="option-name">{{option.name}}</text>
                <text wx:if="{{option.address || option.budget}}" class="option-meta">{{option.address}}{{option.budget ? ' · ' + option.budget : ''}}</text>
                <text wx:if="{{option.reason}}" class="option-copy">{{option.reason}}</text>
                <view wx:if="{{option.reference_links && option.reference_links.length > 0}}" class="reference-link-list compact">
                  <text
                    class="reference-link"
                    wx:for="{{option.reference_links}}"
                    wx:for-item="link"
                    wx:key="url"
                    catchtap="onReferenceLinkTap"
                    data-url="{{link.url}}"
                  >{{link.label}}</text>
                </view>
              </view>
            </view>
          </view>

          <view wx:if="{{item.reference_links && item.reference_links.length > 0}}" class="day-reference">
            <view class="reference-link-list">
              <text
                class="reference-link"
                wx:for="{{item.reference_links}}"
                wx:for-item="link"
                wx:key="url"
                catchtap="onReferenceLinkTap"
                data-url="{{link.url}}"
              >{{link.label}}</text>
            </view>
          </view>

          <view wx:if="{{!item.items || item.items.length === 0}}" class="empty-day">
            <text class="empty-day-text">这一天还没有排入具体项目</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
