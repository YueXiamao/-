<!-- pages/plan/params/params.wxml -->
<view class="container">

  <!-- 目的地摘要 -->
  <view class="dest-summary">
    <view class="summary-row">
      <text class="summary-label">目的地</text>
      <view class="dest-tags">
        <text class="dest-tag" wx:for="{{destinations}}" wx:key="name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 出发日期 -->
  <view class="form-card">
    <view class="form-label">出发日期</view>
    <picker mode="date" value="{{startDate}}" start="{{today}}" bindchange="onDateChange">
      <view class="picker-row">
        <text class="picker-value {{startDate ? 'has-value' : ''}}">{{startDate || '请选择出发日期'}}</text>
        <text class="picker-arrow">›</text>
      </view>
    </picker>
  </view>

  <!-- 游玩天数 -->
  <view class="form-card">
    <view class="form-label">游玩天数</view>
    <view class="days-row">
      <view class="days-btn" bindtap="onDaysChange" data-delta="-1">−</view>
      <view class="days-center">
        <text class="days-num">{{days}}</text>
        <text class="days-unit">天</text>
      </view>
      <view class="days-btn" bindtap="onDaysChange" data-delta="1">+</view>
    </view>
  </view>

  <!-- 游玩方式 -->
  <view class="form-card">
    <view class="form-label-row">
      <text class="form-label">游玩方式</text>
      <text class="form-hint">可选1-3个</text>
    </view>
    <view class="pref-grid">
      <view
        class="pref-item {{preferences.includes(item.value) ? 'active' : ''}}"
        wx:for="{{preferenceOptions}}"
        wx:key="value"
        bindtap="onPreferenceTap"
        data-value="{{item.value}}"
      >
        <!-- 选中角标 -->
        <view class="pref-check" wx:if="{{preferences.includes(item.value)}}">√</view>
        <!-- 图标区 -->
        <view class="pref-icon-wrap">
          <text class="pref-icon">{{item.icon}}</text>
        </view>
        <!-- 文字 -->
        <text class="pref-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 补充说明 -->
  <view class="form-card">
    <view class="form-label">补充说明 <text class="form-hint-inline">（选填）</text></view>
    <textarea
      class="notes-input"
      placeholder="如：想看日出、不吃辣、带老人、想泡温泉..."
      value="{{extraNotes}}"
      bindinput="onNotesInput"
      maxlength="200"
    />
    <view class="notes-count">{{extraNotes.length || 0}}/200</view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-bar">
    <button
      class="btn-primary {{loading ? 'btn-loading' : ''}}"
      bindtap="onGenerate"
      disabled="{{loading}}"
    >
      <text wx:if="{{!loading}}">生成行程</text>
      <text wx:if="{{loading}}">生成中...</text>
    </button>
  </view>

</view>
