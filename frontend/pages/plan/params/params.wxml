<!-- pages/plan/params/params.wxml -->
<view class="container">

  <!-- 目的地摘要 -->
  <view class="dest-summary">
    <text class="dest-summary-label">目的地</text>
    <view class="dest-tags">
      <text class="dest-tag" wx:for="{{destinations}}" wx:key="name">{{item.name}}</text>
    </view>
  </view>

  <!-- 出发日期 -->
  <view class="form-card">
    <text class="form-label">出发日期</text>
    <picker mode="date" value="{{startDate}}" start="{{today}}" bindchange="onDateChange">
      <view class="picker-row">
        <text class="picker-value {{startDate ? 'has-value' : ''}}">{{startDate || '请选择出发日期'}}</text>
        <text class="picker-arrow">›</text>
      </view>
    </picker>
  </view>

  <!-- 游玩天数 -->
  <view class="form-card">
    <text class="form-label">游玩天数</text>
    <view class="days-row">
      <view class="days-btn" bindtap="onDaysChange" data-delta="-1">−</view>
      <view class="days-center">
        <text class="days-num">{{days}}</text>
        <text class="days-unit">天</text>
      </view>
      <view class="days-btn" bindtap="onDaysChange" data-delta="1">+</view>
    </view>
  </view>

  <!-- 游玩方式（横向滚动卡片式） -->
  <view class="form-card">
    <text class="form-label">游玩方式 <text class="form-label-hint">（选1-3个）</text></text>

    <!-- 横向滚动区域 -->
    <scroll-view class="pref-scroll" scroll-x="{{true}}">
      <view class="pref-track">
        <view
          class="pref-card {{preferences.indexOf(item.value) >= 0 ? 'pref-card-on' : ''}}"
          wx:for="{{preferenceOptions}}"
          wx:key="value"
          bindtap="onPreferenceTap"
          data-value="{{item.value}}"
        >
          <!-- 左侧选中条 -->
          <view class="pref-side {{preferences.indexOf(item.value) >= 0 ? 'pref-side-on' : ''}}"></view>
          <!-- 内容 -->
          <view class="pref-body">
            <text class="pref-icon">{{item.icon}}</text>
            <text class="pref-name">{{item.label}}</text>
            <!-- 选中标记 -->
            <view class="pref-mark" wx:if="{{preferences.indexOf(item.value) >= 0}}">
              <text class="pref-mark-text">V</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 已选展示行 -->
    <view class="selected-row" wx:if="{{preferences.length > 0}}">
      <text class="selected-label">已选：</text>
      <text class="selected-items">{{preferences.join(' + ')}}</text>
    </view>
  </view>

  <!-- 补充说明 -->
  <view class="form-card">
    <text class="form-label">补充说明 <text class="form-label-hint">（选填）</text></text>
    <textarea
      class="notes-input"
      placeholder="如：想看日出、不吃辣、带老人、想泡温泉..."
      value="{{extraNotes}}"
      bindinput="onNotesInput"
      maxlength="200"
    />
    <text class="notes-count">{{extraNotes.length || 0}}/200</text>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-bar">
    <button class="btn-primary" bindtap="onGenerate">
      <text>生成行程</text>
    </button>
  </view>

</view>
