/* pages/plan/params/params.wxss */

/* ── Page ── */
.container {
  min-height: 100vh;
  background-color: var(--color-bg);
  background-repeat: no-repeat;
  background-position: top center;
  background-size: 100% auto;
  padding: 0 0 160rpx 0;
}

/* ── Hero ── */
.hero-wrap {
  padding: 56rpx 36rpx 40rpx;
  background: linear-gradient(160deg, #E8F5EE 0%, #EDF5F0 60%, var(--color-bg) 100%);
  position: relative;
  overflow: hidden;
}

.hero-wrap::before {
  content: '';
  position: absolute;
  top: -50rpx;
  right: -50rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(13, 156, 110, 0.1) 0%, transparent 70%);
  pointer-events: none;
}

.hero-kicker {
  display: block;
  font-size: var(--font-kicker);
  font-weight: 700;
  color: var(--color-primary);
  letter-spacing: 3rpx;
  margin-bottom: 10rpx;
  text-transform: uppercase;
}

.hero-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: var(--color-text);
  line-height: 1.1;
  letter-spacing: var(--tracking-tight);
  margin-bottom: 12rpx;
}

.hero-subtitle {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.hero-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.hero-badge {
  padding: 7rpx 16rpx;
  border-radius: var(--r-full);
  background: var(--color-surface);
  color: var(--color-text-secondary);
  font-size: var(--font-xs);
  border: 1rpx solid var(--color-border);
}

/* ── Content ── */
.content-wrap {
  padding: 0 32rpx;
  margin-top: -16rpx;
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* ── Dest Summary ── */
.dest-summary {
  padding: 28rpx;
  border-radius: var(--r-xl);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.summary-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.dest-summary-label {
  font-size: var(--font-lg);
  font-weight: 800;
  color: var(--color-text);
}

.dest-summary-hint {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
}

.dest-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.dest-tag {
  background: var(--color-primary-light);
  color: var(--color-primary);
  padding: 7rpx 16rpx;
  border-radius: var(--r-full);
  font-size: var(--font-sm);
  font-weight: 600;
  border: 1rpx solid rgba(13, 156, 110, 0.12);
}

/* ── Quick Grid ── */
.quick-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 0;
}

.quick-card {
  flex: 1;
}

/* ── Form Card ── */
.form-card {
  background: var(--color-surface);
  border-radius: var(--r-xl);
  padding: 30rpx 28rpx;
  box-shadow: var(--shadow-card);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.form-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.form-label {
  font-size: var(--font-base);
  font-weight: 700;
  color: var(--color-text);
  display: block;
  margin-bottom: 0;
}

.form-label-alone {
  font-size: var(--font-base);
  font-weight: 700;
  color: var(--color-text);
  display: block;
  margin-bottom: 20rpx;
}

.form-label-hint {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  font-weight: 400;
}

.section-desc {
  display: block;
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  line-height: 1.55;
  margin-bottom: 20rpx;
}

.form-helper {
  display: block;
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  line-height: 1.55;
  margin-top: 12rpx;
}

/* ── Picker Row ── */
.picker-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.picker-value {
  font-size: var(--font-lg);
  color: var(--color-text-hint);
  font-weight: 500;
}

.picker-value.has-value {
  color: var(--color-text);
  font-weight: 600;
}

.picker-arrow {
  font-size: 36rpx;
  color: var(--color-text-hint);
  font-weight: 300;
}

/* ── Days ── */
.days-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 52rpx;
  padding: 8rpx 0;
}

.days-btn {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: var(--color-bg);
  text-align: center;
  line-height: 80rpx;
  font-size: 44rpx;
  color: var(--color-text-secondary);
  font-weight: 300;
  border: 2rpx solid var(--color-border-strong);
  transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
}

.days-btn:active {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #fff;
  transform: scale(0.9);
  box-shadow: 0 6rpx 20rpx rgba(13, 156, 110, 0.28);
}

.days-center {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  min-width: 140rpx;
  justify-content: center;
}

.days-num {
  font-size: 72rpx;
  font-weight: 800;
  color: var(--color-primary);
  line-height: 1;
  letter-spacing: -3rpx;
}

.days-unit {
  font-size: var(--font-base);
  color: var(--color-text-secondary);
}

/* ── Preferences ── */
.preference-card {
  padding-bottom: 8rpx;
}

.pref-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.pref-item {
  position: relative;
  width: calc((100% - 32rpx) / 3);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx 6rpx 16rpx;
  border-radius: var(--r-md);
  background: var(--color-bg);
  border: 2rpx solid transparent;
  transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
}

.pref-item:active {
  transform: scale(0.94);
}

.pref-on {
  background: var(--color-primary-light);
  border-color: var(--color-primary);
}

.pref-icon-wrap {
  width: 112rpx;
  height: 112rpx;
  border-radius: var(--r-md);
  background: var(--color-surface);
  box-shadow: var(--shadow-xs);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.pref-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: var(--r-sm);
}

.pref-name {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  font-weight: 600;
  text-align: center;
  line-height: 1.3;
}

.pref-on .pref-name {
  color: var(--color-primary);
  font-weight: 700;
}

.pref-check {
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(13, 156, 110, 0.3);
}

/* ── Notes ── */
.notes-input {
  width: 100%;
  min-height: 180rpx;
  background: var(--color-bg);
  border-radius: var(--r-md);
  padding: 20rpx;
  font-size: var(--font-base);
  color: var(--color-text);
  line-height: 1.7;
  border: 1.5rpx solid var(--color-border);
  box-sizing: border-box;
  display: block;
  transition: border-color 0.2s;
}

.notes-count {
  display: block;
  text-align: right;
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  margin-top: 10rpx;
}

/* ── Bottom Bar ── */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.97);
  border-top: 1rpx solid var(--color-border);
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.bottom-bar button {
  width: 100%;
  height: 100rpx;
  background: var(--color-primary);
  color: #fff;
  border-radius: var(--r-xl);
  font-size: var(--font-lg);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
  box-shadow: 0 8rpx 32rpx rgba(13, 156, 110, 0.28);
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.bottom-bar button:active {
  opacity: 0.88;
  transform: scale(0.98);
}
