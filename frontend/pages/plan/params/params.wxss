.params-page {
  padding-bottom: 156rpx;
}

.param-hero-card {
  margin-top: 22rpx;
  padding: 14rpx;
  overflow: hidden;
}

.param-hero-cover {
  height: 172rpx;
  border-radius: 28rpx;
  background-position: center;
  background-size: cover;
}

.param-hero-content {
  padding: 18rpx 10rpx 6rpx;
}

.params-content {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.dest-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.dest-tag {
  min-height: 44rpx;
  padding: 0 16rpx;
  display: inline-flex;
  align-items: center;
  border-radius: 999rpx;
  background: rgba(20, 134, 111, 0.1);
  color: var(--color-primary);
  font-size: var(--font-xs);
  font-weight: 700;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.form-card {
  background: var(--color-surface);
  border-radius: 30rpx;
  padding: 28rpx;
  border: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-card);
}

.form-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.form-label {
  display: block;
  font-size: var(--font-base);
  font-weight: 800;
  color: var(--color-text-strong);
}

.form-label-hint {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
}

.section-desc,
.form-helper {
  display: block;
  font-size: var(--font-xs);
  line-height: 1.55;
  color: var(--color-text-secondary);
}

.section-desc {
  margin-bottom: 18rpx;
}

.form-helper {
  margin-top: 12rpx;
  color: var(--color-text-hint);
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  padding: 0 4rpx;
}

.picker-value {
  font-size: 36rpx;
  color: var(--color-text-hint);
  font-weight: 700;
}

.picker-value.has-value {
  color: var(--color-text-strong);
}

.picker-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid var(--color-text-hint);
  border-right: 3rpx solid var(--color-text-hint);
  transform: rotate(45deg);
}

.days-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 36rpx;
  min-height: 92rpx;
}

.days-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(24, 37, 33, 0.05);
  border: 1.5rpx solid rgba(24, 37, 33, 0.09);
  display: flex;
  align-items: center;
  justify-content: center;
}

.days-btn:active {
  transform: scale(0.95);
}

.days-minus,
.days-plus {
  position: relative;
  width: 24rpx;
  height: 24rpx;
}

.days-minus::before,
.days-plus::before,
.days-plus::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 10rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: var(--color-text-strong);
}

.days-plus::after {
  left: 10rpx;
  right: auto;
  top: 0;
  width: 3rpx;
  height: 24rpx;
}

.days-center {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  min-width: 120rpx;
  justify-content: center;
}

.days-num {
  font-size: 72rpx;
  line-height: 1;
  font-weight: 800;
  color: var(--color-primary);
}

.days-unit {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.preference-card {
  padding-bottom: 22rpx;
}

.pref-name {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  font-weight: 700;
  text-align: center;
}

.pref-item.selected .pref-name {
  color: var(--color-primary);
}

.pref-check {
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.pref-check-mark {
  width: 16rpx;
  height: 10rpx;
  border-left: 3rpx solid #ffffff;
  border-bottom: 3rpx solid #ffffff;
  transform: rotate(-45deg);
  margin-top: -2rpx;
}

.notes-input {
  width: 100%;
  min-height: 200rpx;
  display: block;
  padding: 20rpx;
  border-radius: 22rpx;
  background: rgba(24, 37, 33, 0.04);
  border: 1.5rpx solid rgba(24, 37, 33, 0.08);
  font-size: var(--font-base);
  line-height: 1.7;
  color: var(--color-text-strong);
}

.notes-count {
  display: block;
  margin-top: 10rpx;
  text-align: right;
  font-size: var(--font-xs);
  color: var(--color-text-hint);
}
