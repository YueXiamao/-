/* pages/plan/params/params.wxss */

/* ===== 通用页面结构 ===== */
.container {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding: 24rpx;
  padding-bottom: 160rpx;
}

/* ===== 目的地摘要 ===== */
.dest-summary {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.summary-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.summary-label {
  font-size: 26rpx;
  color: #999999;
  flex-shrink: 0;
  padding-top: 6rpx;
}

.dest-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  flex: 1;
}

.dest-tag {
  background-color: #E8F8EE;
  color: #07C160;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 500;
}

/* ===== 表单卡片 ===== */
.form-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.form-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 20rpx;
}

.form-hint {
  font-size: 24rpx;
  color: #999999;
}

.form-hint-inline {
  font-size: 24rpx;
  color: #BBBBBB;
  font-weight: 400;
}

/* ===== 日期选择 ===== */
.picker-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.picker-value {
  font-size: 30rpx;
  color: #BBBBBB;
}

.picker-value.has-value {
  color: #1A1A1A;
  font-weight: 500;
}

.picker-arrow {
  font-size: 36rpx;
  color: #CCCCCC;
}

/* ===== 天数选择 ===== */
.days-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 60rpx;
}

.days-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #F0F0F0;
  text-align: center;
  line-height: 80rpx;
  font-size: 44rpx;
  color: #1A1A1A;
  font-weight: 300;
}

.days-btn:active {
  background-color: #E0E0E0;
}

.days-center {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  min-width: 120rpx;
  justify-content: center;
}

.days-num {
  font-size: 64rpx;
  font-weight: 700;
  color: #07C160;
  line-height: 1;
}

.days-unit {
  font-size: 28rpx;
  color: #666666;
}

/* ===== 游玩方式网格 ===== */
.pref-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

/* 每个选项：垂直排列图标+文字 */
.pref-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  width: 148rpx;
  padding: 24rpx 8rpx 20rpx;
  border-radius: 20rpx;
  background-color: #F7F7F7;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

/* 选中状态：浅绿底 + 绿边框 */
.pref-item.active {
  background-color: #E8F8EE;
  border-color: #07C160;
}

/* 角标对勾 */
.pref-check {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  background-color: #07C160;
  color: #FFFFFF;
  border-radius: 50%;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  font-weight: 700;
  box-shadow: 0 4rpx 8rpx rgba(7, 193, 96, 0.3);
}

/* 图标容器 */
.pref-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.pref-item.active .pref-icon-wrap {
  background-color: #FFFFFF;
}

.pref-icon {
  font-size: 40rpx;
  line-height: 1;
}

.pref-label {
  font-size: 26rpx;
  color: #1A1A1A;
  text-align: center;
  font-weight: 500;
}

.pref-item.active .pref-label {
  color: #07C160;
  font-weight: 600;
}

/* 点击时缩放反馈 */
.pref-item:active {
  transform: scale(0.95);
}

/* ===== 补充说明 ===== */
.notes-input {
  width: 100%;
  min-height: 160rpx;
  background-color: #F7F7F7;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  line-height: 1.7;
  border: none;
  box-sizing: border-box;
}

.notes-count {
  text-align: right;
  font-size: 22rpx;
  color: #CCCCCC;
  margin-top: 8rpx;
}

/* ===== 底部按钮 ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  border-top: 1rpx solid #F0F0F0;
}

.bottom-bar button {
  width: 100%;
  height: 96rpx;
  background-color: #07C160;
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.bottom-bar button::after {
  border: none;
}

.btn-loading {
  background-color: #A0D8B0 !important;
}
