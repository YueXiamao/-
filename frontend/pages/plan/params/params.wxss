/* pages/plan/params/params.wxss */

/* ── Page ── */
.container {
  min-height: 100vh;
  background-color: var(--color-bg);
  background-repeat: no-repeat;
  background-position: top center;
  background-size: 100% auto;
  padding: 32rpx 28rpx 160rpx;
}

/* ── Hero ── */
.page-hero {
  padding: 0 0 24rpx;
}

.hero-kicker {
  display: block;
  color: var(--color-primary);
  font-size: var(--font-kicker);
  font-weight: 700;
  letter-spacing: 3rpx;
  margin-bottom: 10rpx;
  text-transform: uppercase;
}

.hero-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: var(--color-text);
  line-height: 1.15;
  margin-bottom: 10rpx;
  letter-spacing: -0.5rpx;
}

.hero-subtitle {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.hero-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.hero-badge {
  padding: 8rpx 16rpx;
  border-radius: var(--r-full);
  background: var(--color-surface);
  color: var(--color-text-secondary);
  font-size: var(--font-xs);
  border: 1rpx solid var(--color-border);
}

/* ── Dest Summary ── */
.dest-summary {
  padding: 24rpx;
  margin-bottom: 18rpx;
  border-radius: var(--r-lg);
}

.summary-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.dest-summary-label {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-text);
}

.dest-summary-hint {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
}

.dest-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.dest-tag {
  background: var(--color-primary-light);
  color: var(--color-primary);
  padding: 6rpx 16rpx;
  border-radius: var(--r-full);
  font-size: var(--font-sm);
  font-weight: 600;
}

/* ── Quick Grid ── */
.quick-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.quick-card {
  flex: 1;
}

/* ── Form Card ── */
.dest-summary,
.form-card {
  background: var(--color-surface);
  box-shadow: var(--shadow-xs);
  border: 1rpx solid var(--color-border);
}

.form-card {
  border-radius: var(--r-lg);
  padding: 28rpx 26rpx;
  margin-bottom: 18rpx;
}

.form-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.form-label {
  font-size: var(--font-base);
  font-weight: 700;
  color: var(--color-text);
  display: block;
  margin-bottom: 20rpx;
}

.form-head .form-label {
  margin-bottom: 0;
}

.form-label-hint {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  font-weight: 400;
}

.form-helper,
.section-desc {
  display: block;
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  line-height: 1.55;
  margin-top: 12rpx;
}

.section-desc {
  margin-top: 0;
  margin-bottom: 20rpx;
}

/* ── Picker Row ── */
.picker-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6rpx 0;
}

.picker-value {
  font-size: var(--font-lg);
  color: var(--color-text-hint);
  font-weight: 500;
}

.picker-value.has-value {
  color: var(--color-text);
  font-weight: 600;
}

.picker-arrow {
  font-size: 36rpx;
  color: var(--color-text-hint);
  font-weight: 300;
}

/* ── Days ── */
.days-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  padding: 8rpx 0;
}

.days-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--color-bg);
  text-align: center;
  line-height: 76rpx;
  font-size: 44rpx;
  color: var(--color-text);
  font-weight: 300;
  border: 2rpx solid var(--color-border-strong);
  transition: background 0.15s ease, border-color 0.15s ease, transform 0.1s ease, color 0.15s;
}

.days-btn:active {
  background: var(--color-primary-light);
  border-color: var(--color-primary);
  color: var(--color-primary);
  transform: scale(0.93);
}

.days-center {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  min-width: 140rpx;
  justify-content: center;
}

.days-num {
  font-size: 68rpx;
  font-weight: 800;
  color: var(--color-primary);
  line-height: 1;
  letter-spacing: -2rpx;
}

.days-unit {
  font-size: var(--font-base);
  color: var(--color-text-secondary);
}

/* ── Preferences ── */
.preference-card {
  padding-bottom: 24rpx;
}

.pref-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.pref-item {
  position: relative;
  width: calc((100% - 32rpx) / 3);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 18rpx 6rpx 16rpx;
  border-radius: var(--r-base);
  background: var(--color-bg);
  border: 2rpx solid transparent;
  transition: background 0.15s ease, border-color 0.15s ease, transform 0.1s ease;
}

.pref-item:active {
  transform: scale(0.95);
}

.pref-on {
  background: var(--color-primary-light);
  border-color: var(--color-primary);
}

.pref-icon-wrap {
  width: 110rpx;
  height: 110rpx;
  border-radius: var(--r-base);
  background: var(--color-surface);
  box-shadow: var(--shadow-xs);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.pref-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 18rpx;
}

.pref-name {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  font-weight: 600;
  text-align: center;
  line-height: 1.3;
}

.pref-on .pref-name {
  color: var(--color-primary);
  font-weight: 700;
}

.pref-check {
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(22, 160, 109, 0.28);
}

.pref-check-icon {
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1;
}

/* ── Notes ── */
.notes-input {
  width: 100%;
  min-height: 180rpx;
  background: var(--color-bg);
  border-radius: var(--r-base);
  padding: 20rpx;
  font-size: var(--font-base);
  color: var(--color-text);
  line-height: 1.7;
  border: 1rpx solid var(--color-border);
  box-sizing: border-box;
  display: block;
}

.notes-count {
  display: block;
  text-align: right;
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  margin-top: 10rpx;
}

/* ── Bottom Bar ── */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.97);
  border-top: 1rpx solid var(--color-border);
  box-shadow: 0 -8rpx 24rpx rgba(35, 55, 45, 0.07);
  z-index: 100;
}

.bottom-bar button {
  width: 100%;
  height: 96rpx;
  background: var(--color-primary);
  color: #fff;
  border-radius: var(--r-xl);
  font-size: var(--font-lg);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
  box-shadow: 0 8rpx 24rpx rgba(22, 160, 109, 0.28);
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.bottom-bar button:active {
  opacity: 0.88;
  transform: scale(0.98);
}
