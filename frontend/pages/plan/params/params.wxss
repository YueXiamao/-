/* pages/plan/params/params.wxss */

/* ===== 页面结构 ===== */
.container {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding: 24rpx;
  padding-bottom: 160rpx;
}

/* ===== 目的地摘要 ===== */
.dest-summary {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.dest-summary-label {
  font-size: 24rpx;
  color: #999999;
  display: block;
  margin-bottom: 12rpx;
}

.dest-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.dest-tag {
  background-color: #E8F8EE;
  color: #07C160;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 500;
}

/* ===== 表单卡片 ===== */
.form-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.form-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
  margin-bottom: 20rpx;
}

.form-label-hint {
  font-size: 24rpx;
  color: #BBBBBB;
  font-weight: 400;
}

/* ===== 日期选择 ===== */
.picker-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-value {
  font-size: 30rpx;
  color: #BBBBBB;
}

.picker-value.has-value {
  color: #1A1A1A;
  font-weight: 500;
}

.picker-arrow {
  font-size: 36rpx;
  color: #CCCCCC;
}

/* ===== 天数选择 ===== */
.days-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 60rpx;
}

.days-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #F0F0F0;
  text-align: center;
  line-height: 80rpx;
  font-size: 44rpx;
  color: #1A1A1A;
  font-weight: 300;
}

.days-btn:active { background-color: #E0E0E0; }

.days-center {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  min-width: 120rpx;
  justify-content: center;
}

.days-num {
  font-size: 64rpx;
  font-weight: 700;
  color: #07C160;
  line-height: 1;
}

.days-unit {
  font-size: 28rpx;
  color: #666666;
}

/* ===== 游玩方式：横向滚动卡片 ===== */
.pref-scroll {
  width: 100%;
  white-space: nowrap;
}

.pref-track {
  display: inline-flex;
  gap: 16rpx;
  padding-bottom: 8rpx;
}

/* 每个选项卡片 */
.pref-card {
  position: relative;
  width: 180rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  background-color: #F7F7F7;
  overflow: hidden;
  display: flex;
  flex-direction: row;
  align-items: stretch;
  border: 2rpx solid transparent;
  transition: border-color 0.15s, background-color 0.15s;
}

/* 选中状态：白底浅绿 */
.pref-card-on {
  background-color: #F0FFF4;
  border-color: #07C160;
}

/* 左侧选中条 */
.pref-side {
  width: 6rpx;
  background-color: transparent;
  flex-shrink: 0;
  transition: background-color 0.15s;
}

.pref-side-on {
  background-color: #07C160;
}

/* 内容区 */
.pref-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 12rpx 18rpx;
  gap: 8rpx;
  position: relative;
}

.pref-icon {
  font-size: 36rpx;
  line-height: 1;
  color: #555555;
  font-weight: 700;
}

.pref-card-on .pref-icon {
  color: #07C160;
}

.pref-name {
  font-size: 26rpx;
  color: #1A1A1A;
  font-weight: 500;
  text-align: center;
}

.pref-card-on .pref-name {
  color: #07C160;
  font-weight: 700;
}

/* 右上角选中标记 */
.pref-mark {
  position: absolute;
  top: 0;
  right: 0;
  width: 36rpx;
  height: 36rpx;
  background-color: #07C160;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom-left-radius: 12rpx;
}

.pref-mark-text {
  font-size: 18rpx;
  color: #FFFFFF;
  font-weight: 700;
  line-height: 1;
}

/* 点击反馈 */
.pref-card:active {
  opacity: 0.85;
  transform: scale(0.97);
}

/* 已选文字行 */
.selected-row {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background-color: #F0FFF4;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.selected-label {
  font-size: 24rpx;
  color: #999999;
}

.selected-items {
  font-size: 24rpx;
  color: #07C160;
  font-weight: 600;
}

/* ===== 补充说明 ===== */
.notes-input {
  width: 100%;
  min-height: 160rpx;
  background-color: #F7F7F7;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  line-height: 1.7;
  border: none;
  box-sizing: border-box;
  display: block;
}

.notes-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #CCCCCC;
  margin-top: 8rpx;
}

/* ===== 底部按钮 ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  border-top: 1rpx solid #F0F0F0;
}

.bottom-bar button {
  width: 100%;
  height: 96rpx;
  background-color: #07C160;
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
}

.bottom-bar button::after { border: none; }
