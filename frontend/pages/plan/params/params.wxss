/* pages/plan/params/params.wxss */

.container {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding: 24rpx;
  padding-bottom: 160rpx;
}

/* ===== 目的地摘要 ===== */
.dest-summary {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.dest-summary-label {
  font-size: 24rpx;
  color: #999999;
  display: block;
  margin-bottom: 12rpx;
}

.dest-tags { display: flex; flex-wrap: wrap; gap: 10rpx; }

.dest-tag {
  background-color: #E8F8EE;
  color: #07C160;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 500;
}

/* ===== 表单卡片 ===== */
.form-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.form-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
  margin-bottom: 24rpx;
}

.form-label-hint {
  font-size: 24rpx;
  color: #BBBBBB;
  font-weight: 400;
}

/* ===== 日期 ===== */
.picker-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-value { font-size: 30rpx; color: #BBBBBB; }
.picker-value.has-value { color: #1A1A1A; font-weight: 500; }
.picker-arrow { font-size: 36rpx; color: #CCCCCC; }

/* ===== 天数 ===== */
.days-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 60rpx;
}

.days-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #F0F0F0;
  text-align: center;
  line-height: 80rpx;
  font-size: 44rpx;
  color: #1A1A1A;
}

.days-btn:active { background-color: #E0E0E0; }

.days-center {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  min-width: 120rpx;
  justify-content: center;
}

.days-num {
  font-size: 64rpx;
  font-weight: 700;
  color: #07C160;
  line-height: 1;
}

.days-unit { font-size: 28rpx; color: #666666; }

/* ===== 游玩方式：3列网格 ===== */
.pref-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

/* 每个选项 */
.pref-item {
  position: relative;
  width: calc((100% - 40rpx) / 3);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 28rpx 8rpx 22rpx;
  border-radius: 20rpx;
  background-color: #F7F7F7;
  border: 2rpx solid transparent;
  transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.1s ease;
}

/* 选中状态 */
.pref-on {
  background-color: #E8F8EE;
  border-color: #07C160;
  transform: scale(1.02);
}

.pref-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.pref-on .pref-icon-wrap {
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.25);
}

.pref-icon {
  width: 64rpx;
  height: 64rpx;
}

.pref-name {
  font-size: 24rpx;
  color: #1A1A1A;
  font-weight: 500;
  text-align: center;
}

.pref-on .pref-name {
  color: #07C160;
  font-weight: 700;
}

/* 选中勾：右下角 */
.pref-check {
  position: absolute;
  bottom: 14rpx;
  right: 14rpx;
  width: 36rpx;
  height: 36rpx;
  background-color: #07C160;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 8rpx rgba(7, 193, 96, 0.3);
}

.pref-check-icon {
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 700;
  line-height: 1;
}

.pref-item:active { transform: scale(0.95); }

/* ===== 补充说明 ===== */
.notes-input {
  width: 100%;
  min-height: 160rpx;
  background-color: #F7F7F7;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  line-height: 1.7;
  border: none;
  box-sizing: border-box;
  display: block;
}

.notes-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #CCCCCC;
  margin-top: 8rpx;
}

/* ===== 底部按钮 ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  border-top: 1rpx solid #F0F0F0;
}

.bottom-bar button {
  width: 100%;
  height: 96rpx;
  background-color: #07C160;
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
}

.bottom-bar button::after { border: none; }
