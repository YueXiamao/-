/* pages/plan/params/params.wxss */
.container {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding: 24rpx;
  padding-bottom: 160rpx;
}

/* 目的地摘要 */
.dest-summary {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.dest-label {
  font-size: 24rpx;
  color: #999999;
  display: block;
  margin-bottom: 12rpx;
}

.dest-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.dest-tag {
  background-color: #E8F8EE;
  color: #07C160;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
}

/* 表单区块 */
.form-section {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 20rpx;
}

/* 日期选择器 */
.picker-value {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #EEEEEE;
  font-size: 30rpx;
  color: #1A1A1A;
}

.picker-arrow {
  color: #CCCCCC;
  font-size: 36rpx;
}

/* 天数选择器 */
.days-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  padding: 16rpx 0;
}

.days-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  text-align: center;
  line-height: 72rpx;
  font-size: 40rpx;
  color: #07C160;
  border: 2rpx solid #07C160;
}

.days-btn:active {
  background-color: #E8F8EE;
}

.days-value {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.days-num {
  font-size: 56rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.days-unit {
  font-size: 28rpx;
  color: #666666;
}

/* 游玩方式 */
.preference-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.pref-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  width: 148rpx;
  padding: 20rpx 8rpx;
  background-color: #F5F5F5;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
}

.pref-item.active {
  background-color: #E8F8EE;
  border-color: #07C160;
}

.pref-icon {
  font-size: 40rpx;
}

.pref-label {
  font-size: 24rpx;
  color: #1A1A1A;
  text-align: center;
}

.pref-item.active .pref-label {
  color: #07C160;
}

/* 补充说明 */
.notes-input {
  width: 100%;
  min-height: 160rpx;
  background-color: #F5F5F5;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  line-height: 1.6;
  border: none;
}

.notes-hint {
  text-align: right;
  font-size: 22rpx;
  color: #CCCCCC;
  margin-top: 8rpx;
}

/* 底部按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  border-top: 1rpx solid #EEEEEE;
}

.bottom-bar button {
  width: 100%;
  height: 96rpx;
  background-color: #07C160;
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.bottom-bar button::after {
  border: none;
}
