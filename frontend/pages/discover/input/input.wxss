.container {
  min-height: 100vh;
  padding: 36rpx 24rpx 160rpx;
  background-image: linear-gradient(180deg, rgba(255,255,255,0.70), rgba(243,246,241,0.96) 360rpx, #F3F6F1 100%), url('/assets/backgrounds/city-coast.png');
  background-repeat: no-repeat;
  background-position: top center;
  background-size: 100% auto;
}

.page-hero {
  padding: 28rpx 8rpx 30rpx;
}

.hero-kicker {
  display: block;
  color: var(--color-secondary);
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  margin-bottom: 10rpx;
}

.hero-title {
  display: block;
  max-width: 560rpx;
  font-size: 46rpx;
  font-weight: 800;
  color: var(--color-text);
  line-height: 1.15;
  margin-bottom: 12rpx;
}

.hero-subtitle {
  display: block;
  font-size: 25rpx;
  color: var(--color-text-secondary);
  line-height: 1.55;
}

.section {
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  padding: 26rpx;
}

.section-title {
  font-size: var(--font-base);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: var(--space-sm);
}

.section-hint {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  font-weight: 400;
}

.location-bar {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-xs) 0;
}

.location-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 20rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 18rpx;
  font-weight: 800;
  line-height: 58rpx;
  text-align: center;
  letter-spacing: 0;
}

.location-text {
  flex: 1;
  font-size: var(--font-base);
  color: var(--color-text);
}

.location-edit {
  font-size: var(--font-sm);
  color: var(--color-primary);
}

.days-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 56rpx;
  padding: var(--space-sm) 0;
}

.days-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #F6F9F5;
  text-align: center;
  line-height: 76rpx;
  font-size: 38rpx;
  color: var(--color-primary);
  border: 2rpx solid rgba(22, 160, 109, 0.3);
}

.days-btn:active {
  transform: scale(0.96);
}

.days-value {
  display: flex;
  align-items: baseline;
  gap: var(--space-xs);
}

.days-num {
  font-size: 64rpx;
  font-weight: 800;
  color: var(--color-primary);
}

.days-unit {
  font-size: var(--font-lg);
  color: var(--color-text-secondary);
}

.budget-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-sm);
}

.budget-item {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: var(--space-base);
  border-radius: 20rpx;
  background: #F8FAF7;
  border: 2rpx solid transparent;
}

.budget-item.active {
  background: #FFF0DE;
  border-color: var(--color-secondary);
}

.budget-label {
  font-size: var(--font-base);
  font-weight: 700;
  color: var(--color-text);
}

.budget-item.active .budget-label {
  color: var(--color-secondary);
}

.budget-desc {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

.pref-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-sm);
}

.pref-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-xs);
  padding: 12rpx 8rpx 16rpx;
  border-radius: 20rpx;
  background: #F8FAF7;
  border: 2rpx solid transparent;
}

.pref-item.active {
  background: var(--color-primary-light);
  border-color: var(--color-primary);
}

.pref-icon-img {
  width: 104rpx;
  height: 104rpx;
  border-radius: 24rpx;
}

.pref-label {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  font-weight: 600;
  text-align: center;
}

.pref-item.active .pref-label {
  color: var(--color-primary);
  font-weight: 800;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--space-base);
  padding-bottom: calc(var(--space-base) + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -10rpx 28rpx rgba(35, 55, 45, 0.08);
}

.btn-primary {
  background-color: var(--color-secondary);
}
