.discover-input-page {
  padding-bottom: 156rpx;
  background:
    linear-gradient(180deg, rgba(255, 249, 240, 0.76), rgba(245, 241, 232, 0.98) 420rpx, #f5f1e8 100%),
    linear-gradient(145deg, rgba(240, 138, 46, 0.08), rgba(20, 134, 111, 0.06));
}

.discover-input-hero {
  padding-bottom: 20rpx;
}

.discover-mood-band {
  position: relative;
  display: grid;
  grid-template-columns: 1.55fr 1fr;
  gap: 12rpx;
  margin-top: 24rpx;
}

.mood-wide,
.mood-small {
  width: 100%;
  display: block;
  border-radius: 28rpx;
}

.mood-wide {
  height: 240rpx;
}

.mood-small {
  height: 240rpx;
}

.mood-chip {
  position: absolute;
  left: 18rpx;
  bottom: 18rpx;
  padding: 14rpx 16rpx;
  border-radius: 22rpx;
}

.mood-chip-label {
  display: block;
  font-size: var(--font-mini);
  color: var(--color-text-secondary);
}

.mood-chip-value {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-sm);
  font-weight: 800;
  color: var(--color-text-strong);
}

.page-content {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.section-card {
  background: var(--color-surface);
  border-radius: 30rpx;
  padding: 28rpx;
  border: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-card);
}

.section-card-error {
  border-color: rgba(207, 74, 64, 0.18);
  background: rgba(207, 74, 64, 0.03);
}

.section-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.section-hint {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
}

.loc-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(24, 37, 33, 0.04);
  border: 1rpx solid rgba(24, 37, 33, 0.06);
  margin-bottom: 14rpx;
}

.loc-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.loc-icon-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: var(--color-primary);
  flex-shrink: 0;
}

.loc-name {
  font-size: var(--font-base);
  color: var(--color-text-strong);
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.loc-mode-tag {
  min-height: 38rpx;
  padding: 0 14rpx;
  display: inline-flex;
  align-items: center;
  border-radius: 999rpx;
  font-size: var(--font-mini);
  font-weight: 700;
}

.tag-gps {
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.tag-manual {
  background: var(--color-secondary-soft);
  color: var(--color-secondary-deep);
}

.loc-empty {
  padding: 22rpx;
  text-align: center;
  border-radius: 22rpx;
  background: rgba(24, 37, 33, 0.03);
  border: 1.5rpx dashed rgba(24, 37, 33, 0.15);
  margin-bottom: 14rpx;
}

.loc-empty-error {
  border-color: rgba(207, 74, 64, 0.24);
  background: rgba(207, 74, 64, 0.03);
}

.loc-empty-text {
  font-size: var(--font-sm);
  color: var(--color-text-hint);
}

.loc-row {
  display: flex;
  gap: 12rpx;
}

.loc-btn {
  flex: 1;
  min-height: 88rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.loc-btn:active {
  transform: scale(0.98);
}

.loc-btn-gps {
  background: var(--color-primary);
  color: #ffffff;
}

.loc-btn-pick {
  background: rgba(24, 37, 33, 0.05);
  color: var(--color-text-strong);
}

.loc-btn-ico-gps {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  border: 3rpx solid currentColor;
  position: relative;
}

.loc-btn-ico-gps::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
  transform: translate(-50%, -50%);
}

.loc-btn-ico-check {
  width: 20rpx;
  height: 12rpx;
  border-left: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(-45deg);
  margin-top: 2rpx;
}

.loc-btn-txt {
  font-size: var(--font-sm);
  font-weight: 800;
  color: inherit;
}

.days-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 30rpx;
  min-height: 120rpx;
}

.days-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(24, 37, 33, 0.05);
  border: 1.5rpx solid rgba(24, 37, 33, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.days-btn:active {
  transform: scale(0.95);
}

.days-minus,
.days-plus {
  position: relative;
  width: 24rpx;
  height: 24rpx;
}

.days-minus::before,
.days-plus::before,
.days-plus::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 10rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: var(--color-secondary-deep);
}

.days-plus::after {
  left: 10rpx;
  right: auto;
  top: 0;
  width: 3rpx;
  height: 24rpx;
}

.days-center {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.days-num {
  font-size: 72rpx;
  line-height: 1;
  font-weight: 800;
  color: var(--color-secondary-deep);
}

.days-unit {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.budget-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.budget-item {
  min-height: 108rpx;
  padding: 18rpx 16rpx;
  border-radius: 24rpx;
  background: rgba(24, 37, 33, 0.04);
  border: 1.5rpx solid transparent;
}

.budget-item:active {
  transform: scale(0.98);
}

.budget-item.selected {
  background: var(--color-secondary-soft);
  border-color: rgba(240, 138, 46, 0.22);
}

.budget-label {
  display: block;
  font-size: var(--font-sm);
  font-weight: 800;
  color: var(--color-text-strong);
}

.budget-item.selected .budget-label {
  color: var(--color-secondary-deep);
}

.budget-desc {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-xs);
  line-height: 1.45;
  color: var(--color-text-hint);
}

.pref-name {
  font-size: var(--font-xs);
  line-height: 1.4;
  color: var(--color-text-secondary);
  font-weight: 700;
  text-align: center;
}

.pref-item.selected .pref-name {
  color: var(--color-primary);
}

.pref-check {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.pref-check-mark {
  width: 16rpx;
  height: 10rpx;
  border-left: 3rpx solid #ffffff;
  border-bottom: 3rpx solid #ffffff;
  transform: rotate(-45deg);
  margin-top: -2rpx;
}

.discover-submit {
  background: var(--color-secondary);
  box-shadow: 0 18rpx 40rpx rgba(240, 138, 46, 0.2);
}

.picker-overlay {
  position: fixed;
  inset: 0;
  background: var(--color-overlay);
  z-index: 1000;
}

.picker-drawer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-surface);
  border-radius: 36rpx 36rpx 0 0;
  z-index: 1001;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.32s cubic-bezier(0.32, 0.72, 0, 1);
  box-shadow: 0 -16rpx 48rpx rgba(0, 0, 0, 0.12);
}

.picker-drawer-open {
  transform: translateY(0);
}

.picker-topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 24rpx;
}

.picker-back,
.picker-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.picker-back-icon {
  width: 18rpx;
  height: 18rpx;
  border-left: 3rpx solid var(--color-text-secondary);
  border-bottom: 3rpx solid var(--color-text-secondary);
  transform: rotate(45deg);
  margin-left: 8rpx;
}

.picker-title {
  font-size: var(--font-lg);
  font-weight: 800;
  color: var(--color-text-strong);
}

.picker-close {
  position: relative;
}

.picker-close-icon,
.picker-close-icon::after {
  content: '';
  position: absolute;
  top: 22rpx;
  left: 10rpx;
  width: 28rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: var(--color-text-hint);
  transform: rotate(45deg);
}

.picker-close-icon::after {
  top: 0;
  left: 0;
  transform: rotate(90deg);
}

.picker-search-bar {
  display: flex;
  align-items: center;
  padding: 0 32rpx 20rpx;
}

.picker-search-ico {
  width: 32rpx;
  height: 32rpx;
  border: 2.5rpx solid #999;
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
  margin-right: 10rpx;
}

.picker-search-ico::after {
  content: '';
  position: absolute;
  bottom: -1rpx;
  right: -1rpx;
  width: 12rpx;
  border-top: 2.5rpx solid #999;
  transform: rotate(45deg);
}

.picker-search-input {
  flex: 1;
  font-size: var(--font-base);
  color: var(--color-text-strong);
}

.picker-hot {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 32rpx 16rpx;
  flex-wrap: wrap;
}

.picker-hot-label {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  font-weight: 700;
}

.picker-hot-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.picker-hot-item {
  min-height: 38rpx;
  padding: 0 16rpx;
  display: inline-flex;
  align-items: center;
  border-radius: 999rpx;
  background: rgba(24, 37, 33, 0.04);
  border: 1rpx solid rgba(24, 37, 33, 0.08);
  color: var(--color-text-secondary);
  font-size: var(--font-xs);
  font-weight: 700;
}

.picker-list {
  flex: 1;
  max-height: 55vh;
}

.picker-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.picker-row:last-child {
  border-bottom: none;
}

.picker-row:active {
  background: rgba(24, 37, 33, 0.03);
}

.picker-row-name {
  font-size: var(--font-base);
  color: var(--color-text-strong);
  font-weight: 600;
}

.row-name-on {
  color: var(--color-primary);
  font-weight: 800;
}

.picker-row-arrow,
.picker-row-check {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.picker-row-arrow-icon {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid var(--color-text-hint);
  border-right: 3rpx solid var(--color-text-hint);
  transform: rotate(45deg);
}

.picker-row-check-mark {
  width: 18rpx;
  height: 11rpx;
  border-left: 3rpx solid var(--color-primary);
  border-bottom: 3rpx solid var(--color-primary);
  transform: rotate(-45deg);
  margin-top: -4rpx;
}

.picker-empty {
  padding: 80rpx 32rpx;
  text-align: center;
}

.picker-empty-text {
  font-size: var(--font-base);
  color: var(--color-text-hint);
}
