/* pages/discover/input/input.wxss */

/* ── Page ── */
.container {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding: 0 0 160rpx 0;
}

/* ── Hero ── */
.hero {
  padding: 56rpx 36rpx 40rpx;
  background: linear-gradient(160deg, #FDF0E0 0%, #F5EDE0 50%, var(--color-bg) 100%);
  position: relative;
  overflow: hidden;
}

.hero::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -80rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(232, 129, 10, 0.12) 0%, transparent 70%);
  pointer-events: none;
}

.hero-eyebrow {
  display: block;
  font-size: var(--font-kicker);
  font-weight: 700;
  color: var(--color-secondary);
  letter-spacing: 3rpx;
  margin-bottom: 12rpx;
  text-transform: uppercase;
}

.hero-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: var(--color-text);
  line-height: 1.1;
  letter-spacing: var(--tracking-tight);
  margin-bottom: 10rpx;
}

.hero-sub {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.55;
}

/* ── Sections ── */
.sections-wrap {
  padding: 0 32rpx;
  margin-top: -16rpx;
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.section-card {
  background: var(--color-surface);
  border-radius: var(--r-xl);
  padding: 32rpx 28rpx 28rpx;
  box-shadow: var(--shadow-card);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.section-label {
  font-size: var(--font-sm);
  font-weight: 700;
  color: var(--color-text);
  display: block;
  margin-bottom: 20rpx;
}

.section-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-hint {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
}

/* ── Location ── */
.loc-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: var(--color-bg);
  border-radius: var(--r-md);
  margin-bottom: 16rpx;
  border: 1rpx solid var(--color-border);
}

.loc-info {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
  min-width: 0;
}

.loc-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: var(--r-sm);
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.loc-icon-inner {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 3rpx solid var(--color-primary);
  position: relative;
}

.loc-icon-inner::after {
  content: '';
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 8rpx;
  border-radius: 50% 50% 0 0;
  background: var(--color-primary);
}

.loc-name {
  font-size: var(--font-base);
  color: var(--color-text);
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.loc-mode-tag {
  font-size: 20rpx;
  padding: 5rpx 14rpx;
  border-radius: var(--r-full);
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.tag-gps {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.tag-manual {
  background: var(--color-secondary-light);
  color: var(--color-secondary);
}

.loc-empty {
  padding: 24rpx;
  text-align: center;
  background: var(--color-bg);
  border-radius: var(--r-md);
  margin-bottom: 16rpx;
  border: 1.5rpx dashed var(--color-border-strong);
}

.loc-empty-text {
  font-size: var(--font-base);
  color: var(--color-text-hint);
}

.loc-row {
  display: flex;
  gap: 14rpx;
}

.loc-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 20rpx;
  border-radius: var(--r-md);
  font-size: var(--font-sm);
  font-weight: 700;
  transition: transform 0.15s ease, box-shadow 0.15s ease, opacity 0.15s;
}

.loc-btn:active {
  transform: scale(0.97);
  opacity: 0.88;
}

.loc-btn-gps {
  background: var(--color-primary);
  color: #fff;
  box-shadow: var(--shadow-sm);
}

.loc-btn-pick {
  background: var(--color-surface);
  color: var(--color-text-secondary);
  border: 1.5rpx solid var(--color-border-strong);
}

/* ── Days ── */
.days-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 56rpx;
  padding: 12rpx 0;
}

.days-btn {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: var(--color-bg);
  text-align: center;
  line-height: 80rpx;
  font-size: 44rpx;
  color: var(--color-text-secondary);
  font-weight: 300;
  border: 2rpx solid var(--color-border-strong);
  transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
}

.days-btn:active {
  background: var(--color-secondary);
  border-color: var(--color-secondary);
  color: #fff;
  transform: scale(0.9);
  box-shadow: 0 6rpx 20rpx rgba(232, 129, 10, 0.3);
}

.days-center {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  min-width: 140rpx;
  justify-content: center;
}

.days-num {
  font-size: 72rpx;
  font-weight: 800;
  color: var(--color-secondary);
  line-height: 1;
  letter-spacing: -3rpx;
}

.days-unit {
  font-size: var(--font-base);
  color: var(--color-text-secondary);
  font-weight: 500;
}

/* ── Budget ── */
.budget-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.budget-item {
  width: calc((100% - 14rpx) / 2);
  padding: 20rpx 18rpx;
  border-radius: var(--r-md);
  background: var(--color-bg);
  border: 2rpx solid transparent;
  transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
}

.budget-item:active {
  transform: scale(0.97);
}

.budget-on {
  background: var(--color-secondary-light);
  border-color: var(--color-secondary);
}

.budget-label {
  display: block;
  font-size: var(--font-base);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 5rpx;
  letter-spacing: -0.3rpx;
}

.budget-on .budget-label {
  color: var(--color-secondary);
}

.budget-desc {
  display: block;
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  line-height: 1.4;
}

/* ── Preferences ── */
.pref-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.pref-item {
  position: relative;
  width: calc((100% - 32rpx) / 3);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx 6rpx 16rpx;
  border-radius: var(--r-md);
  background: var(--color-bg);
  border: 2rpx solid transparent;
  transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
}

.pref-item:active {
  transform: scale(0.94);
}

.pref-on {
  background: var(--color-primary-light);
  border-color: var(--color-primary);
}

.pref-icon-wrap {
  width: 112rpx;
  height: 112rpx;
  border-radius: var(--r-md);
  background: var(--color-surface);
  box-shadow: var(--shadow-xs);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.pref-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: var(--r-sm);
}

.pref-name {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  font-weight: 600;
  text-align: center;
  line-height: 1.3;
}

.pref-on .pref-name {
  color: var(--color-primary);
  font-weight: 700;
}

.pref-check {
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(13, 156, 110, 0.3);
}

/* ── Bottom Bar ── */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.97);
  border-top: 1rpx solid var(--color-border);
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.bottom-bar button {
  width: 100%;
  height: 100rpx;
  background: var(--color-secondary);
  color: #fff;
  border-radius: var(--r-xl);
  font-size: var(--font-lg);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-amber);
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.bottom-bar button:active {
  opacity: 0.88;
  transform: scale(0.98);
}

/* ── Picker Drawer ── */
.picker-overlay {
  position: fixed;
  inset: 0;
  background: var(--color-overlay);
  z-index: 1000;
  transition: opacity 0.28s ease;
}

.picker-drawer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-surface);
  border-radius: 36rpx 36rpx 0 0;
  z-index: 1001;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.32s cubic-bezier(0.32, 0.72, 0, 1);
  box-shadow: 0 -16rpx 48rpx rgba(0, 0, 0, 0.12);
}

.picker-drawer-open {
  transform: translateY(0);
}

.picker-topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 1rpx solid var(--color-border);
  flex-shrink: 0;
}

.picker-back {
  font-size: 52rpx;
  color: var(--color-secondary);
  font-weight: 300;
  padding: 0 8rpx;
  min-width: 60rpx;
  line-height: 1;
}

.picker-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-text);
  text-align: center;
  flex: 1;
}

.picker-close {
  font-size: 52rpx;
  color: var(--color-text-hint);
  font-weight: 300;
  padding: 0 8rpx;
  min-width: 60rpx;
  text-align: right;
  line-height: 1;
}

.picker-search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 18rpx 24rpx;
  padding: 0 20rpx;
  background: var(--color-bg);
  border-radius: var(--r-full);
  height: 72rpx;
  flex-shrink: 0;
  border: 1.5rpx solid var(--color-border);
}

.picker-search-input {
  flex: 1;
  height: 72rpx;
  font-size: var(--font-base);
  color: var(--color-text);
}

.picker-hot {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 24rpx 18rpx;
  flex-shrink: 0;
  overflow-x: auto;
  white-space: nowrap;
}

.picker-hot-label {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  flex-shrink: 0;
}

.picker-hot-list {
  display: flex;
  gap: 10rpx;
  flex-shrink: 0;
}

.picker-hot-item {
  font-size: var(--font-xs);
  color: var(--color-text);
  background: var(--color-bg);
  padding: 8rpx 18rpx;
  border-radius: var(--r-full);
  flex-shrink: 0;
  border: 1.5rpx solid var(--color-border);
  transition: all 0.15s;
}

.picker-hot-item:active {
  background: var(--color-secondary-light);
  border-color: var(--color-secondary);
  color: var(--color-secondary);
}

.picker-list {
  flex: 1;
  overflow-y: auto;
  max-height: 54vh;
}

.picker-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 32rpx;
  border-bottom: 1rpx solid var(--color-border);
  transition: background 0.12s;
}

.picker-row:active {
  background: var(--color-bg);
}

.picker-row-name {
  font-size: var(--font-base);
  color: var(--color-text);
  font-weight: 500;
}

.row-name-on {
  color: var(--color-secondary) !important;
  font-weight: 700;
}

.picker-row-arrow {
  font-size: 32rpx;
  color: var(--color-text-hint);
}

.picker-row-check {
  font-size: 28rpx;
  color: var(--color-secondary);
  font-weight: 700;
}

.picker-empty {
  padding: 80rpx 0;
  text-align: center;
}

.picker-empty-text {
  font-size: var(--font-base);
  color: var(--color-text-hint);
}
