/* pages/discover/input/input.wxss */

/* ── Page ── */
.container {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding: 32rpx 28rpx 160rpx;
}

/* ── Hero ── */
.hero {
  background: var(--color-surface);
  border-radius: var(--r-lg);
  padding: 36rpx 32rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-xs);
  border: 1rpx solid var(--color-border);
  border-left: 6rpx solid var(--color-secondary);
}

.hero-eyebrow {
  display: block;
  font-size: var(--font-kicker);
  font-weight: 700;
  color: var(--color-secondary);
  letter-spacing: 3rpx;
  margin-bottom: 12rpx;
  text-transform: uppercase;
}

.hero-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: var(--color-text);
  line-height: 1.15;
  margin-bottom: 10rpx;
  letter-spacing: -0.5rpx;
}

.hero-sub {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

/* ── Section Card ── */
.section-card {
  background: var(--color-surface);
  border-radius: var(--r-lg);
  padding: 28rpx 28rpx 26rpx;
  margin-bottom: 18rpx;
  box-shadow: var(--shadow-xs);
  border: 1rpx solid var(--color-border);
}

.section-label {
  font-size: var(--font-base);
  font-weight: 700;
  color: var(--color-text);
  display: block;
  margin-bottom: 18rpx;
}

.section-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.section-hint {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
}

/* ── Location ── */
.loc-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: var(--color-bg);
  border-radius: var(--r-base);
  margin-bottom: 16rpx;
  border: 1rpx solid var(--color-border);
}

.loc-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  flex: 1;
}

.loc-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: var(--r-sm);
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--color-primary);
}

.loc-name {
  font-size: var(--font-base);
  color: var(--color-text);
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.loc-mode-tag {
  font-size: var(--font-xs);
  padding: 6rpx 14rpx;
  border-radius: var(--r-full);
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.tag-gps {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.tag-manual {
  background: var(--color-secondary-light);
  color: var(--color-secondary);
}

.loc-empty {
  padding: 24rpx;
  text-align: center;
  background: var(--color-bg);
  border-radius: var(--r-base);
  margin-bottom: 16rpx;
  border: 1rpx dashed var(--color-border-strong);
}

.loc-empty-text {
  font-size: var(--font-base);
  color: var(--color-text-hint);
}

.loc-row {
  display: flex;
  gap: 14rpx;
}

.loc-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 20rpx;
  border-radius: var(--r-base);
  border: 2rpx solid;
  font-size: var(--font-base);
  font-weight: 600;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.loc-btn:active {
  transform: scale(0.97);
}

.loc-btn-gps {
  background: var(--color-primary-light);
  border-color: var(--color-primary);
  color: var(--color-primary);
}

.loc-btn-pick {
  background: var(--color-bg);
  border-color: var(--color-border-strong);
  color: var(--color-text-secondary);
}

.loc-btn-ico {
  font-size: 26rpx;
  flex-shrink: 0;
}

/* ── Days ── */
.days-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 56rpx;
  padding: 8rpx 0;
}

.days-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--color-bg);
  border: 2rpx solid var(--color-border-strong);
  text-align: center;
  line-height: 76rpx;
  font-size: 44rpx;
  color: var(--color-text);
  font-weight: 300;
  transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
}

.days-btn:active {
  background: var(--color-primary-light);
  border-color: var(--color-primary);
  color: var(--color-primary);
  transform: scale(0.93);
}

.days-center {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  min-width: 140rpx;
  justify-content: center;
}

.days-num {
  font-size: 68rpx;
  font-weight: 800;
  color: var(--color-secondary);
  line-height: 1;
  letter-spacing: -2rpx;
}

.days-unit {
  font-size: var(--font-base);
  color: var(--color-text-secondary);
  font-weight: 500;
}

/* ── Budget ── */
.budget-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.budget-item {
  width: calc((100% - 14rpx) / 2);
  padding: 20rpx 18rpx;
  border-radius: var(--r-base);
  background: var(--color-bg);
  border: 2rpx solid transparent;
  transition: background 0.15s ease, border-color 0.15s ease, transform 0.1s ease;
}

.budget-item:active {
  transform: scale(0.97);
}

.budget-on {
  background: var(--color-secondary-light);
  border-color: var(--color-secondary);
}

.budget-label {
  display: block;
  font-size: var(--font-base);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 6rpx;
}

.budget-on .budget-label {
  color: var(--color-secondary);
}

.budget-desc {
  display: block;
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  line-height: 1.4;
}

/* ── Preferences ── */
.pref-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.pref-item {
  position: relative;
  width: calc((100% - 32rpx) / 3);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx 6rpx 16rpx;
  border-radius: var(--r-base);
  background: var(--color-bg);
  border: 2rpx solid transparent;
  transition: background 0.15s ease, border-color 0.15s ease, transform 0.1s ease;
}

.pref-item:active {
  transform: scale(0.95);
}

.pref-on {
  background: var(--color-primary-light);
  border-color: var(--color-primary);
}

.pref-icon-wrap {
  width: 110rpx;
  height: 110rpx;
  border-radius: var(--r-base);
  background: var(--color-surface);
  box-shadow: var(--shadow-xs);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.pref-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 18rpx;
}

.pref-name {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  font-weight: 600;
  text-align: center;
  line-height: 1.3;
}

.pref-on .pref-name {
  color: var(--color-primary);
  font-weight: 700;
}

.pref-check {
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(22, 160, 109, 0.3);
}

.pref-check-icon {
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1;
}

/* ── Bottom Bar ── */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid var(--color-border);
  box-shadow: 0 -8rpx 24rpx rgba(35, 55, 45, 0.07);
  z-index: 100;
}

.bottom-bar button {
  width: 100%;
  height: 96rpx;
  background: var(--color-secondary);
  color: #fff;
  border-radius: var(--r-xl);
  font-size: var(--font-lg);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 0.5rpx;
  box-shadow: 0 8rpx 24rpx rgba(245, 158, 11, 0.3);
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.bottom-bar button:active {
  opacity: 0.88;
  transform: scale(0.98);
}

/* ── Location Picker Drawer ── */
.picker-overlay {
  position: fixed;
  inset: 0;
  background: var(--color-overlay);
  z-index: 1000;
  transition: opacity 0.25s ease;
}

.picker-drawer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-surface);
  border-radius: 32rpx 32rpx 0 0;
  z-index: 1001;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
}

.picker-drawer-open {
  transform: translateY(0);
}

.picker-topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 32rpx 22rpx;
  border-bottom: 1rpx solid var(--color-border);
  flex-shrink: 0;
}

.picker-back {
  font-size: 52rpx;
  color: var(--color-primary);
  font-weight: 300;
  padding: 0 8rpx;
  min-width: 60rpx;
  line-height: 1;
}

.picker-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-text);
  text-align: center;
  flex: 1;
}

.picker-close {
  font-size: 52rpx;
  color: var(--color-text-hint);
  font-weight: 300;
  padding: 0 8rpx;
  min-width: 60rpx;
  text-align: right;
  line-height: 1;
}

.picker-search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx 24rpx;
  padding: 0 20rpx;
  background: var(--color-bg);
  border-radius: var(--r-full);
  height: 72rpx;
  flex-shrink: 0;
  border: 1rpx solid var(--color-border);
}

.picker-search-ico {
  font-size: 26rpx;
  flex-shrink: 0;
  color: var(--color-text-hint);
}

.picker-search-input {
  flex: 1;
  height: 72rpx;
  font-size: var(--font-base);
  color: var(--color-text);
}

.picker-hot {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 24rpx 18rpx;
  flex-shrink: 0;
  overflow-x: auto;
  white-space: nowrap;
}

.picker-hot-label {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  flex-shrink: 0;
}

.picker-hot-list {
  display: flex;
  gap: 10rpx;
  flex-shrink: 0;
}

.picker-hot-item {
  font-size: var(--font-xs);
  color: var(--color-text);
  background: var(--color-bg);
  padding: 8rpx 18rpx;
  border-radius: var(--r-full);
  flex-shrink: 0;
  border: 1rpx solid var(--color-border);
  transition: background 0.15s ease;
}

.picker-hot-item:active {
  background: var(--color-primary-light);
  border-color: var(--color-primary);
  color: var(--color-primary);
}

.picker-list {
  flex: 1;
  overflow-y: auto;
  max-height: 52vh;
}

.picker-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 32rpx;
  border-bottom: 1rpx solid var(--color-border);
  transition: background 0.12s ease;
}

.picker-row:active {
  background: var(--color-bg);
}

.picker-row-name {
  font-size: var(--font-base);
  color: var(--color-text);
  font-weight: 500;
}

.row-name-on {
  color: var(--color-primary) !important;
  font-weight: 700;
}

.picker-row-arrow {
  font-size: 32rpx;
  color: var(--color-text-hint);
}

.picker-row-check {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 700;
}

.picker-empty {
  padding: 80rpx 0;
  text-align: center;
}

.picker-empty-text {
  font-size: var(--font-base);
  color: var(--color-text-hint);
}
