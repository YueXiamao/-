/* pages/discover/input/input.wxss */

.container {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding: 24rpx;
  padding-bottom: 160rpx;
}

/* ===== 通用卡片 ===== */
.section-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.section-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
  margin-bottom: 20rpx;
}

.section-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-hint { font-size: 24rpx; color: #BBBBBB; }

/* ===== Hero ===== */
.hero {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
}

.hero-eyebrow {
  display: block;
  font-size: 22rpx;
  color: #07C160;
  font-weight: 800;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.hero-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #1A1A1A;
  margin-bottom: 10rpx;
}

.hero-sub { display: block; font-size: 26rpx; color: #888888; }

/* ===== 位置 ===== */
.loc-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background-color: #F5F5F5;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.loc-info { display: flex; align-items: center; gap: 12rpx; }
.loc-icon { font-size: 28rpx; color: #07C160; }
.loc-name { font-size: 30rpx; color: #1A1A1A; font-weight: 500; }

.loc-mode-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.tag-gps { background-color: #E8F8EE; color: #07C160; }
.tag-manual { background-color: #FFF3E0; color: #FF9500; }

.loc-empty {
  padding: 24rpx;
  text-align: center;
  background-color: #F5F5F5;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.loc-empty-text { font-size: 28rpx; color: #AAAAAA; }

.loc-row { display: flex; gap: 16rpx; }

.loc-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  border: 2rpx solid;
}

.loc-btn-gps { background-color: #E8F8EE; border-color: #07C160; }
.loc-btn-pick { background-color: #F0F0F0; border-color: #E0E0E0; }
.loc-btn-ico { font-size: 28rpx; }
.loc-btn-gps .loc-btn-ico, .loc-btn-gps .loc-btn-txt { color: #07C160; }
.loc-btn-pick .loc-btn-ico, .loc-btn-pick .loc-btn-txt { color: #1A1A1A; }
.loc-btn-txt { font-size: 28rpx; font-weight: 600; }

/* ===== 天数 ===== */
.days-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 60rpx;
}

.days-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #F0F0F0;
  text-align: center;
  line-height: 80rpx;
  font-size: 44rpx;
  color: #1A1A1A;
}

.days-btn:active { background-color: #E0E0E0; }

.days-center {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  min-width: 120rpx;
  justify-content: center;
}

.days-num {
  font-size: 64rpx;
  font-weight: 700;
  color: #07C160;
  line-height: 1;
}

.days-unit { font-size: 28rpx; color: #666666; }

/* ===== 预算 ===== */
.budget-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.budget-item {
  width: calc((100% - 16rpx) / 2);
  padding: 20rpx;
  border-radius: 16rpx;
  background-color: #F7F7F7;
  border: 2rpx solid transparent;
}

.budget-on { background-color: #E8F8EE; border-color: #07C160; }

.budget-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 6rpx;
}

.budget-on .budget-label { color: #07C160; }
.budget-desc { display: block; font-size: 22rpx; color: #888888; }

/* ===== 游玩偏好 ===== */
.pref-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

/* 游玩偏好卡片 */
.pref-item {
  position: relative;
  width: calc((100% - 40rpx) / 3);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 24rpx 8rpx 18rpx;
  border-radius: 20rpx;
  background-color: #F8FAF7;
  border: 2rpx solid transparent;
  transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.1s ease;
}

.pref-item:active { transform: scale(0.96); }

.pref-on {
  background-color: #E8F8EE;
  border-color: #07C160;
}

.pref-icon-wrap {
  width: 118rpx;
  height: 118rpx;
  border-radius: 30rpx;
  background-color: #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(35, 55, 45, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.pref-icon { width: 108rpx; height: 108rpx; border-radius: 24rpx; }

.pref-name {
  font-size: 24rpx;
  color: #1A1A1A;
  font-weight: 600;
  text-align: center;
  line-height: 1.4;
}

.pref-on .pref-name { color: #07C160; font-weight: 700; }

.pref-check {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background-color: #07C160;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(7, 193, 96, 0.24);
}

.pref-check-icon { color: #FFFFFF; font-size: 20rpx; font-weight: 700; line-height: 1; }

/* ===== 底部按钮 ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  border-top: 1rpx solid #F0F0F0;
}

.bottom-bar button {
  width: 100%;
  height: 96rpx;
  background-color: #07C160;
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.bottom-bar button::after { border: none; }

/* ===== 位置选择器抽屉 ===== */
.picker-overlay {
  position: fixed;
  inset: 0;
  background-color: rgba(0, 0, 0, 0.45);
  z-index: 1000;
}

.picker-drawer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 1001;
  max-height: 75vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
}

.picker-drawer-open { transform: translateY(0); }

.picker-topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #F0F0F0;
  flex-shrink: 0;
}

.picker-back {
  font-size: 48rpx;
  color: #07C160;
  font-weight: 300;
  padding: 0 8rpx;
  min-width: 60rpx;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  text-align: center;
  flex: 1;
}

.picker-close {
  font-size: 48rpx;
  color: #AAAAAA;
  font-weight: 300;
  padding: 0 8rpx;
  min-width: 60rpx;
  text-align: right;
}

.picker-search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx 24rpx;
  padding: 0 20rpx;
  background-color: #F5F5F5;
  border-radius: 999rpx;
  height: 72rpx;
  flex-shrink: 0;
}

.picker-search-ico { font-size: 28rpx; flex-shrink: 0; }
.picker-search-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  color: #1A1A1A;
}

.picker-hot {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 24rpx 16rpx;
  flex-shrink: 0;
  overflow-x: auto;
  white-space: nowrap;
}

.picker-hot-label { font-size: 24rpx; color: #999999; flex-shrink: 0; }
.picker-hot-list { display: flex; gap: 12rpx; flex-shrink: 0; }

.picker-hot-item {
  font-size: 24rpx;
  color: #1A1A1A;
  background-color: #F0F0F0;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.picker-hot-item:active { background-color: #E0E0E0; }

.picker-list {
  flex: 1;
  overflow-y: auto;
  max-height: 50vh;
}

.picker-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F8F8F8;
}

.picker-row:active { background-color: #F5F5F5; }

.picker-row-name { font-size: 30rpx; color: #1A1A1A; }
.row-name-on { color: #07C160 !important; font-weight: 600; }
.picker-row-arrow { font-size: 28rpx; color: #CCCCCC; }
.picker-row-check { font-size: 28rpx; color: #07C160; font-weight: 700; }

.picker-empty {
  padding: 80rpx 0;
  text-align: center;
}

.picker-empty-text { font-size: 28rpx; color: #AAAAAA; }
