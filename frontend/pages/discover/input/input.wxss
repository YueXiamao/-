/* pages/discover/input/input.wxss */

/* ── Page ── */
.page {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding: 0 0 160rpx 0;
}

/* ── Sections (wraps page-content) ── */
.page-content {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* ── Section Card ── */
.section-card {
  background: var(--color-surface);
  border-radius: var(--r-xl);
  padding: 32rpx 28rpx 28rpx;
  box-shadow: var(--shadow-card);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.section-card-error {
  border-color: var(--color-danger-light);
  background: rgba(220, 38, 38, 0.03);
}

.section-label {
  font-size: var(--font-sm);
  font-weight: 700;
  color: var(--color-text);
  display: block;
  margin-bottom: 20rpx;
}

.section-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-hint {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
}

/* ── Location Card ── */
.loc-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: var(--color-bg);
  border-radius: var(--r-md);
  margin-bottom: 16rpx;
  border: 1rpx solid var(--color-border);
}

.loc-info {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
  min-width: 0;
}

.loc-icon-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: var(--color-primary);
  flex-shrink: 0;
  position: relative;
}

.loc-name {
  font-size: var(--font-base);
  color: var(--color-text);
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.loc-mode-tag {
  font-size: 20rpx;
  padding: 5rpx 14rpx;
  border-radius: var(--r-full);
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.tag-gps {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.tag-manual {
  background: var(--color-secondary-light);
  color: var(--color-secondary);
}

.loc-empty {
  padding: 24rpx;
  text-align: center;
  background: var(--color-bg);
  border-radius: var(--r-md);
  margin-bottom: 16rpx;
  border: 1.5rpx dashed var(--color-border-strong);
}

.loc-empty-error {
  border-color: var(--color-danger-light);
  background: rgba(220, 38, 38, 0.03);
}

.loc-empty-text {
  font-size: var(--font-base);
  color: var(--color-text-hint);
}

.loc-row {
  display: flex;
  gap: 14rpx;
}

/* ── Location Buttons ── */
.loc-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 20rpx;
  border-radius: var(--r-md);
  font-size: var(--font-sm);
  font-weight: 700;
  transition: transform 0.15s cubic-bezier(0.16, 1, 0.3, 1),
              box-shadow 0.15s ease, opacity 0.15s;
}

.loc-btn:active {
  transform: scale(0.97);
  opacity: 0.88;
}

.loc-btn-gps {
  background: var(--color-primary);
  color: #fff;
  box-shadow: var(--shadow-sm);
}

.loc-btn-pick {
  background: var(--color-surface);
  color: var(--color-text-secondary);
  border: 1.5rpx solid var(--color-border-strong);
}

/* GPS icon (circle with center dot) */
.loc-btn-ico-gps {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 3rpx solid currentColor;
  position: relative;
  flex-shrink: 0;
}

.loc-btn-ico-gps::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
}

/* Check icon (checkmark) */
.loc-btn-ico-check {
  width: 22rpx;
  height: 14rpx;
  border-left: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(-45deg);
  flex-shrink: 0;
  margin-top: 4rpx;
}

.loc-btn-txt {
  font-size: var(--font-sm);
  font-weight: 700;
  color: inherit;
}

/* ── Days Selector ── */
.days-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 56rpx;
  padding: 12rpx 0;
}

.days-btn {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: var(--color-bg);
  text-align: center;
  line-height: 80rpx;
  font-size: 44rpx;
  color: var(--color-text-secondary);
  font-weight: 300;
  border: 2rpx solid var(--color-border-strong);
  transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
}

.days-btn:active {
  background: var(--color-secondary);
  border-color: var(--color-secondary);
  color: #fff;
  transform: scale(0.9);
  box-shadow: 0 6rpx 20rpx rgba(232, 129, 10, 0.3);
}

.days-center {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  min-width: 140rpx;
  justify-content: center;
}

.days-num {
  font-size: 72rpx;
  font-weight: 800;
  color: var(--color-secondary);
  line-height: 1;
  letter-spacing: -3rpx;
}

.days-unit {
  font-size: var(--font-base);
  color: var(--color-text-secondary);
  font-weight: 500;
}

/* ── Budget Grid (2-col variant of pref-grid) ── */
.budget-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

/* ── Budget Item (uses pref-item structure) ── */
.budget-item {
  padding: 20rpx 18rpx;
  border-radius: var(--r-md);
  background: var(--color-bg);
  border: 2rpx solid transparent;
  transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
}

.budget-item:active {
  transform: scale(0.97);
}

.budget-item.selected {
  background: var(--color-secondary-light);
  border-color: var(--color-secondary);
}

.budget-label {
  display: block;
  font-size: var(--font-base);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 5rpx;
  letter-spacing: -0.3rpx;
}

.selected .budget-label {
  color: var(--color-secondary);
}

.budget-desc {
  display: block;
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  line-height: 1.4;
}

/* ── Preference Grid (uses global .pref-grid from app.wxss) ── */
.pref-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.pref-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx 6rpx 16rpx;
  border-radius: var(--r-md);
  background: var(--color-bg);
  border: 2rpx solid transparent;
  transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
}

.pref-item:active {
  transform: scale(0.94);
}

.pref-item.selected {
  background: var(--color-primary-light);
  border-color: var(--color-primary);
}

.pref-icon-wrap {
  width: 112rpx;
  height: 112rpx;
  border-radius: var(--r-md);
  background: var(--color-surface);
  box-shadow: var(--shadow-xs);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.pref-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: var(--r-sm);
}

.pref-name {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  font-weight: 600;
  text-align: center;
  line-height: 1.3;
  max-height: 2.6em;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.selected .pref-name {
  color: var(--color-primary);
  font-weight: 700;
}

.pref-check {
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(13, 156, 110, 0.3);
}

.pref-check-mark {
  width: 16rpx;
  height: 10rpx;
  border-left: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: rotate(-45deg);
  margin-top: -2rpx;
}

/* ── Bottom Bar (amber variant for discover) ── */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.97);
  border-top: 1rpx solid var(--color-border);
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.bottom-bar .btn-primary {
  width: 100%;
  background: var(--color-secondary);
  box-shadow: var(--shadow-amber);
}

.bottom-bar .btn-primary:active {
  opacity: 0.88;
  transform: scale(0.98);
}

/* ── Picker Drawer ── */
.picker-overlay {
  position: fixed;
  inset: 0;
  background: var(--color-overlay);
  z-index: 1000;
  transition: opacity 0.28s ease;
}

.picker-drawer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-surface);
  border-radius: 36rpx 36rpx 0 0;
  z-index: 1001;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.32s cubic-bezier(0.32, 0.72, 0, 1);
  box-shadow: 0 -16rpx 48rpx rgba(0, 0, 0, 0.12);
}

.picker-drawer-open {
  transform: translateY(0);
}

.picker-topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 24rpx;
}

.picker-back {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.picker-back-icon {
  width: 18rpx;
  height: 18rpx;
  border-left: 3rpx solid var(--color-text-secondary);
  border-bottom: 3rpx solid var(--color-text-secondary);
  transform: rotate(45deg);
  margin-left: 8rpx;
}

.picker-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-text);
}

.picker-close {
  width: 48rpx;
  height: 48rpx;
  position: relative;
}

.picker-close-icon,
.picker-close-icon::after {
  position: absolute;
  top: 23rpx;
  left: 10rpx;
  width: 28rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: var(--color-text-hint);
  content: '';
  transform: rotate(45deg);
}

.picker-close-icon::after {
  top: 0;
  left: 0;
  transform: rotate(90deg);
}

.picker-search-bar {
  display: flex;
  align-items: center;
  padding: 0 32rpx 20rpx;
  gap: 0;
}

.picker-search-ico {
  width: 32rpx;
  height: 32rpx;
  border: 2.5rpx solid #999;
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
  margin-right: 8rpx;
}

.picker-search-ico::after {
  content: '';
  position: absolute;
  bottom: -1rpx;
  right: -1rpx;
  width: 12rpx;
  height: 0;
  border-top: 2.5rpx solid #999;
  transform: rotate(45deg);
  transform-origin: bottom right;
}

.picker-search-input {
  flex: 1;
  font-size: var(--font-base);
  color: var(--color-text);
  padding: 0;
}

.picker-hot {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 32rpx 16rpx;
  flex-wrap: wrap;
}

.picker-hot-label {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  font-weight: 600;
  flex-shrink: 0;
}

.picker-hot-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.picker-hot-item {
  font-size: var(--font-xs);
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: var(--r-full);
  background: var(--color-bg);
  color: var(--color-text-secondary);
  border: 1rpx solid var(--color-border);
  transition: background 0.15s, color 0.15s;
}

.picker-hot-item:active {
  background: var(--color-secondary-light);
  color: var(--color-secondary);
}

.picker-list {
  flex: 1;
  max-height: 55vh;
}

.picker-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--color-border);
  transition: background 0.12s;
}

.picker-row:last-child {
  border-bottom: none;
}

.picker-row:active {
  background: var(--color-bg);
}

.picker-row-name {
  font-size: var(--font-base);
  color: var(--color-text);
  font-weight: 500;
}

.row-name-on {
  color: var(--color-primary);
  font-weight: 700;
}

.picker-row-arrow {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.picker-row-arrow-icon {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid var(--color-text-hint);
  border-right: 3rpx solid var(--color-text-hint);
  transform: rotate(45deg);
}

.picker-row-check {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.picker-row-check-mark {
  width: 18rpx;
  height: 11rpx;
  border-left: 3rpx solid var(--color-primary);
  border-bottom: 3rpx solid var(--color-primary);
  transform: rotate(-45deg);
  margin-top: -4rpx;
}

.picker-empty {
  padding: 80rpx 32rpx;
  text-align: center;
}

.picker-empty-text {
  font-size: var(--font-base);
  color: var(--color-text-hint);
}
