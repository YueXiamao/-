<view class="container page-bg">
  <view class="page-hero">
    <text class="hero-kicker">DISCOVER</text>
    <text class="hero-title">不知道去哪，也可以先出发</text>
    <text class="hero-subtitle">按位置、预算、天数和偏好，给你一个靠谱的周末灵感</text>
  </view>

  <view class="section glass-card">
    <view class="section-title">当前位置</view>
    <view class="location-bar" bindtap="onLocationInput">
      <text class="location-icon">LOC</text>
      <text class="location-text">{{locationText}}</text>
      <text class="location-edit">修改</text>
    </view>
  </view>

  <view class="section glass-card">
    <view class="section-title">想玩几天</view>
    <view class="days-selector">
      <view class="days-btn" bindtap="onDaysChange" data-delta="-1">-</view>
      <view class="days-value">
        <text class="days-num">{{days}}</text>
        <text class="days-unit">天</text>
      </view>
      <view class="days-btn" bindtap="onDaysChange" data-delta="1">+</view>
    </view>
  </view>

  <view class="section glass-card">
    <view class="section-title">人均预算</view>
    <view class="budget-grid">
      <view
        class="budget-item {{budget === item.value ? 'active' : ''}}"
        wx:for="{{budgetOptions}}"
        wx:key="value"
        bindtap="onBudgetTap"
        data-value="{{item.value}}"
      >
        <text class="budget-label">{{item.label}}</text>
        <text class="budget-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <view class="section glass-card">
    <view class="section-title">偏好方式 <text class="section-hint">选填，最多 3 个</text></view>
    <view class="pref-grid">
      <view
        class="pref-item {{item.selected ? 'active' : ''}}"
        wx:for="{{preferenceOptions}}"
        wx:key="value"
        bindtap="onPrefTap"
        data-value="{{item.value}}"
      >
        <image class="pref-icon-img" src="{{item.icon}}" mode="aspectFill" />
        <text class="pref-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="bottom-bar">
    <button class="btn-primary" bindtap="onRecommend">开始随机玩</button>
  </view>
</view>
