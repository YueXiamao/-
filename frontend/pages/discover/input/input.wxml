<!-- pages/discover/input/input.wxml -->
<view class="container">

  <!-- 顶部标题 -->
  <view class="hero">
    <text class="hero-eyebrow">DISCOVER</text>
    <text class="hero-title">不知道去哪，先出发</text>
    <text class="hero-sub">根据你的位置和偏好，精选周末灵感</text>
  </view>

  <!-- 位置卡片 -->
  <view class="section-card">
    <text class="section-label">当前位置</text>

    <!-- 定位成功状态 -->
    <view class="location-display" wx:if="{{!locationLoading && !locationError}}">
      <view class="loc-info">
        <text class="loc-icon">[*]</text>
        <view class="loc-text-wrap">
          <text class="loc-province">{{currentProvince ? currentProvince.name : '省'}}</text>
          <text class="loc-city">{{currentCity ? currentCity.name : '市'}}</text>
        </view>
      </view>
      <view class="loc-actions">
        <text class="loc-btn" bindtap="onRelocate">重新定位</text>
        <text class="loc-btn loc-btn-main" bindtap="onLocationInput">手动选择</text>
      </view>
    </view>

    <!-- 定位中 -->
    <view class="location-loading" wx:if="{{locationLoading}}">
      <text class="loc-loading-icon">[*]</text>
      <text class="loc-loading-text">正在定位...</text>
    </view>

    <!-- 定位失败 / 手动模式 -->
    <view class="location-error" wx:if="{{!locationLoading && locationError}}">
      <text class="loc-error-text">定位失败</text>
      <text class="loc-btn loc-btn-main" bindtap="onLocationInput">手动选择位置</text>
    </view>
  </view>

  <!-- 天数 -->
  <view class="section-card">
    <text class="section-label">游玩天数</text>
    <view class="days-row">
      <view class="days-btn" bindtap="onDaysChange" data-delta="-1">-</view>
      <view class="days-center">
        <text class="days-num">{{days}}</text>
        <text class="days-unit">天</text>
      </view>
      <view class="days-btn" bindtap="onDaysChange" data-delta="1">+</view>
    </view>
  </view>

  <!-- 预算 -->
  <view class="section-card">
    <text class="section-label">人均预算</text>
    <view class="budget-grid">
      <view
        class="budget-item {{budget === item.value ? 'budget-on' : ''}}"
        wx:for="{{budgetOptions}}"
        wx:key="value"
        bindtap="onBudgetTap"
        data-value="{{item.value}}"
      >
        <text class="budget-label">{{item.label}}</text>
        <text class="budget-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <!-- 游玩偏好 -->
  <view class="section-card">
    <view class="section-label-row">
      <text class="section-label">游玩偏好</text>
      <text class="section-hint">选1-3个</text>
    </view>
    <view class="pref-grid">
      <view
        class="pref-item {{preferences.indexOf(item.value) >= 0 ? 'pref-on' : ''}}"
        wx:for="{{preferenceOptions}}"
        wx:key="value"
        bindtap="onPrefTap"
        data-value="{{item.value}}"
      >
        <view class="pref-icon-wrap">
          <image class="pref-icon" src="{{item.icon}}" mode="aspectFit" />
        </view>
        <text class="pref-name">{{item.label}}</text>
        <view class="pref-check" wx:if="{{preferences.indexOf(item.value) >= 0}}">
          <text class="pref-check-icon">V</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-bar">
    <button class="btn-primary" bindtap="onRecommend">开始随机玩</button>
  </view>

  <!-- 省份选择弹窗 -->
  <view class="picker-mask" wx:if="{{showProvincePicker}}" bindtap="onPickerClose">
    <view class="picker-sheet" catchtap="">
      <view class="picker-header">
        <text class="picker-cancel" bindtap="onPickerClose">取消</text>
        <text class="picker-title">选择省份</text>
        <view style="width:80rpx"></view>
      </view>
      <view class="picker-search">
        <input
          class="search-input"
          placeholder="搜索省份..."
          bindinput="onProvinceSearch"
          value="{{provinceInput}}"
        />
      </view>
      <scroll-view class="picker-list" scroll-y="{{true}}">
        <view
          class="picker-item"
          wx:for="{{filteredProvinces}}"
          wx:key="code"
          bindtap="onProvinceConfirm"
          data-code="{{item.code}}"
          data-name="{{item.name}}"
        >
          <text class="picker-item-text">{{item.name}}</text>
          <text class="picker-item-arrow">›</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 城市选择弹窗 -->
  <view class="picker-mask" wx:if="{{showCityPicker}}" bindtap="onPickerClose">
    <view class="picker-sheet" catchtap="">
      <view class="picker-header">
        <text class="picker-cancel" bindtap="onPickerClose">返回</text>
        <text class="picker-title">选择城市</text>
        <view style="width:80rpx"></view>
      </view>
      <view class="picker-search">
        <input
          class="search-input"
          placeholder="搜索城市..."
          bindinput="onCitySearch"
          value="{{cityInput}}"
        />
      </view>
      <scroll-view class="picker-list" scroll-y="{{true}}">
        <view
          class="picker-item"
          wx:for="{{filteredCities}}"
          wx:key="code"
          bindtap="onCityConfirm"
          data-code="{{item.code}}"
          data-name="{{item.name}}"
        >
          <text class="picker-item-text">{{item.name}}</text>
          <text class="picker-item-arrow">›</text>
        </view>
      </scroll-view>
    </view>
  </view>

</view>
