<!-- pages/discover/input/input.wxml -->
<view class="container">

  <!-- 顶部标题 -->
  <view class="hero">
    <text class="hero-eyebrow">DISCOVER</text>
    <text class="hero-title">不知道去哪，先出发</text>
    <text class="hero-sub">根据你的位置和偏好，精选周末灵感</text>
  </view>

  <!-- 位置卡片 -->
  <view class="section-card">
    <text class="section-label">当前位置</text>

    <!-- 已选位置 -->
    <view class="loc-bar" wx:if="{{locationText}}">
      <view class="loc-info">
        <text class="loc-icon">[*]</text>
        <text class="loc-name">{{locationText}}</text>
      </view>
      <view class="loc-mode-tag {{locationMode === 'loc' ? 'tag-gps' : 'tag-manual'}}">
        {{locationMode === 'loc' ? 'GPS' : '手动'}}
      </view>
    </view>

    <!-- 未选 -->
    <view class="loc-empty" wx:if="{{!locationText}}">
      <text class="loc-empty-text">请选择您的位置</text>
    </view>

    <!-- 两个按钮 -->
    <view class="loc-row">
      <view class="loc-btn loc-btn-gps" bindtap="onLocate">
        <text class="loc-btn-ico">[*]</text>
        <text class="loc-btn-txt">微信定位</text>
      </view>
      <view class="loc-btn loc-btn-pick" bindtap="onManualLocation">
        <text class="loc-btn-ico">[v]</text>
        <text class="loc-btn-txt">选择位置</text>
      </view>
    </view>
  </view>

  <!-- 天数 -->
  <view class="section-card">
    <text class="section-label">游玩天数</text>
    <view class="days-row">
      <view class="days-btn" bindtap="onDaysChange" data-delta="-1">-</view>
      <view class="days-center">
        <text class="days-num">{{days}}</text>
        <text class="days-unit">天</text>
      </view>
      <view class="days-btn" bindtap="onDaysChange" data-delta="1">+</view>
    </view>
  </view>

  <!-- 预算 -->
  <view class="section-card">
    <text class="section-label">人均预算</text>
    <view class="budget-grid">
      <view
        class="budget-item {{budget === item.value ? 'budget-on' : ''}}"
        wx:for="{{budgetOptions}}"
        wx:key="value"
        bindtap="onBudgetTap"
        data-value="{{item.value}}"
      >
        <text class="budget-label">{{item.label}}</text>
        <text class="budget-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <!-- 游玩偏好 -->
  <view class="section-card">
    <view class="section-label-row">
      <text class="section-label">游玩偏好</text>
      <text class="section-hint">选1-3个</text>
    </view>
    <view class="pref-grid">
      <view
        class="pref-item {{preferences.indexOf(item.value) >= 0 ? 'pref-on' : ''}}"
        wx:for="{{preferenceOptions}}"
        wx:key="value"
        bindtap="onPrefTap"
        data-value="{{item.value}}"
      >
        <view class="pref-icon-wrap">
          <image class="pref-icon" src="{{item.icon}}" mode="aspectFit" />
        </view>
        <text class="pref-name">{{item.label}}</text>
        <view class="pref-check" wx:if="{{preferences.indexOf(item.value) >= 0}}">
          <text class="pref-check-ico">V</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-bar">
    <button class="btn-primary" bindtap="onRecommend">开始随机玩</button>
  </view>

  <!-- ========================================= -->
  <!-- 位置选择器：底部抽屉式，类似美团/携程 -->
  <!-- ========================================= -->
  <view class="picker-overlay" wx:if="{{showPicker}}" bindtap="onPickerClose"></view>
  <view class="picker-drawer {{showPicker ? 'picker-drawer-open' : ''}}">
    <!-- 顶部栏 -->
    <view class="picker-topbar">
      <!-- 返回箭头（城市选择时显示） -->
      <text class="picker-back" wx:if="{{pickerStep === 'city'}}" bindtap="onPickerBack">‹</text>
      <text class="picker-title">{{pickerStep === 'province' ? '选择省份' : '选择城市'}}</text>
      <text class="picker-close" bindtap="onPickerClose">×</text>
    </view>

    <!-- 搜索框 -->
    <view class="picker-search-bar">
      <text class="picker-search-ico">🔍</text>
      <input
        class="picker-search-input"
        placeholder="{{pickerStep === 'province' ? '搜索省份' : '搜索城市'}}"
        value="{{searchValue}}"
        bindinput="onPickerSearch"
        focus="{{showPicker}}"
      />
    </view>

    <!-- 快捷常用 -->
    <view class="picker-hot" wx:if="{{pickerStep === 'province'}}">
      <text class="picker-hot-label">常用</text>
      <view class="picker-hot-list">
        <text
          class="picker-hot-item"
          wx:for="{{['北京','上海','广东','四川','浙江','江苏']}}"
          wx:key="this"
          bindtap="onPickerSelect"
          data-code=""
          data-name="{{item}}"
        >{{item}}</text>
      </view>
    </view>

    <!-- 列表 -->
    <scroll-view class="picker-list" scroll-y="{{true}}">
      <view
        class="picker-row {{(pickerStep === 'province' && currentProvince && item.code === currentProvince.code) || (pickerStep === 'city' && currentCity && item.code === currentCity.code) ? 'picker-row-on' : ''}}"
        wx:for="{{filteredList}}"
        wx:key="code"
        bindtap="onPickerSelect"
        data-code="{{item.code}}"
        data-name="{{item.name}}"
      >
        <text class="picker-row-name">{{item.name}}</text>
        <text class="picker-row-check" wx:if="{{(pickerStep === 'province' && currentProvince && item.code === currentProvince.code) || (pickerStep === 'city' && currentCity && item.code === currentCity.code)}}">✓</text>
      </view>

      <!-- 无结果 -->
      <view class="picker-empty" wx:if="{{filteredList.length === 0}}">
        <text class="picker-empty-text">未找到结果</text>
      </view>
    </scroll-view>
  </view>

</view>
