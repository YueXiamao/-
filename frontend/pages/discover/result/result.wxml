<view class="page page-bg discover-result-page">
  <view wx:if="{{loading}}" class="skeleton-wrap">
    <view class="discover-hero-skeleton surface-card">
      <view class="skeleton-line long"></view>
      <view class="skeleton-line medium"></view>
      <view class="skeleton-row">
        <view class="skeleton-chip"></view>
        <view class="skeleton-chip"></view>
        <view class="skeleton-chip"></view>
      </view>
    </view>
    <view class="skeleton-card" wx:for="{{[1,2,3]}}" wx:key="i">
      <view class="skeleton-line long"></view>
      <view class="skeleton-line medium"></view>
      <view class="skeleton-row">
        <view class="skeleton-chip"></view>
        <view class="skeleton-chip"></view>
        <view class="skeleton-chip"></view>
      </view>
    </view>
  </view>

  <view wx:elif="{{isOffline || error}}" class="state-block state-block-rich">
    <view class="state-mark error">
      <view class="offline-icon"></view>
    </view>
    <text class="state-title">{{isOffline ? '推荐服务暂时没连上' : '推荐结果加载失败'}}</text>
    <text class="state-text">{{isOffline ? '请先启动本地 backend 服务，再重新获取目的地推荐。' : error}}</text>
    <view class="state-action">
      <button class="btn btn-secondary" bindtap="onRetry">重新加载</button>
      <button class="btn btn-ghost" bindtap="onBack">返回修改条件</button>
    </view>
  </view>

  <view wx:elif="{{!recommendations || recommendations.length === 0}}" class="state-block state-block-rich">
    <view class="state-mark empty">
      <view class="empty-search-icon"></view>
    </view>
    <text class="state-title">这次还没筛出合适目的地</text>
    <text class="state-text">可以换一个位置、预算区间或偏好组合，再试一次。</text>
    <view class="state-action">
      <button class="btn btn-secondary" bindtap="onBack">返回修改条件</button>
    </view>
  </view>

  <block wx:else>
    <view class="page-hero discover-hero">
      <text class="page-kicker">随机玩推荐</text>
      <text class="discover-title">这几处更值得你现在出发</text>
      <text class="page-subtitle">先看目的地，再决定要不要一键生成行程。</text>

      <view class="discover-summary surface-card">
        <view class="discover-summary-main">
          <text class="discover-summary-number">{{recommendations.length}}</text>
          <text class="discover-summary-unit">个可选方向</text>
        </view>
        <view class="discover-summary-meta">
          <view class="summary-meta-chip">
            <text class="summary-meta-label">倾向</text>
            <text class="summary-meta-value">当下适合出发</text>
          </view>
          <view class="summary-meta-chip">
            <text class="summary-meta-label">动作</text>
            <text class="summary-meta-value">展开看细节</text>
          </view>
        </view>
      </view>
    </view>

    <view class="page-content discover-list">
      <view wx:for="{{recommendations}}" wx:for-item="rec" wx:key="rank" class="rec-card">
        <view class="rec-cover rec-cover-{{rec.rank <= 3 ? rec.rank : 'n'}}">
          <view class="rec-rank">
            <text>{{rec.rank <= 3 ? '优先推荐' : '备选'}}</text>
          </view>
          <text class="rec-rank-number">TOP {{rec.rank}}</text>
        </view>

        <view class="rec-content">
          <view class="rec-head">
            <view class="rec-title-group">
              <text class="rec-name">{{rec.destination.name}}</text>
              <text class="rec-location">{{rec.destination.province}}{{rec.destination.city ? ' · ' + rec.destination.city : ''}}</text>
            </view>
          </view>

          <view class="meta-grid rec-meta-grid">
            <view wx:if="{{rec.destination.distance}}" class="meta-chip">
              <text class="meta-chip-label">距离</text>
              <text class="meta-chip-value">{{rec.destination.distance}}</text>
            </view>
            <view wx:if="{{rec.destination.avg_budget}}" class="meta-chip">
              <text class="meta-chip-label">人均</text>
              <text class="meta-chip-value">{{rec.destination.avg_budget}}</text>
            </view>
            <view wx:if="{{rec.trip_preview && rec.trip_preview.days}}" class="meta-chip">
              <text class="meta-chip-label">建议</text>
              <text class="meta-chip-value">{{rec.trip_preview.days}} 天</text>
            </view>
          </view>

          <view wx:if="{{rec.destination.tags && rec.destination.tags.length > 0}}" class="rec-tag-list">
            <text wx:for="{{rec.destination.tags}}" wx:key="tag" class="rec-tag">{{item}}</text>
          </view>

          <text wx:if="{{rec.destination.summary}}" class="rec-summary">{{rec.destination.summary}}</text>

          <view wx:if="{{rec.trip_preview}}" class="trip-preview">
            <view wx:if="{{rec.trip_preview.spot_count}}" class="trip-preview-item">
              <text class="trip-preview-number">{{rec.trip_preview.spot_count}}</text>
              <text class="trip-preview-label">景点</text>
            </view>
            <view wx:if="{{rec.trip_preview.food_count}}" class="trip-preview-item">
              <text class="trip-preview-number">{{rec.trip_preview.food_count}}</text>
              <text class="trip-preview-label">餐饮</text>
            </view>
            <view wx:if="{{rec.trip_preview.budget_range}}" class="trip-preview-item trip-preview-budget">
              <text class="trip-preview-number">{{rec.trip_preview.budget_range}}</text>
              <text class="trip-preview-label">预算</text>
            </view>
          </view>

          <view wx:if="{{expandedIndex === index && expandedRec}}" class="rec-detail">
            <view wx:if="{{expandedRec.destination.summary}}" class="detail-block">
              <text class="detail-label">为什么推荐这里</text>
              <text class="detail-copy">{{expandedRec.destination.summary}}</text>
            </view>

            <view wx:if="{{expandedRec.trip_preview && expandedRec.trip_preview.days_info}}" class="detail-block">
              <text class="detail-label">建议节奏</text>
              <view class="detail-day-list">
                <view wx:for="{{expandedRec.trip_preview.days_info}}" wx:key="day" class="detail-day-item">
                  <text class="detail-day-badge">{{item.label}}</text>
                  <text class="detail-day-copy">{{item.summary}}</text>
                </view>
              </view>
            </view>

            <view class="detail-note">
              <text class="detail-note-copy">实际营业、天气和交通会影响临场安排，生成行程后建议再确认一次。</text>
            </view>
          </view>

          <view class="rec-actions">
            <button class="btn btn-secondary" data-index="{{index}}" bindtap="onViewDetail">
              {{expandedIndex === index ? '收起' : '看细节'}}
            </button>
            <button
              class="btn btn-primary"
              data-name="{{rec.destination.name}}"
              data-city="{{rec.destination.city}}"
              data-province="{{rec.destination.province}}"
              bindtap="onGenerateTrip">
              生成行程
            </button>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>
