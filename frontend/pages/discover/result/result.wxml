<view class="page-bg">

  <!-- 顶部标题栏 -->
  <view class="top-bar">
    <text class="top-bar-title">随机游</text>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-spinner"></view>
    <text class="loading-text">探索中...</text>
  </view>

  <!-- 离线/网络错误状态 -->
  <view wx:elif="{{isOffline || error}}" class="error-wrap">
    <text class="error-icon">!</text>
    <text class="error-title">{{isOffline ? '后端服务未启动' : error}}</text>
    <text class="error-sub">{{isOffline ? '请在电脑端启动 backend 服务' : '请检查网络后重试'}}</text>
    <button class="btn-secondary" bindtap="onRetry">重新加载</button>
    <button class="btn-ghost-sm" bindtap="onBack">重新选择</button>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{!recommendations || recommendations.length === 0}}" class="empty-wrap">
    <text class="empty-icon">?</text>
    <text class="empty-title">暂未找到合适的目的地</text>
    <text class="empty-sub">试试调整你的条件</text>
    <button class="btn-secondary" bindtap="onBack">重新选择</button>
  </view>

  <!-- 推荐结果列表 -->
  <block wx:else>
    <view class="result-header">
      <text class="result-title">为你找到 {{recommendations.length}} 个好去处</text>
      <text class="result-sub">根据你的位置和偏好精选推荐</text>
    </view>

    <view class="cards-wrap">
      <view
        wx:for="{{recommendations}}"
        wx:for-item="rec"
        wx:key="rank"
        class="rec-card"
      >
        <!-- 排名标签 -->
        <view class="rank-tag rank-{{rec.rank}}">
          <text wx:if="{{rec.rank === 1}}">1</text>
          <text wx:elif="{{rec.rank === 2}}">2</text>
          <text wx:elif="{{rec.rank === 3}}">3</text>
          <text wx:else>{{rec.rank}}</text>
        </view>

        <!-- 目的地基本信息 -->
        <view class="rec-header">
          <view class="rec-name-row">
            <text class="rec-name">{{rec.destination.name}}</text>
            <text class="rec-province">{{rec.destination.province}}</text>
          </view>
          <view class="rec-meta">
            <text class="rec-distance">距离{{rec.destination.distance}}</text>
            <text class="rec-budget">人均{{rec.destination.avg_budget}}</text>
          </view>
        </view>

        <!-- 标签 -->
        <view class="rec-tags" wx:if="{{rec.destination.tags.length > 0}}">
          <text wx:for="{{rec.destination.tags}}" wx:for-item="tag" wx:key="tag" class="rec-tag">{{tag}}</text>
        </view>

        <!-- 推荐理由 -->
        <view class="rec-reason" wx:if="{{rec.destination.summary}}">
          <text class="rec-reason-text">{{rec.destination.summary}}</text>
        </view>

        <!-- 行程预览 -->
        <view class="rec-trip-preview" wx:if="{{rec.trip_preview}}">
          <view class="preview-item">
            <text class="preview-text">{{rec.trip_preview.days}}天行程</text>
          </view>
          <view class="preview-item">
            <text class="preview-text">{{rec.trip_preview.spot_count}}个景点</text>
          </view>
          <view class="preview-item">
            <text class="preview-text">{{rec.trip_preview.food_count}}餐美食</text>
          </view>
          <view class="preview-item">
            <text class="preview-text">{{rec.trip_preview.budget_range}}</text>
          </view>
        </view>

        <!-- 操作按钮 -->
        <view class="rec-actions">
          <button class="btn-detail {{expandedIndex === index ? 'btn-detail-active' : ''}}" data-index="{{index}}" bindtap="onViewDetail">{{expandedIndex === index ? '收起详情' : '查看详情'}}</button>
          <button class="btn-generate" data-name="{{rec.destination.name}}" data-city="{{rec.destination.city}}" data-province="{{rec.destination.province}}" bindtap="onGenerateTrip">生成行程</button>
        </view>

        <!-- 展开详情 -->
        <view wx:if="{{expandedIndex === index && expandedRec}}" class="rec-detail">
          <!-- 推荐依据 -->
          <view class="detail-section" wx:if="{{expandedRec.destination.summary}}">
            <text class="detail-section-title">推荐依据</text>
            <text class="detail-section-text">{{expandedRec.destination.summary}}</text>
          </view>

          <!-- 适合人群 -->
          <view class="detail-section" wx:if="{{expandedRec.destination.tags.length > 0}}">
            <text class="detail-section-title">适合人群</text>
            <view class="detail-tags">
              <text wx:for="{{expandedRec.destination.tags}}" wx:key="tag" class="detail-tag">{{item}}</text>
            </view>
          </view>

          <!-- 行程预览 -->
          <view class="detail-section" wx:if="{{expandedRec.trip_preview}}">
            <text class="detail-section-title">行程安排</text>
            <view class="detail-days">
              <view wx:for="{{expandedRec.trip_preview.days_info}}" wx:key="day" class="detail-day">
                <text class="detail-day-label">{{item.label}}</text>
                <text class="detail-day-text">{{item.summary}}</text>
              </view>
            </view>
          </view>

          <!-- 风险提示 -->
          <view class="detail-section detail-tip-warn">
            <text class="detail-tip-icon">!</text>
            <text class="detail-tip-text">以上为参考行程，具体景点可能受天气、交通等因素调整，建议出行前查看实时信息。</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部操作栏 -->
    <view class="bottom-bar">
      <button class="btn-ghost" bindtap="onBack">重新选择</button>
      <text class="bottom-tip">点击卡片「生成行程」开始规划</text>
    </view>
  </block>

</view>
