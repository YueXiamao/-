/* pages/discover/result/result.wxss */

/* ── Page (replaces .page-bg) ── */
.page {
  min-height: 100vh;
  background: linear-gradient(160deg, #F5EFE4 0%, var(--color-bg) 50%);
  display: flex;
  flex-direction: column;
  width: 100%;
}

/* ── Skeleton (from Task1 global) ── */
.skeleton-wrap {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 0 32rpx;
}

.skeleton-card {
  background: var(--color-surface);
  border-radius: var(--r-xl);
  padding: 32rpx;
  border: 1rpx solid var(--color-border);
}

.skeleton-line {
  height: 24rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s ease-in-out infinite;
  margin-bottom: 16rpx;
}

.skeleton-line.short { width: 40%; }
.skeleton-line.medium { width: 65%; }
.skeleton-line.long { width: 90%; }
.skeleton-line.none { height: 0; margin-bottom: 0; }

.skeleton-row {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.skeleton-chip {
  height: 36rpx;
  width: 80rpx;
  border-radius: 18rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s ease-in-out infinite;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ── Recommendation Card ── */
.rec-card {
  background: var(--color-surface);
  border-radius: var(--r-xl);
  padding: 32rpx;
  box-sizing: border-box;
  position: relative;
  box-shadow: var(--shadow-md);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1),
              box-shadow 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  margin-bottom: 24rpx;
}

.rec-card:last-child {
  margin-bottom: 0;
}

/* ── Rank Badge ── */
.rank-badge {
  position: absolute;
  top: -16rpx;
  left: -16rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 800;
  color: #fff;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.18);
}

.rank-1 {
  background: linear-gradient(135deg, #F59E0B, #D97706);
}

.rank-2 {
  background: linear-gradient(135deg, #94A3B8, #64748B);
}

.rank-3 {
  background: linear-gradient(135deg, #CD7F32, #A0522D);
}

.rank-n {
  background: linear-gradient(135deg, var(--color-primary), #0B7A52);
}

/* ── Rec name ── */
.rec-name {
  font-size: var(--font-xl);
  font-weight: 800;
  color: var(--color-text);
  letter-spacing: var(--tracking-tight);
  line-height: 1.2;
  word-break: break-word;
}

/* ── Tags ── */
.rec-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.rec-tag {
  font-size: var(--font-xs);
  font-weight: 600;
  padding: 5rpx 14rpx;
  border-radius: var(--r-full);
  background: rgba(24, 24, 27, 0.06);
  color: var(--color-text-secondary);
}

/* ── Detail section ── */
.detail-section {
  margin-bottom: 20rpx;
}

.detail-section:last-child {
  margin-bottom: 0;
}

/* ── Bottom bar (from app.wxss) ── */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-top: 1rpx solid var(--color-border);
  padding: var(--sp-4) var(--sp-8);
  padding-bottom: calc(var(--sp-4) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--sp-4) + env(safe-area-inset-bottom));
  display: flex;
  gap: var(--sp-3);
  align-items: center;
}

.bottom-bar .btn {
  flex: 1;
}
