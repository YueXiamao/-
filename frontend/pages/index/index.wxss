.container {
  min-height: 100vh;
  padding: 34rpx 24rpx 44rpx;
  background-image: linear-gradient(180deg, rgba(255,255,255,0.42), rgba(243,246,241,0.90) 38%, #F3F6F1 100%), url('/assets/backgrounds/city-default.png');
}

.hero-strip {
  padding: 26rpx 24rpx 24rpx;
  border-radius: 30rpx;
  margin-bottom: 22rpx;
}

.eyebrow {
  display: block;
  font-size: 22rpx;
  color: var(--color-primary);
  font-weight: 800;
  letter-spacing: 1rpx;
  margin-bottom: 14rpx;
}

.title {
  display: block;
  font-size: 58rpx;
  line-height: 1.06;
  font-weight: 820;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.hero-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 20rpx;
}

.hero-chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  color: var(--color-text-hint);
  font-size: 21rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.68);
}

.entry-stage {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.entry-card {
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
  padding: 28rpx 26rpx 26rpx;
  min-height: 290rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.entry-card:active {
  transform: scale(0.985);
}

.entry-card::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.entry-plan::before {
  background: linear-gradient(135deg, rgba(232, 245, 238, 0.92), rgba(255, 255, 255, 0.18));
}

.entry-discover {
  margin-left: 56rpx;
}

.entry-discover::before {
  background: linear-gradient(135deg, rgba(255, 241, 226, 0.94), rgba(255, 255, 255, 0.16));
}

.entry-head,
.entry-body,
.entry-tags {
  position: relative;
  z-index: 1;
}

.entry-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.entry-mark {
  min-width: 94rpx;
  height: 56rpx;
  border-radius: 999rpx;
  padding: 0 18rpx;
  background: rgba(255, 255, 255, 0.84);
  color: var(--color-primary);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 56rpx;
  text-align: center;
}

.entry-discover .entry-mark {
  color: var(--color-secondary);
}

.entry-arrow {
  font-size: 42rpx;
  color: var(--color-text-hint);
}

.entry-body {
  margin-top: 28rpx;
}

.entry-title {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  color: var(--color-text);
  line-height: 1.08;
  margin-bottom: 14rpx;
}

.entry-desc {
  display: block;
  max-width: 460rpx;
  font-size: 25rpx;
  color: var(--color-text-secondary);
  line-height: 1.55;
}

.entry-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.entry-tag {
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.84);
  color: var(--color-primary);
  font-size: 21rpx;
}

.entry-tag-warm {
  color: var(--color-secondary);
}

.home-notes {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 18rpx;
  padding: 4rpx 6rpx 0;
}

.home-note {
  font-size: 22rpx;
  color: var(--color-text-hint);
  line-height: 1.55;
}
