/* ===== 首页根容器 ===== */
.container {
  min-height: 100vh;
  padding: 34rpx 24rpx 44rpx;
  background-color: #F5F5F5;
  box-sizing: border-box;
}

/* ===== Hero 区域 ===== */
.hero-strip {
  padding: 26rpx 24rpx 24rpx;
  border-radius: 30rpx;
  margin-bottom: 22rpx;
  background: #fff;
}

.eyebrow {
  display: block;
  font-size: 22rpx;
  color: #07C160;
  font-weight: 800;
  letter-spacing: 1rpx;
  margin-bottom: 14rpx;
}

.title {
  display: block;
  font-size: 58rpx;
  line-height: 1.06;
  font-weight: 820;
  color: #1A1A1A;
  margin-bottom: 12rpx;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(26, 26, 26, 0.6);
  line-height: 1.5;
}

.hero-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 20rpx;
}

.hero-chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  color: rgba(26, 26, 26, 0.4);
  font-size: 21rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.68);
}

/* ===== 入口卡片区域 ===== */
.entry-stage {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.entry-card {
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
  padding: 28rpx 26rpx 26rpx;
  min-height: 290rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background: #fff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.entry-card:active {
  transform: scale(0.985);
}

.entry-plan {
  background: linear-gradient(135deg, #e8f5ee, #ffffff);
}

.entry-discover {
  background: linear-gradient(135deg, #fff5e6, #ffffff);
}

/* ===== 卡片头部 ===== */
.entry-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.entry-mark {
  min-width: 94rpx;
  height: 56rpx;
  border-radius: 999rpx;
  padding: 0 18rpx;
  background: rgba(7, 193, 96, 0.1);
  color: #07C160;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 56rpx;
  text-align: center;
}

.entry-discover .entry-mark {
  background: rgba(255, 149, 0, 0.1);
  color: #FF9500;
}

.entry-arrow {
  font-size: 42rpx;
  color: rgba(26, 26, 26, 0.2);
}

/* ===== 卡片内容 ===== */
.entry-body {
  margin-top: 28rpx;
}

.entry-title {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  color: #1A1A1A;
  line-height: 1.08;
  margin-bottom: 14rpx;
}

.entry-desc {
  display: block;
  max-width: 460rpx;
  font-size: 25rpx;
  color: rgba(26, 26, 26, 0.6);
  line-height: 1.55;
}

/* ===== 卡片标签 ===== */
.entry-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.entry-tag {
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(7, 193, 96, 0.08);
  color: #07C160;
  font-size: 21rpx;
}

.entry-tag-warm {
  background: rgba(255, 149, 0, 0.08);
  color: #FF9500;
}

/* ===== 底部说明 ===== */
.home-notes {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 18rpx;
  padding: 4rpx 6rpx 0;
}

.home-note {
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.4);
  line-height: 1.55;
}
