.home-page {
  padding-bottom: 48rpx;
  background:
    linear-gradient(180deg, rgba(255, 248, 238, 0.8), rgba(245, 241, 232, 0.98) 430rpx, #f5f1e8 100%),
    linear-gradient(145deg, rgba(20, 134, 111, 0.08), rgba(240, 138, 46, 0.08));
}

.home-hero {
  padding: 56rpx 32rpx 24rpx;
}

.home-greeting {
  display: block;
  font-size: 58rpx;
  line-height: 1.08;
  font-weight: 800;
  color: var(--color-text-strong);
}

.home-subtitle {
  display: block;
  margin-top: 14rpx;
  font-size: var(--font-sm);
  line-height: 1.6;
  color: var(--color-text-secondary);
  max-width: 30em;
}

.home-scenic-grid {
  position: relative;
  margin-top: 26rpx;
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 12rpx;
}

.scenic-large,
.scenic-small {
  width: 100%;
  border-radius: 28rpx;
  display: block;
}

.scenic-large {
  height: 300rpx;
}

.scenic-stack {
  display: grid;
  grid-template-rows: 1fr 1fr;
  gap: 12rpx;
}

.scenic-small {
  height: 144rpx;
}

.home-floating-badge {
  position: absolute;
  left: 20rpx;
  bottom: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 24rpx;
}

.home-floating-number {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--color-text-strong);
}

.home-floating-copy {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

.hero-status-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 16rpx;
}

.hero-status-item {
  padding: 18rpx 16rpx;
  border-radius: 22rpx;
}

.hero-status-label {
  display: block;
  font-size: var(--font-mini);
  color: var(--color-text-hint);
}

.hero-status-value {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-xs);
  line-height: 1.45;
  color: var(--color-text-strong);
  font-weight: 700;
}

.home-content {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.entry-card {
  position: relative;
  overflow: hidden;
  padding: 28rpx;
  border-radius: 34rpx;
  box-shadow: var(--shadow-card);
}

.entry-card:active {
  transform: scale(0.985);
}

.entry-plan {
  background: linear-gradient(155deg, #ffffff 0%, #edf8f3 72%);
  border: 1rpx solid rgba(20, 134, 111, 0.08);
}

.entry-discover {
  background: linear-gradient(155deg, #fffaf1 0%, #fff1dd 72%);
  border: 1rpx solid rgba(240, 138, 46, 0.1);
}

.entry-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.entry-card-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  position: relative;
}

.entry-card-icon-plan {
  background: rgba(20, 134, 111, 0.12);
}

.entry-card-icon-plan::before,
.entry-card-icon-plan::after {
  content: '';
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
}

.entry-card-icon-plan::before {
  top: 22rpx;
  box-shadow: 0 12rpx 0 var(--color-primary);
}

.entry-card-icon-plan::after {
  top: 46rpx;
  width: 20rpx;
  right: auto;
}

.entry-card-icon-discover {
  background: rgba(240, 138, 46, 0.14);
}

.entry-card-icon-discover::before {
  content: '';
  position: absolute;
  width: 26rpx;
  height: 26rpx;
  border: 4rpx solid var(--color-secondary-deep);
  border-radius: 50%;
  top: 16rpx;
  left: 16rpx;
}

.entry-card-icon-discover::after {
  content: '';
  position: absolute;
  width: 18rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: var(--color-secondary-deep);
  transform: rotate(45deg);
  right: 14rpx;
  bottom: 18rpx;
}

.entry-tag {
  align-self: flex-start;
}

.entry-title {
  display: block;
  margin-top: 20rpx;
  font-size: 48rpx;
  line-height: 1.12;
  font-weight: 800;
  color: var(--color-text-strong);
}

.entry-brief {
  display: block;
  margin-top: 10rpx;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.entry-metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 20rpx;
}

.entry-metric {
  min-height: 42rpx;
  padding: 0 14rpx;
  display: inline-flex;
  align-items: center;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  color: var(--color-text-secondary);
  font-size: var(--font-xs);
  font-weight: 700;
}

.entry-metric.warm {
  color: #a1600d;
}

.entry-card-tail {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 22rpx;
}

.entry-tail-copy {
  font-size: var(--font-xs);
  line-height: 1.5;
  color: var(--color-text-hint);
}

.entry-arrow {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.86);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.entry-arrow.warm {
  background: rgba(255, 255, 255, 0.7);
}

.entry-arrow-icon {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid var(--color-primary);
  border-right: 3rpx solid var(--color-primary);
  transform: rotate(45deg);
  margin-left: -4rpx;
}

.entry-arrow-icon.warm {
  border-top-color: var(--color-secondary-deep);
  border-right-color: var(--color-secondary-deep);
}

.home-strip {
  padding: 24rpx;
}

.home-strip-title {
  display: block;
  font-size: var(--font-base);
  font-weight: 800;
  color: var(--color-text-strong);
}

.home-strip-copy {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-xs);
  line-height: 1.55;
  color: var(--color-text-secondary);
}

.home-tip-row {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 4rpx 4rpx 0;
}

.home-tip {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  line-height: 1.5;
}
