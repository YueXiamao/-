/* pages/index/index.wxss */
.container {
  padding: 32rpx 24rpx;
  min-height: 100vh;
  background-color: #F5F5F5;
}

.header {
  text-align: center;
  padding: 48rpx 0 48rpx;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #666666;
}

/* 卡片 */
.cards {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.card:active {
  transform: scale(0.98);
}

.card-icon {
  font-size: 64rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.card-content {
  flex: 1;
}

.card-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.card-desc {
  display: block;
  font-size: 24rpx;
  color: #666666;
  line-height: 1.6;
  white-space: pre-line;
}

.card-arrow {
  font-size: 48rpx;
  color: #999999;
  flex-shrink: 0;
  padding-left: 16rpx;
}

.card-plan {
  border-left: 6rpx solid #07C160;
}

.card-discover {
  border-left: 6rpx solid #FF9500;
}

/* 功能特点 */
.features {
  display: flex;
  justify-content: space-around;
  margin-top: 48rpx;
  padding: 32rpx 0;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.feature-icon {
  font-size: 40rpx;
}

.feature-text {
  font-size: 22rpx;
  color: #666666;
}
