/* pages/index/index.wxss */

/* ── Page ── */
.page {
  min-height: 100vh;
  background-color: var(--color-bg);
  overflow: hidden;
}

/* ── Entry Cards Stage ── */
.entry-stage {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: -20rpx;
  position: relative;
  z-index: 1;
}

/* ── Entry Card (shared base) ── */
.entry-card {
  border-radius: var(--r-xl);
  padding: 32rpx;
  position: relative;
  overflow: hidden;
  transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1),
              box-shadow 0.22s cubic-bezier(0.16, 1, 0.3, 1);
}

.entry-card:active {
  transform: scale(0.98);
}

.entry-plan {
  background: linear-gradient(135deg, #E8F5EE 0%, #D0EFE0 100%);
  box-shadow: 0 8rpx 32rpx rgba(13, 156, 110, 0.15);
}

.entry-discover {
  background: linear-gradient(135deg, #FEF3E2 0%, #FDE8C8 100%);
  box-shadow: 0 8rpx 32rpx rgba(232, 129, 10, 0.15);
}

.entry-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.entry-mark-wrap {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.entry-mark {
  font-size: var(--font-kicker);
  font-weight: 800;
  color: var(--color-text);
  letter-spacing: 2rpx;
}

.entry-tagline {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--color-text-secondary);
}

.entry-arrow {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.entry-arrow-icon {
  width: 15rpx;
  height: 15rpx;
  border-top: 3rpx solid var(--color-text-secondary);
  border-right: 3rpx solid var(--color-text-secondary);
  transform: rotate(45deg);
}

.entry-body {
  margin-bottom: 20rpx;
}

.entry-title {
  display: block;
  font-size: var(--font-xl);
  font-weight: 800;
  color: var(--color-text);
  letter-spacing: var(--tracking-tight);
  line-height: 1.2;
  margin-bottom: 8rpx;
}

.entry-desc {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.55;
}

.entry-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.entry-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--font-xs);
  font-weight: 600;
  color: var(--color-text-secondary);
  padding: 4rpx 12rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: var(--r-full);
}

.entry-tag-warm {
  background: rgba(255, 255, 255, 0.75);
  color: var(--color-secondary);
}

.entry-tag-dot {
  display: inline-block;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: currentColor;
}

/* ── Home Footer ── */
.home-footer {
  padding: 48rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.home-footer-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.home-footer-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--color-primary);
  flex-shrink: 0;
  margin-top: 10rpx;
  opacity: 0.5;
}

.home-footer-text {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  line-height: 1.5;
}
