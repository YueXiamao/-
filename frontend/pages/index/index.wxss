/* pages/index/index.wxss */

/* ── Container ── */
.container {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding: 0 0 160rpx 0;
  overflow: hidden;
}

/* ── Hero Banner ── */
.hero-banner {
  position: relative;
  padding: 72rpx 40rpx 56rpx;
  background: linear-gradient(160deg, #E8F5EE 0%, #F0F5F0 50%, var(--color-bg) 100%);
  overflow: hidden;
}

.hero-banner::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(13, 156, 110, 0.12) 0%, transparent 70%);
  pointer-events: none;
}

.hero-banner::after {
  content: '';
  position: absolute;
  bottom: -40rpx;
  left: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(232, 129, 10, 0.1) 0%, transparent 70%);
  pointer-events: none;
}

.hero-kicker {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  font-size: var(--font-kicker);
  font-weight: 700;
  color: var(--color-primary);
  letter-spacing: 3rpx;
  text-transform: uppercase;
  margin-bottom: 20rpx;
}

.hero-kicker::before {
  content: '';
  display: block;
  width: 24rpx;
  height: 3rpx;
  background: var(--color-primary);
  border-radius: 2rpx;
}

.hero-title {
  display: block;
  font-size: var(--font-display);
  font-weight: 800;
  color: var(--color-text);
  line-height: 1.05;
  letter-spacing: var(--tracking-tight);
  margin-bottom: 16rpx;
}

.hero-subtitle {
  display: block;
  font-size: var(--font-base);
  color: var(--color-text-secondary);
  line-height: 1.6;
  max-width: 520rpx;
}

.hero-divider {
  width: 48rpx;
  height: 4rpx;
  background: linear-gradient(90deg, var(--color-primary), var(--color-secondary));
  border-radius: 2rpx;
  margin: 32rpx 0;
}

/* ── Entry Cards ── */
.entry-stage {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: -20rpx;
  position: relative;
  z-index: 1;
}

.entry-card {
  position: relative;
  overflow: hidden;
  border-radius: var(--r-xl);
  padding: 40rpx 36rpx 36rpx;
  min-height: 300rpx;
  display: flex;
  flex-direction: column;
  background: var(--color-surface);
  box-shadow: var(--shadow-md);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1),
              box-shadow 0.22s cubic-bezier(0.16, 1, 0.3, 1);
}

.entry-card:active {
  transform: scale(0.975) translateY(2rpx);
  box-shadow: var(--shadow-sm);
}

/* plan — left accent bar */
.entry-plan {
  border-left: 7rpx solid var(--color-primary);
}

/* discover — left accent bar */
.entry-discover {
  border-left: 7rpx solid var(--color-secondary);
}

/* decorative circle */
.entry-card::before {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  pointer-events: none;
  transition: transform 0.4s ease;
}

.entry-plan::before {
  background: radial-gradient(circle, rgba(13, 156, 110, 0.08) 0%, transparent 65%);
}

.entry-discover::before {
  background: radial-gradient(circle, rgba(232, 129, 10, 0.08) 0%, transparent 65%);
}

/* ── Card Header ── */
.entry-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.entry-mark-wrap {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.entry-mark {
  display: inline-flex;
  align-items: center;
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: var(--r-full);
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: var(--font-kicker);
  font-weight: 800;
  letter-spacing: 2rpx;
}

.entry-discover .entry-mark {
  background: var(--color-secondary-light);
  color: var(--color-secondary);
}

.entry-tagline {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  font-weight: 500;
}

.entry-arrow {
  font-size: 44rpx;
  color: var(--color-border-strong);
  font-weight: 300;
  transition: transform 0.2s ease, color 0.2s ease;
  line-height: 1;
}

.entry-card:active .entry-arrow {
  transform: translateX(6rpx);
  color: var(--color-text-hint);
}

/* ── Card Body ── */
.entry-body {
  flex: 1;
}

.entry-title {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  color: var(--color-text);
  line-height: 1.05;
  letter-spacing: var(--tracking-tight);
  margin-bottom: 14rpx;
}

.entry-desc {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.65;
  max-width: 480rpx;
}

/* ── Feature Pills ── */
.entry-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 24rpx;
}

.entry-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: var(--r-full);
  background: var(--color-primary-muted);
  color: var(--color-primary);
  font-size: var(--font-xs);
  font-weight: 600;
  border: 1rpx solid rgba(13, 156, 110, 0.12);
}

.entry-tag-warm {
  background: var(--color-secondary-muted);
  color: var(--color-secondary);
  border-color: rgba(232, 129, 10, 0.12);
}

.entry-tag-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: currentColor;
  flex-shrink: 0;
}

/* ── Footer hint ── */
.home-footer {
  padding: 36rpx 40rpx 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.home-footer-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.home-footer-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--color-text-hint);
  flex-shrink: 0;
}

.home-footer-text {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  line-height: 1.4;
}
