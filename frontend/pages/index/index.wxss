/* pages/index/index.wxss */

/* ── Container ── */
.container {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding: 32rpx 28rpx 140rpx;
}

/* ── Hero ── */
.hero-strip {
  margin-bottom: 32rpx;
}

.eyebrow {
  display: block;
  font-size: var(--font-kicker);
  font-weight: 700;
  color: var(--color-primary);
  letter-spacing: 3rpx;
  margin-bottom: 14rpx;
  text-transform: uppercase;
}

.title {
  display: block;
  font-size: 56rpx;
  font-weight: 800;
  color: var(--color-text);
  line-height: 1.1;
  letter-spacing: -1rpx;
  margin-bottom: 12rpx;
}

.subtitle {
  display: block;
  font-size: var(--font-base);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

/* ── Entry Cards ── */
.entry-stage {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.entry-card {
  position: relative;
  overflow: hidden;
  border-radius: var(--r-lg);
  padding: 36rpx 32rpx 32rpx;
  min-height: 260rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background: var(--color-surface);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--color-border);
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}

.entry-card:active {
  transform: scale(0.975);
  box-shadow: var(--shadow-xs);
}

/* plan card — green accent */
.entry-plan {
  border-left: 6rpx solid var(--color-primary);
}

/* discover card — amber accent */
.entry-discover {
  border-left: 6rpx solid var(--color-secondary);
}

/* ── Card Header ── */
.entry-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.entry-mark {
  display: inline-flex;
  align-items: center;
  height: 48rpx;
  padding: 0 16rpx;
  border-radius: var(--r-full);
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: var(--font-kicker);
  font-weight: 800;
  letter-spacing: 1.5rpx;
}

.entry-discover .entry-mark {
  background: var(--color-secondary-light);
  color: var(--color-secondary);
}

.entry-arrow {
  font-size: 40rpx;
  color: var(--color-border-strong);
  font-weight: 300;
  transition: transform 0.2s ease, color 0.2s ease;
}

.entry-card:active .entry-arrow {
  transform: translateX(6rpx);
  color: var(--color-text-hint);
}

/* ── Card Body ── */
.entry-body { flex: 1; }

.entry-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: var(--color-text);
  line-height: 1.1;
  margin-bottom: 12rpx;
  letter-spacing: -0.5rpx;
}

.entry-desc {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
  max-width: 480rpx;
}

/* ── Card Tags ── */
.entry-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 20rpx;
}

.entry-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: var(--r-full);
  background: var(--color-primary-muted);
  color: var(--color-primary);
  font-size: var(--font-xs);
  font-weight: 600;
}

.entry-tag-warm {
  background: rgba(245, 158, 11, 0.08);
  color: var(--color-secondary);
}

/* ── Feature pills row ── */
.feature-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 24rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.feature-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--color-primary);
  flex-shrink: 0;
}

.entry-discover .feature-dot {
  background: var(--color-secondary);
}

.feature-text {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  line-height: 1.4;
}
