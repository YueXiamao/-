<view class="page page-bg home-page">
  <view class="home-hero">
    <text class="page-kicker">旅行助手</text>
    <text class="home-greeting">{{username}}，下一段出发从这里开始</text>
    <text class="home-subtitle">先定方向，再做安排。知道去哪就直接排路线，没想法就先找灵感。</text>

    <view class="home-scenic-grid">
      <image class="scenic-large" src="/assets/backgrounds/city-coast.png" mode="aspectFill" />
      <view class="scenic-stack">
        <image class="scenic-small" src="/assets/backgrounds/city-urban.png" mode="aspectFill" />
        <image class="scenic-small" src="/assets/backgrounds/city-mountain.png" mode="aspectFill" />
      </view>
      <view class="home-floating-badge glass-card">
        <text class="home-floating-number">{{hasRecentTrips ? recentTripCount : 2}}</text>
        <text class="home-floating-copy">{{hasRecentTrips ? '份历史草案' : '种出发方式'}}</text>
      </view>
    </view>

    <view class="hero-status-row">
      <view class="hero-status-item surface-card">
        <text class="hero-status-label">适合现在</text>
        <text class="hero-status-value">周末短逃</text>
      </view>
      <view class="hero-status-item surface-card">
        <text class="hero-status-label">推荐节奏</text>
        <text class="hero-status-value">轻松直达</text>
      </view>
      <view class="hero-status-item surface-card">
        <text class="hero-status-label">你的状态</text>
        <text class="hero-status-value">{{hasRecentTrips ? '可继续编辑' : '可以新建一份'}}</text>
      </view>
    </view>
  </view>

  <view class="page-content home-content">
    <view class="entry-card entry-plan" bindtap="goPlan">
      <view class="entry-card-top">
        <text class="entry-tag badge-green">有目的地</text>
        <view class="entry-card-icon entry-card-icon-plan"></view>
      </view>
      <text class="entry-title">行程规划</text>
      <text class="entry-brief">目的地、日期、偏好</text>
      <view class="entry-metrics">
        <text class="entry-metric">多地组合</text>
        <text class="entry-metric">每日节奏</text>
        <text class="entry-metric">可继续编辑</text>
      </view>
      <view class="entry-card-tail">
        <text class="entry-tail-copy">更适合已经有出发方向</text>
        <view class="entry-arrow"><view class="entry-arrow-icon"></view></view>
      </view>
    </view>

    <view class="entry-card entry-discover" bindtap="goDiscover">
      <view class="entry-card-top">
        <text class="entry-tag badge-amber">没定目的地</text>
        <view class="entry-card-icon entry-card-icon-discover"></view>
      </view>
      <text class="entry-title">随机玩</text>
      <text class="entry-brief">位置、预算、偏好</text>
      <view class="entry-metrics">
        <text class="entry-metric warm">先筛目的地</text>
        <text class="entry-metric warm">再生成行程</text>
        <text class="entry-metric warm">适合临时起意</text>
      </view>
      <view class="entry-card-tail">
        <text class="entry-tail-copy">更适合快速找方向</text>
        <view class="entry-arrow warm"><view class="entry-arrow-icon warm"></view></view>
      </view>
    </view>

    <view class="home-strip surface-card" wx:if="{{hasRecentTrips}}">
      <text class="home-strip-title">最近有 {{recentTripCount}} 份草案</text>
      <text class="home-strip-copy">可以去“我的”继续查看、保存和整理。</text>
    </view>

    <view class="home-tip-row">
      <text class="home-tip">先出一版，再微调，通常更快。</text>
      <text class="home-tip">灵感和执行，走两条不同的入口。</text>
    </view>
  </view>
</view>
