<!-- pages/index/index.wxml -->
<view class="container">
  <view class="header">
    <text class="title">旅行规划</text>
    <text class="subtitle">智能行程规划，让旅行更简单</text>
  </view>

  <view class="cards">
    <view class="card card-plan" bindtap="goToPlan">
      <text class="card-icon">[MAP]</text>
      <view class="card-content">
        <text class="card-title">行程规划</text>
        <text class="card-desc">已确定目的地？帮您安排每日行程</text>
      </view>
      <text class="card-arrow">></text>
    </view>

    <view class="card card-discover" bindtap="goToDiscover">
      <text class="card-icon">[RND]</text>
      <view class="card-content">
        <text class="card-title">随机玩</text>
        <text class="card-desc">不确定去哪玩？根据您的位置推荐目的地</text>
      </view>
      <text class="card-arrow">></text>
    </view>
  </view>

  <view class="features">
    <view class="feature-item">
      <text class="feature-icon">[1]</text>
      <text class="feature-text">真实景点推荐</text>
    </view>
    <view class="feature-item">
      <text class="feature-icon">[2]</text>
      <text class="feature-text">本地美食攻略</text>
    </view>
    <view class="feature-item">
      <text class="feature-icon">[3]</text>
      <text class="feature-text">一键生成行程</text>
    </view>
  </view>
</view>
