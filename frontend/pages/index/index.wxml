<view class="page page-bg">

  <!-- Hero Banner -->
  <view class="page-hero" style="padding: 64rpx 32rpx 48rpx">
    <text class="page-kicker">TRAVEL PLANNER</text>
    <text class="page-title">今天怎么出发</text>
    <view style="height: 4rpx; background: linear-gradient(90deg, var(--color-primary), var(--color-secondary)); border-radius: 2rpx; margin: 24rpx 0;"></view>
    <text class="page-subtitle">选一个入口，开启你的下一段旅程。</text>
  </view>

  <!-- Entry Cards -->
  <view class="entry-stage">

    <!-- PLAN -->
    <view class="entry-card entry-plan" bindtap="goPlan">
      <view class="entry-head">
        <view class="entry-mark-wrap">
          <text class="entry-mark">PLAN</text>
          <text class="entry-tagline">行程规划</text>
        </view>
        <text class="entry-arrow">›</text>
      </view>
      <view class="entry-body">
        <text class="entry-title">已经想好去哪</text>
        <text class="entry-desc">把路线和节奏安排清楚，直接开做。</text>
      </view>
      <view class="entry-tags">
        <text class="entry-tag"><text class="entry-tag-dot"></text>市 + 区县混合</text>
        <text class="entry-tag"><text class="entry-tag-dot"></text>轻松度假</text>
        <text class="entry-tag"><text class="entry-tag-dot"></text>网红打卡</text>
        <text class="entry-tag"><text class="entry-tag-dot"></text>美食之旅</text>
      </view>
    </view>

    <!-- RND -->
    <view class="entry-card entry-discover" bindtap="goDiscover">
      <view class="entry-head">
        <view class="entry-mark-wrap">
          <text class="entry-mark">RND</text>
          <text class="entry-tagline">随机玩</text>
        </view>
        <text class="entry-arrow">›</text>
      </view>
      <view class="entry-body">
        <text class="entry-title">还没想好去哪</text>
        <text class="entry-desc">告诉系统你的位置、天数和预算，马上出灵感。</text>
      </view>
      <view class="entry-tags">
        <text class="entry-tag entry-tag-warm"><text class="entry-tag-dot"></text>当前位置推荐</text>
        <text class="entry-tag entry-tag-warm"><text class="entry-tag-dot"></text>按预算筛选</text>
        <text class="entry-tag entry-tag-warm"><text class="entry-tag-dot"></text>马上出攻略</text>
      </view>
    </view>

  </view>

  <!-- Footer hints -->
  <view class="home-footer">
    <view class="home-footer-item">
      <view class="home-footer-dot"></view>
      <text class="home-footer-text">目的地精确到区县，支持市 + 区县组合</text>
    </view>
    <view class="home-footer-item">
      <view class="home-footer-dot"></view>
      <text class="home-footer-text">推荐内容完全过滤广告，真实好玩</text>
    </view>
  </view>

</view>
