# ============================================================
# 数据库配置
# ============================================================
# 数据库类型：sqlite | mysql
DB_TYPE=sqlite

# ── SQLite（开发默认）──────────────────────────
DB_PATH=./data/travel.db
BETTER_SQLITE3_NATIVE_BINDING=

# ── MySQL（生产环境）──────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=travel_planner

# ============================================================
# Redis 配置
# ============================================================
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ============================================================
# 高德地图 Web API（必填）
# 申请地址：https://lbs.amap.com/dev/key/app
# ============================================================
AMAP_KEY=your_amap_key_here
AMAP_SECRET=your_amap_secret_here

# ============================================================
# AI 服务
# ============================================================
# 提供商: anthropic | minimax | openai
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.anthropic.com

# ============================================================
# 微信小程序（必填）
# 申请地址：https://developers.weixin.qq.com/miniprogram/dev/devtools/download.html
# ============================================================
WECHAT_APPID=your_wechat_appid_here
WECHAT_SECRET=your_wechat_secret_here

# ============================================================
# 服务端口
# ============================================================
PORT=3000
NODE_ENV=development
