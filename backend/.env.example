AMAP_SECRET=

# AI 服务（OpenAI 兼容接口）
AI_PROVIDER=anthropic
AI_MODEL=MiniMax-M2.7
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.minimaxi.com/anthropic/v

# 微信登录
# 在 https://mp.weixin.qq.com 获取
