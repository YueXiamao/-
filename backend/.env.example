# 旅游小程序 - 环境变量示例
# 复制此文件为 .env，填入真实值

# 数据库（本地 SQLite）
DB_PATH=./data/travel.db
BETTER_SQLITE3_NATIVE_BINDING=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# 高德地图 Web API Key（申请地址：https://console.amap.com）
