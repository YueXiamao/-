# ============================================================
# 数据库配置
# ============================================================

# 数据库类型：sqlite | mysql
DB_TYPE=sqlite

# ── SQLite（开发默认）──────────────────────────
# 数据库文件路径（相对于项目根目录，或绝对路径）
DB_PATH=./data/travel.db
# better-sqlite3 原生模块路径（一般不需要修改）
BETTER_SQLITE3_NATIVE_BINDING=

# ── MySQL（生产环境）──────────────────────────
# 切换 DB_TYPE=mysql 后填以下四项
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=travel_planner

# ============================================================
# Redis 配置
# ============================================================
# 启用缓存层（行政区划、POI 搜索结果缓存）
REDIS_ENABLED=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================
# 高德地图 Web API
# ============================================================
AMAP_KEY=your_amap_key_here
AMAP_SECRET=

# ============================================================
# AI 服务
# ============================================================
AI_PROVIDER=anthropic
AI_MODEL=minimax-7B-250618
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.minimaxi.com/anthropic/v

# ============================================================
# 微信小程序
# ============================================================
WECHAT_APPID=your_wechat_appid_here
WECHAT_SECRET=your_wechat_secret_here

# ============================================================
# 服务端口
# ============================================================
PORT=3000
NODE_ENV=development
